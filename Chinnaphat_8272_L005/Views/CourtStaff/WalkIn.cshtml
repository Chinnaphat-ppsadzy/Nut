@model List<Chinnaphat_8272_L005.Models.WalkInQueue>
@{
    Layout = "_CourtStaffLayout";
    ViewData["Title"] = "จัดการคิว Walk-in ประจำวัน";

    string selectedDateStr = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var courts = ViewBag.Courts as List<Chinnaphat_8272_L005.Models.Court> ?? new();
    var timeSlots = ViewBag.TimeSlots as List<Chinnaphat_8272_L005.Models.TimeSlot> ?? new();

    string? queryCourtId = Context.Request.Query["courtId"];
    string? querySlotId = Context.Request.Query["slotId"];
}

<div class="row g-4">
    <!-- ================= FORM: ออกบัตรคิว WALK-IN ================= -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 text-white" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);">
                <h5 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-ticket-perforated-fill me-2 fs-4"></i>ออกบัตรคิว Walk-in หน้าร้าน
                </h5>
                <small class="text-white-50">สำหรับลูกค้าที่ไม่ได้จองออนไลน์ล่วงหน้า</small>
            </div>

            <div class="card-body p-4 bg-white">
                <form method="post" asp-action="AddWalkIn">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            ชื่อ-นามสกุล ลูกค้า <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input type="text" name="customerName" class="form-control" placeholder="เช่น คุณสมศักดิ์" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            เบอร์โทรศัพท์ติดต่อ
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="phone" class="form-control" placeholder="เช่น 081-xxx-xxxx" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            คอร์ทที่ต้องการ (ถ้ามี)
                        </label>
                        <select name="courtId" class="form-select">
                            <option value="">-- จัดคอร์ทว่างใดก็ได้ (Auto Assign) --</option>
                            @foreach (var c in courts)
                            {
                                <option value="@c.CourtId" selected="@(queryCourtId == c.CourtId.ToString())">
                                    @c.CourtName (@c.PricePerHour.ToString("N0") ฿/ชม.)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">
                            ช่วงเวลาที่ต้องการเข้าเล่น
                        </label>
                        <select name="slotId" class="form-select">
                            <option value="">-- รอบถัดไปที่ว่างทันที (Next Available) --</option>
                            @foreach (var s in timeSlots)
                            {
                                <option value="@s.SlotId" selected="@(querySlotId == s.SlotId.ToString())">
                                    @s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm") น.
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius:10px; background:linear-gradient(135deg, #1a472a, #2d6a4f); border:none;">
                        <i class="bi bi-plus-circle me-1"></i> ออกบัตรคิว Walk-in
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= LIST: รายการคิว WALK-IN ประจำวัน ================= -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-card-list text-info me-2"></i>คิว Walk-in ประจำวันที่ @selectedDateStr
                    </h5>
                    <small class="text-muted">ทั้งหมด @Model.Count รายการ</small>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <form method="get" asp-action="WalkIn" class="d-flex gap-2">
                        <input type="date" name="date" class="form-control form-control-sm" value="@selectedDateStr" onchange="this.form.submit()" />
                    </form>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> ผังตารางคอร์ท
                    </a>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>ลำดับคิว</th>
                                <th>ชื่อลูกค้า</th>
                                <th>เบอร์โทร</th>
                                <th>คอร์ท & เวลา</th>
                                <th>เวลาออกคิว</th>
                                <th>สถานะ</th>
                                <th class="text-end">การจัดการคิว</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-dark font-monospace fs-6 px-3 py-2">
                                            W-@q.QueueNo.ToString("D2")
                                        </span>
                                    </td>
                                    <td>
                                        <strong class="text-dark">@q.CustomerName</strong>
                                    </td>
                                    <td>
                                        <span class="small text-muted"><i class="bi bi-telephone me-1"></i>@(q.Phone ?? "-")</span>
                                    </td>
                                    <td>
                                        @if (q.Court != null)
                                        {
                                            <span class="badge bg-secondary me-1">@q.Court.CourtName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border me-1">คอร์ทใดก็ได้</span>
                                        }

                                        @if (q.Slot != null)
                                        {
                                            <span class="small text-muted">@q.Slot.StartTime.ToString("HH:mm") - @q.Slot.EndTime.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">รอบที่ว่าง</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@q.CreatedAt.ToString("HH:mm:ss น.")</small>
                                    </td>
                                    <td>
                                        @switch (q.Status?.ToUpper())
                                        {
                                            case "CALLED":
                                                <span class="badge bg-warning text-dark px-2 py-1">
                                                    <i class="bi bi-megaphone-fill me-1"></i> เรียกคิวแล้ว
                                                </span>
                                                break;
                                            case "ASSIGNED":
                                                <span class="badge bg-success px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> เข้าเล่นแล้ว
                                                </span>
                                                break;
                                            case "CANCELLED":
                                                <span class="badge bg-secondary px-2 py-1">
                                                    <i class="bi bi-x-circle me-1"></i> ยกเลิก
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-primary px-2 py-1">
                                                    <i class="bi bi-hourglass-split me-1"></i> รอเรียกคิว
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (q.Status == "WAITING")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark px-2" onclick="updateQueueStatus(@q.QueueId, 'CALLED')" title="เรียกคิวลูกค้า">
                                                <i class="bi bi-megaphone"></i> เรียก
                                            </button>
                                            <button type="button" class="btn btn-sm btn-success px-2" onclick="assignCourtToQueue(@q.QueueId)" title="จัดคอร์ทเข้าเล่น">
                                                <i class="bi bi-check-lg"></i> จัดคอร์ท
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2" onclick="updateQueueStatus(@q.QueueId, 'CANCELLED')" title="ยกเลิกคิว">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }
                                        else if (q.Status == "CALLED")
                                        {
                                            <button type="button" class="btn btn-sm btn-success px-3" onclick="assignCourtToQueue(@q.QueueId)">
                                                <i class="bi bi-check-lg me-1"></i> จัดคอร์ทเข้าเล่น
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2" onclick="updateQueueStatus(@q.QueueId, 'CANCELLED')">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                    <h6>ยังไม่มีคิว Walk-in ในวันนี้</h6>
                    <small>กดออกบัตรคิวที่แบบฟอร์มด้านซ้ายเมื่อมีลูกค้าติดต่อหน้าร้าน</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateQueueStatus(queueId, status, courtId = null) {
            let body = `queueId=${queueId}&status=${status}`;
            if (courtId) body += `&courtId=${courtId}`;

            fetch('/CourtStaff/UpdateQueueStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('เกิดข้อผิดพลาด: ' + data.message);
                }
            })
            .catch(err => alert('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้: ' + err));
        }

        function assignCourtToQueue(queueId) {
            const court = prompt('ระบุหมายเลขคอร์ทที่จะจัดให้ลูกค้าเข้าเล่น (เช่น 1, 2, 3, 4):', '1');
            if (court) {
                updateQueueStatus(queueId, 'ASSIGNED', parseInt(court));
            }
        }
    </script>
}
