@model List<Chinnaphat_8272_L005.Models.Receipt>
@{
    Layout = "_AccountingLayout";
    ViewData["Title"] = "ออกใบเสร็จรับเงิน & ใบกำกับภาษี";

    string activeDocType = ViewBag.ActiveDocType as string ?? "ALL";
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:18px; background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); color:white;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-white text-success fw-bold mb-2 font-monospace">OFFICIAL INVOICING</span>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-file-earmark-text me-2"></i>ระบบออกใบเสร็จรับเงิน & ใบกำกับภาษี
                </h4>
                <p class="mb-0 text-white-50 small">
                    สร้างและจัดการใบเสร็จรับเงิน ใบกำกับภาษีเต็มรูปพร้อมคำนวณภาษีมูลค่าเพิ่ม (VAT 7%) สำหรับลูกค้าบุคคลและนิติบุคคล
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Toolbar & Filter -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <!-- Tabs -->
            <div class="d-flex gap-2">
                <a asp-action="Receipts" asp-route-docType="ALL" class="btn btn-sm @(activeDocType == "ALL" ? "btn-success" : "btn-light") fw-semibold px-3 py-2" style="border-radius:10px;">
                    ทั้งหมด (@Model.Count)
                </a>
                <a asp-action="Receipts" asp-route-docType="RECEIPT" class="btn btn-sm @(activeDocType == "RECEIPT" ? "btn-success" : "btn-light") fw-semibold px-3 py-2" style="border-radius:10px;">
                    <i class="bi bi-receipt me-1"></i> ใบเสร็จรับเงิน (Receipt)
                </a>
                <a asp-action="Receipts" asp-route-docType="TAX_INVOICE" class="btn btn-sm @(activeDocType == "TAX_INVOICE" ? "btn-success" : "btn-light") fw-semibold px-3 py-2" style="border-radius:10px;">
                    <i class="bi bi-file-earmark-ruled me-1"></i> ใบกำกับภาษี (Tax Invoice)
                </a>
            </div>

            <!-- Search -->
            <form method="get" asp-action="Receipts" class="d-flex gap-2">
                <input type="hidden" name="docType" value="@activeDocType" />
                <div class="input-group" style="max-width:280px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-success"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="ค้นหาเลขที่บิล, ชื่อ, Tax ID..." value="@searchTerm" />
                </div>
                <button type="submit" class="btn btn-success fw-bold px-3" style="background:linear-gradient(135deg, #1a472a, #2d6a4f); border:none; border-radius:8px;">
                    ค้นหา
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-journal-text text-success me-2"></i>รายการเอกสารการเงินทั้งหมด (@Model.Count ฉบับ)
        </h5>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-secondary">
                        <th>ประเภทเอกสาร</th>
                        <th>เลขที่เอกสาร</th>
                        <th>รหัสการจอง</th>
                        <th>ชื่อผู้ออกเอกสาร (ลูกค้า)</th>
                        <th>ยอดก่อนภาษี</th>
                        <th>VAT (7%)</th>
                        <th>ยอดสุทธิรวม</th>
                        <th>วันที่ออกเอกสาร</th>
                        <th class="text-end">การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        decimal net = r.Amount + r.VatAmount;
                        <tr>
                            <td>
                                @if (r.DocType == "TAX_INVOICE")
                                {
                                    <span class="badge bg-primary px-2 py-1">
                                        <i class="bi bi-file-earmark-ruled me-1"></i> ใบกำกับภาษีเต็มรูป
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2 py-1">
                                        <i class="bi bi-receipt me-1"></i> ใบเสร็จรับเงิน
                                    </span>
                                }
                            </td>
                            <td>
                                <strong class="font-monospace text-dark">@r.ReceiptNo</strong>
                            </td>
                            <td>
                                <span class="font-monospace text-primary small">@r.Booking.BookingCode</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@r.CustomerName</div>
                                @if (!string.IsNullOrEmpty(r.TaxId))
                                {
                                    <small class="text-muted d-block" style="font-size:0.75rem;">เลขผู้เสียภาษี: @r.TaxId</small>
                                }
                            </td>
                            <td>@r.Amount.ToString("N2") ฿</td>
                            <td>@r.VatAmount.ToString("N2") ฿</td>
                            <td>
                                <strong class="text-success fs-6">@net.ToString("N2") ฿</strong>
                            </td>
                            <td>
                                <small class="text-muted">@r.IssuedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td class="text-end">
                                <a asp-action="PrintReceipt" asp-route-id="@r.ReceiptId" target="_blank" class="btn btn-sm btn-outline-success px-2 py-1 me-1" style="border-radius:8px;">
                                    <i class="bi bi-printer me-1"></i> พิมพ์ / ดาวน์โหลด
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-file-earmark-x fs-1 d-block mb-2 text-success"></i>
            <h6>ยังไม่มีเอกสารในหมวดนี้</h6>
            <small>เมื่อฝ่ายบัญชีกดอนุมัติสลิปในหน้า "ตรวจสลิป" ระบบจะออกใบเสร็จรับเงินให้อัตโนมัติทันที</small>
        </div>
    }
</div>

