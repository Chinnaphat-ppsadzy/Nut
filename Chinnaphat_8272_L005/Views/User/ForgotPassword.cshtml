@model Chinnaphat_8272_L005.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "ลืมรหัสผ่าน";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ลืมรหัสผ่าน - CourtBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Sarabun', sans-serif; }
        body { min-height:100vh; display:grid; place-items:center; padding:24px; background:linear-gradient(135deg,#1a472a,#2d6a4f 50%,#52b788); }
        .recovery-card { width:min(100%,500px); overflow:hidden; border:0; border-radius:20px; box-shadow:0 25px 60px #0003; }
        .recovery-head { padding:30px; text-align:center; color:white; background:linear-gradient(135deg,#1a472a,#52b788); }
        .recovery-body { padding:30px; background:#fff; }
        .form-control { min-height:48px; border-radius:10px; }
        .btn-primary { border:0; background:linear-gradient(135deg,#1a472a,#2d6a4f); }
    </style>
</head>
<body>
    <main class="card recovery-card">
        <header class="recovery-head">
            <i class="bi bi-shield-lock" style="font-size:2.5rem"></i>
            <h1 class="h3 fw-bold mt-2 mb-1">ตั้งรหัสผ่านใหม่</h1>
            <p class="mb-0 opacity-75">ยืนยันด้วยอีเมลและเบอร์โทรศัพท์ที่ผูกกับบัญชี</p>
        </header>
        <div class="recovery-body">
            @if (ViewBag.ResultMessage != null)
            {
                <div class="alert alert-success" role="status">@ViewBag.ResultMessage</div>
            }
            <form asp-controller="User" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" id="recoveryPhone" class="form-control" type="text" inputmode="numeric" autocomplete="tel-national" maxlength="10" pattern="[0-9]{10}" placeholder="กรอกตัวเลข 10 หลัก" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="อย่างน้อย 6 ตัวอักษร" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">เปลี่ยนรหัสผ่าน</button>
            </form>
            <div class="text-center mt-4"><a asp-controller="User" asp-action="Login" class="link-success text-decoration-none">กลับไปเข้าสู่ระบบ</a></div>
        </div>
    </main>
    <script>
        const recoveryPhone = document.getElementById('recoveryPhone');
        recoveryPhone.addEventListener('input', () => recoveryPhone.value = recoveryPhone.value.replace(/\D/g, '').slice(0, 10));
    </script>
</body>
</html>
