     MODAL: ดูรูปสลิปขนาดเต็ม (Slip Viewer Modal)
     ============================================================ -->
<div class="modal fade" id="slipViewerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-3" style="border-radius:18px;">
            <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-image me-1 text-success"></i>สลิปโอนเงิน (<span id="slipViewerCode">-</span>)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="p-2 bg-light rounded text-center">
                <img id="slipViewerImg" src="" alt="Payment Slip" class="img-fluid rounded shadow-sm" style="max-height: 480px; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL: อัปโหลดสลิปเพิ่มเติมสำหรับรายการจองเดิม (Upload Slip Modal)
     ============================================================ -->
<div class="modal fade" id="uploadSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-upload me-2 text-primary"></i>แนบสลิปโอนเงิน</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="small text-muted fw-bold">รหัสการจอง:</label>
                    <input type="text" id="uploadSlipBookingCode" class="form-control fw-bold font-monospace bg-light" readonly />
                </div>
                <div class="mb-3">
                    <label class="small text-muted fw-bold">เลือกไฟล์สลิปโอนเงิน (JPG / PNG):</label>
                    <input type="file" id="uploadSlipFileInput" class="form-control" accept="image/*" />
                </div>
                <div class="alert alert-info small mb-0">
                    <i class="bi bi-info-circle me-1"></i> หลังจากอัปโหลดสลิปแล้ว ระบบจะเปลี่ยนสถานะเป็น <strong>"รอฝ่ายบัญชีตรวจสอบสลิป"</strong> ทันที
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" id="btnSubmitExistingSlip" onclick="submitExistingSlip()">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> บันทึกและส่งสลิป
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     CUSTOMER PROMOTION MODAL (แสดงโปรโมชั่นที่เปิดใช้งานแบบ Real-time)
     ============================================================ -->
<div class="modal fade" id="customerPromoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:20px; border:none; box-shadow:0 25px 60px rgba(0,0,0,0.25);">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); padding:1.4rem 1.8rem; border-top-left-radius:20px; border-top-right-radius:20px;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <h5 class="modal-title fw-bold mb-0">
                            <i class="bi bi-ticket-perforated-fill me-2"></i>โปรโมชั่นและสิทธิพิเศษปัจจุบัน
                        </h5>
                        <small class="text-white-50">อัปเดตตรงจากระบบหลังบ้าน CourtBook</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-4" style="max-height:70vh; overflow-y:auto;">
                <div class="row g-3">
                    @foreach (var promo in promotions.Where(p => p.IsActive == true))
                    {
                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-success">@promo.PromoName</h6>
                                        <span class="badge bg-success-subtle text-success">เปิดใช้งาน</span>
                                    </div>
                                    <p class="small text-muted mb-0">@promo.Description</p>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-dark font-monospace px-3 py-2 fs-6">@promo.PromoCode</span>
                                    <small class="text-muted d-block mt-1">ใช้โค้ดนี้ตอนชำระเงิน</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer bg-light px-4 py-3" style="border-bottom-left-radius:20px; border-bottom-right-radius:20px;">
                <button type="button" class="btn btn-success px-4" data-bs-dismiss="modal" style="border-radius:10px; background:linear-gradient(135deg,#1a472a,#2d6a4f); border:none;" onclick="scrollToBooking()">
                    <i class="bi bi-calendar-plus me-1"></i> ไปจองสนามเลย
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     CLIENT-SIDE JAVASCRIPT LOGIC
     ============================================================ -->
@section Scripts {
    <script>
        const isUserLoggedIn = @(isLoggedIn ? "true" : "false");

        // State Management
        let selectedSlots = new Map(); // key: courtId_slotId, value: { courtId, courtName, slotId, timeRange, price }
        let customerCart = new Map();  // key: productId, value: { productId, productName, type, categoryCode, price, unit, qty, stockQty }
        let currentActiveDate = '@selectedDate.ToString("yyyy-MM-dd")';
        let appliedManualPromoCode = '';
        let appliedPromoDiscount = 0;
        let lastCalculatedPromos = [];

        // Guest Auth Prompt Modal
        function showGuestAuthPrompt(actionName) {
            if (actionName) {
                const actionLabel = document.getElementById('guestActionLabel');
                if (actionLabel) actionLabel.innerText = actionName;
            }
            const modalEl = document.getElementById('guestAuthModal');
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } else {
                if (confirm('ผู้เยี่ยมชม (Guest) ดูข้อมูลได้อย่างเดียว ไม่สามารถจองหรือชำระเงินได้\nต้องการเข้าสู่ระบบสมาชิกเพื่อดำเนินการหรือไม่?')) {
                    window.location.href = '/User/Login';
                }
            }
        }

        // Scroll helpers & Hash handling
        function scrollToBooking(e) {
            if (e) e.preventDefault();
            const el = document.getElementById('bookingSection');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        function scrollToTracking() {
            const el = document.getElementById('myBookingsSection');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        function scrollToShop() {
            const el = document.getElementById('productSection');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash) {
                const target = document.querySelector(window.location.hash);
                if (target) {
                    setTimeout(() => {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 150);
                }
            }
        });

        // ================= CART MANAGEMENT =================
        function addToCustomerCart(id, name, type, catCode, price, unit, stockQty) {
            if (!isUserLoggedIn) {
                showGuestAuthPrompt('สั่งซื้อหรือเช่าอุปกรณ์');
                return;
            }
            if (customerCart.has(id)) {
                const item = customerCart.get(id);
                if (type === 'SALE' && item.qty >= stockQty) {
                    alert(`สินค้า '${name}' มีในสต็อกเพียง ${stockQty} ${unit}`);
                    return;
                }
                item.qty += 1;
            } else {
                customerCart.set(id, {
                    productId: id,
                    productName: name,
                    type: type,
                    categoryCode: catCode,
                    price: parseFloat(price) || 0,
                    unit: unit,
                    qty: 1,
                    stockQty: parseInt(stockQty) || 999
                });
            }
            updateCartBadges();
            updateSummaryBar();
        }

        function removeFromCustomerCart(id) {
            customerCart.delete(id);
            updateCartBadges();
            updateSummaryBar();
            renderModalCartItems();
        }

        function changeCartQty(id, delta) {
            if (!customerCart.has(id)) return;
            const item = customerCart.get(id);
            const newQty = item.qty + delta;
            if (newQty <= 0) {
                removeFromCustomerCart(id);
            } else {
                if (item.type === 'SALE' && newQty > item.stockQty) {
                    alert(`สินค้า '${item.productName}' มีในสต็อกเพียง ${item.stockQty} ${item.unit}`);
                    return;
                }
                item.qty = newQty;
                updateCartBadges();
                updateSummaryBar();
                renderModalCartItems();
            }
        }

        function updateCartBadges() {
            let totalItems = 0;
            customerCart.forEach((item, id) => {
                totalItems += item.qty;
                const badge = document.getElementById(`cardQty_${id}`);
                if (badge) {
                    badge.innerText = item.qty;
                    badge.style.display = item.qty > 0 ? 'inline-block' : 'none';
                }
            });

            // Reset badges for items not in cart
            document.querySelectorAll('.cust-cart-badge').forEach(b => {
                const pid = parseInt(b.id.replace('cardQty_', ''));
                if (!customerCart.has(pid)) {
                    b.innerText = '0';
                    b.style.display = 'none';
                }
            });

            const topBadge = document.getElementById('cartCountBadge');
            if (topBadge) topBadge.innerText = totalItems;

            const summaryCartBadge = document.getElementById('summaryCartBadge');
            if (summaryCartBadge) {
                if (totalItems > 0) {
                    summaryCartBadge.innerText = `+ สินค้า/เช่า ${totalItems} ชิ้น`;
                    summaryCartBadge.style.display = 'inline-block';
                } else {
                    summaryCartBadge.style.display = 'none';
                }
            }
        }

        // ================= DATE & CALENDAR SELECTION =================
        function selectDatePill(dateIso, pillEl) {
            document.querySelectorAll('.date-pill').forEach(p => p.classList.remove('active'));
            pillEl.classList.add('active');
            currentActiveDate = dateIso;
            document.getElementById('datePickerInput').value = dateIso;
            clearAllSelected();
            updateDateLabels(dateIso);
        }

        function onDateInputChange(dateIso) {
            if (!dateIso) return;
            currentActiveDate = dateIso;
            document.querySelectorAll('.date-pill').forEach(p => {
                if (p.getAttribute('data-date') === dateIso) {
                    p.classList.add('active');
                    p.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                } else {
                    p.classList.remove('active');
                }
            });
            clearAllSelected();
            updateDateLabels(dateIso);
        }

        function updateDateLabels(dateIso) {
            const parts = dateIso.split('-');
            const formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
            const summaryDateEl = document.getElementById('summarySelectedDate');
            if (summaryDateEl) summaryDateEl.innerText = `วันที่เลือก: ${formatted}`;
            const modalDateEl = document.getElementById('modalBookingDate');
            if (modalDateEl) modalDateEl.innerText = formatted;
        }

        function filterCourt(courtId) {
            document.querySelectorAll('.btn-group button').forEach(btn => btn.classList.remove('active'));
            if (courtId === 'ALL') {
                document.getElementById('btnFilterAll').classList.add('active');
                document.querySelectorAll('[class*="court-col"], [class*="court-cell-"]').forEach(el => el.style.display = '');
            } else {
                const activeBtn = document.getElementById('btnFilter_' + courtId);
                if (activeBtn) activeBtn.classList.add('active');
                document.querySelectorAll('[class*="court-col"]').forEach(th => {
                    th.style.display = th.classList.contains('court-header-' + courtId) ? '' : 'none';
                });
                document.querySelectorAll('[class*="court-cell-"]').forEach(td => {
                    td.style.display = td.classList.contains('court-cell-' + courtId) ? '' : 'none';
                });
            }
        }

        function toggleSlot(cellEl) {
            const courtId = cellEl.getAttribute('data-court-id');
            const courtName = cellEl.getAttribute('data-court-name');
            const slotId = cellEl.getAttribute('data-slot-id');
            const timeRange = cellEl.getAttribute('data-time-range');
            const price = parseFloat(cellEl.getAttribute('data-price')) || 200;
            const key = `${courtId}_${slotId}`;

            if (selectedSlots.has(key)) {
                selectedSlots.delete(key);
                cellEl.classList.remove('selected');
                cellEl.querySelector('.slot-status-text').innerText = 'ว่าง';
            } else {
                selectedSlots.set(key, { courtId, courtName, slotId, timeRange, price });
                cellEl.classList.add('selected');
                cellEl.querySelector('.slot-status-text').innerHTML = '<i class="bi bi-check2"></i> เลือกแล้ว';
            }
            updateSummaryBar();
        }

        function clearAllSelected() {
            selectedSlots.clear();
            document.querySelectorAll('.slot-cell.selected').forEach(el => {
                el.classList.remove('selected');
                el.querySelector('.slot-status-text').innerText = 'ว่าง';
            });
            updateSummaryBar();
        }

        // ================= AUTOMATIC PROMOTIONS CALCULATION =================
        function calculateAllPromotions() {
            let courtSubtotal = 0;
            selectedSlots.forEach(s => courtSubtotal += s.price);

            let saleSubtotal = 0;
            let rentalSubtotal = 0;
            let totalShuttles = 0;
            let shuttlePrice = 0;
            let racketRentalCount = 0;
            let shoesRentalCount = 0;
            let shoesUnitPrice = 50;

            customerCart.forEach(item => {
                const lineTotal = item.price * item.qty;
                if (item.type === 'RENT') {
                    rentalSubtotal += lineTotal;
                    if (item.categoryCode === 'RACKET' || item.productName.includes('ไม้แบด')) racketRentalCount += item.qty;
                    if (item.categoryCode === 'SHOES' || item.productName.includes('รองเท้า')) {
                        shoesRentalCount += item.qty;
                        shoesUnitPrice = item.price;
                    }
                } else {
                    saleSubtotal += lineTotal;
                    if (item.categoryCode === 'SHUTTLECOCK' || item.productName.includes('ลูกแบด')) {
                        totalShuttles += item.qty;
                        shuttlePrice = item.price;
                    }
                }
            });

            let promoDiscounts = 0;
            let promoBadges = [];

            // 1. Off-peak court 20%
            const playDateObj = new Date(currentActiveDate);
            const dayOfWeek = playDateObj.getDay(); // 0=Sun, 1=Mon... 5=Fri
            const isWeekday = dayOfWeek >= 1 && dayOfWeek <= 5;
            let offPeakDiscount = 0;
            if (isWeekday) {
                selectedSlots.forEach(s => {
                    const sid = parseInt(s.slotId);
                    if (sid >= 2 && sid <= 7) { // 09:00 - 15:00
                        offPeakDiscount += (s.price * 0.20);
                    }
                });
                if (offPeakDiscount > 0) {
                    promoDiscounts += offPeakDiscount;
                    promoBadges.push(`🏸 โปรฯ Off-Peak (09:00-15:00) ลด 20% ค่าคอร์ท (-${Math.round(offPeakDiscount)} ฿)`);
                }
            }

            // 2. Volume-based Shuttlecock (2nd tube 50% off)
            if (totalShuttles >= 2) {
                const shuttleDiscount = Math.round(shuttlePrice * 0.50);
                promoDiscounts += shuttleDiscount;
                promoBadges.push(`🏷️ โปรฯ ลูกแบดหลอดที่ 2 ลด 50% (-${shuttleDiscount} ฿)`);
            }

            // 3. Bundle rental (2 rackets + 2 shoes -> 20% off rental)
            if (racketRentalCount >= 2 && shoesRentalCount >= 2) {
                const equipRentalTotal = (racketRentalCount * 50) + (shoesRentalCount * shoesUnitPrice);
                const bundleDiscount = Math.round(equipRentalTotal * 0.20);
                promoDiscounts += bundleDiscount;
                promoBadges.push(`⚡ โปรฯ เซ็ตเช่าไม้ 2 ไม้ + รองเท้า 2 คู่ ลด 20% (-${bundleDiscount} ฿)`);
            }
            // 4. Cross-selling (1 shuttle + 2 rackets -> free 1 shoes)
            else if (totalShuttles >= 1 && racketRentalCount >= 2 && shoesRentalCount >= 1) {
                promoDiscounts += shoesUnitPrice;
                promoBadges.push(`🎁 โปรฯ ซื้อลูกแบด+เช่าไม้ 2 ไม้ รับสิทธิ์เช่ารองเท้าฟรี 1 คู่ (-${shoesUnitPrice} ฿)`);
            }

            // 5. Total bill discount (>= 600 THB)
            const currentTotal = (courtSubtotal + saleSubtotal + rentalSubtotal) - promoDiscounts;
            if (currentTotal >= 600 && appliedManualPromoCode === 'NEW_MEMBER_100') {
                promoDiscounts += 100;
                promoBadges.push(`🎉 โปรฯ ยอดรวมบิล 600 บาทขึ้นไป ลด 100 บาท`);
            }

            const netTotal = Math.max(0, (courtSubtotal + saleSubtotal + rentalSubtotal) - promoDiscounts);

            lastCalculatedPromos = promoBadges;

            return {
                courtSubtotal,
                saleSubtotal,
                rentalSubtotal,
                promoDiscounts,
                promoBadges,
                netTotal
            };
        }

        function updateSummaryBar() {
            const count = selectedSlots.size;
            const bar = document.getElementById('floatingSummaryBar');
            const cartItemsCount = customerCart.size;

            if (count > 0 || cartItemsCount > 0) {
                bar.classList.add('show');
            } else {
                bar.classList.remove('show');
            }

            document.getElementById('summaryCount').innerText = count;
            document.getElementById('summaryHours').innerText = count;

            const courtSet = new Set();
            selectedSlots.forEach(s => courtSet.add(s.courtName));
            document.getElementById('summaryCourtList').innerText = courtSet.size > 0 ? Array.from(courtSet).join(', ') : '-';

            const calc = calculateAllPromotions();
            document.getElementById('summaryTotalPrice').innerText = Math.round(calc.netTotal).toLocaleString() + ' ฿';
        }

        // ================= OPEN CHECKOUT MODAL =================
        function openBookingModal() {
            if (!isUserLoggedIn) {
                showGuestAuthPrompt('จองสนามและชำระเงิน');
                return;
            }

            if (selectedSlots.size === 0 && customerCart.size === 0) {
                alert('กรุณาเลือกช่วงเวลาคอร์ท หรือเลือกสินค้า/อุปกรณ์อย่างน้อย 1 รายการ');
                return;
            }

            // Render Court Slots in Modal
            const slotsContainer = document.getElementById('modalSelectedSlotsList');
            slotsContainer.innerHTML = '';
            if (selectedSlots.size === 0) {
                slotsContainer.innerHTML = '<div class="text-muted small p-2">ไม่ได้เลือกคอร์ท (สั่งซื้อเฉพาะสินค้า/อุปกรณ์)</div>';
            } else {
                selectedSlots.forEach((slot, key) => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center bg-light p-2 rounded border small';
                    row.innerHTML = `
                        <div>
                            <strong class="text-success"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>${slot.courtName}</strong>: ${slot.timeRange}
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-dark">${slot.price.toLocaleString()} ฿</span>
                        </div>
                    `;
                    slotsContainer.appendChild(row);
                });
            }

            renderModalCartItems();

            const modal = new bootstrap.Modal(document.getElementById('bookingConfirmModal'));
            modal.show();
        }

        function renderModalCartItems() {
            const container = document.getElementById('modalCartItemsList');
            container.innerHTML = '';

            if (customerCart.size === 0) {
                container.innerHTML = '<div class="text-muted small p-2">ยังไม่มีสินค้า/อุปกรณ์ในตะกร้า (<a href="#productSection" data-bs-dismiss="modal" class="text-teal">เลือกซื้อ/เช่าเพิ่ม</a>)</div>';
            } else {
                customerCart.forEach((item, id) => {
                    const isRent = item.type === 'RENT';
                    const lineTotal = item.price * item.qty;
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center bg-light p-2 rounded border small';
                    row.innerHTML = `
                        <div style="flex:1;">
                            <span class="badge ${isRent ? 'bg-primary' : 'bg-success'} me-1" style="font-size:0.7rem;">${isRent ? 'เช่า' : 'ซื้อ'}</span>
                            <strong class="text-dark">${item.productName}</strong>
                            <small class="text-muted d-block">${item.price.toLocaleString()} ฿/${item.unit}</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="input-group input-group-sm" style="width:90px;">
                                <button class="btn btn-outline-secondary px-2 py-0" type="button" onclick="changeCartQty(${id}, -1)">-</button>
                                <span class="input-group-text bg-white px-2 py-0 fw-bold small">${item.qty}</span>
                                <button class="btn btn-outline-secondary px-2 py-0" type="button" onclick="changeCartQty(${id}, 1)">+</button>
                            </div>
                            <span class="fw-bold text-dark" style="min-width:60px; text-align:right;">${lineTotal.toLocaleString()} ฿</span>
                            <button class="btn btn-sm btn-link text-danger p-0 ms-1" type="button" onclick="removeFromCustomerCart(${id})"><i class="bi bi-trash"></i></button>
                        </div>
                    `;
                    container.appendChild(row);
                });
            }

            // Recalculate summary in modal
            const calc = calculateAllPromotions();
            document.getElementById('modalCourtTotal').innerText = calc.courtSubtotal.toLocaleString() + ' ฿';
            document.getElementById('modalSaleTotal').innerText = calc.saleSubtotal.toLocaleString() + ' ฿';
            document.getElementById('modalRentalTotal').innerText = calc.rentalSubtotal.toLocaleString() + ' ฿';
            document.getElementById('modalFinalPrice').innerText = Math.round(calc.netTotal).toLocaleString() + ' ฿';
            document.getElementById('qrPromptPayAmount').innerText = 'ยอดชำระ: ' + Math.round(calc.netTotal).toLocaleString() + ' ฿';

            // Auto promotion badges display
            const promoRow = document.getElementById('promoDiscountRow');
            const promoTagsBox = document.getElementById('appliedPromoList');
            const promoTagsContainer = document.getElementById('promoTagsContainer');

            if (calc.promoDiscounts > 0) {
                promoRow.style.setProperty('display', 'flex', 'important');
                document.getElementById('modalDiscount').innerText = `-${Math.round(calc.promoDiscounts).toLocaleString()} ฿`;

                promoTagsContainer.innerHTML = '';
                calc.promoBadges.forEach(b => {
                    const tag = document.createElement('div');
                    tag.className = 'badge bg-success bg-opacity-10 text-success border border-success text-start py-1 px-2';
                    tag.style.whiteSpace = 'normal';
                    tag.innerText = b;
                    promoTagsContainer.appendChild(tag);
                });
                promoTagsBox.style.display = 'block';
            } else {
                promoRow.style.setProperty('display', 'none', 'important');
                promoTagsBox.style.display = 'none';
            }
        }

        // Promo code application
        function applyPromoCode() {
            const code = document.getElementById('promoCodeInput').value.trim().toUpperCase();
            const promoMsg = document.getElementById('promoMsg');

            if (code === 'NEW_MEMBER_100') {
                appliedManualPromoCode = code;
                renderModalCartItems();
                promoMsg.className = 'small mt-1 text-success fw-bold';
                promoMsg.innerHTML = '<i class="bi bi-check-circle me-1"></i>ใช้โค้ดส่วนลด 100 บาท สำเร็จ!';
            } else if (code) {
                appliedManualPromoCode = '';
                renderModalCartItems();
                promoMsg.className = 'small mt-1 text-danger';
                promoMsg.innerText = 'โค้ดส่วนลดไม่ถูกต้อง หรือเงื่อนไขไม่ตรงตามที่กำหนด';
            }
        }

        // ================= SLIP IMAGE PREVIEW =================
        function previewSlipImage(input) {
            const container = document.getElementById('slipPreviewContainer');
            const img = document.getElementById('slipPreviewImg');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    img.style.display = 'inline-block';
                    container.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                clearSlipPreview();
            }
        }

        function clearSlipPreview() {
            const input = document.getElementById('slipUploadInput');
            if (input) input.value = '';
            const container = document.getElementById('slipPreviewContainer');
            if (container) container.style.display = 'none';
            const img = document.getElementById('slipPreviewImg');
            if (img) img.src = '';
        }

        // ================= SUBMIT BOOKING (AJAX WITH SLIP) =================
        async function submitBookingWithSlip() {
            if (!isUserLoggedIn) {
                showGuestAuthPrompt('ดำเนินการชำระเงิน');
                return;
            }

            const custName = document.getElementById('custName').value.trim();
            const custPhone = document.getElementById('custPhone').value.trim();
            const slipInput = document.getElementById('slipUploadInput');

            if (!custName || !custPhone) {
                alert('กรุณากรอกชื่อ-นามสกุล และเบอร์โทรศัพท์');
                return;
            }

            if (!slipInput.files || slipInput.files.length === 0) {
                if (!confirm('คุณยังไม่ได้แนบสลิปโอนเงิน ต้องการดำเนินการต่อและแนบสลิปภายหลังหรือไม่?')) {
                    return;
                }
            }

            const btnSubmit = document.getElementById('btnSubmitBooking');
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> กำลังบันทึกการจอง...';

            try {
                const formData = new FormData();
                formData.append('customerName', custName);
                formData.append('customerPhone', custPhone);
                formData.append('playDate', currentActiveDate);

                // Serialize slots
                const slotsArray = [];
                selectedSlots.forEach(s => {
                    slotsArray.push({
                        courtId: parseInt(s.courtId),
                        courtName: s.courtName,
                        slotId: parseInt(s.slotId),
                        timeRange: s.timeRange,
                        price: s.price
                    });
                });
                formData.append('selectedSlotsJson', JSON.stringify(slotsArray));

                // Serialize cart items
                const cartArray = [];
                customerCart.forEach(item => {
                    cartArray.push({
                        productId: item.productId,
                        productName: item.productName,
                        type: item.type,
                        categoryCode: item.categoryCode,
                        qty: item.qty,
                        price: item.price
                    });
                });
                formData.append('cartItemsJson', JSON.stringify(cartArray));
                formData.append('promoCode', appliedManualPromoCode);

                if (slipInput.files && slipInput.files.length > 0) {
                    formData.append('slipFile', slipInput.files[0]);
                }

                const response = await fetch('/Home/SubmitBooking', {
                    method: 'POST',
                    body: formData
                });

                const res = await response.json();

                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check2-circle me-1"></i> ยืนยันการจองและส่งสลิป';

                if (res.success) {
                    // Close Confirm Modal
                    const confirmModalEl = document.getElementById('bookingConfirmModal');
                    const confirmModal = bootstrap.Modal.getInstance(confirmModalEl);
                    if (confirmModal) confirmModal.hide();

                    // Fill Success Modal
                    document.getElementById('successBookingCode').innerText = res.bookingCode;
                    document.getElementById('successBookingDate').innerText = res.playDate;
                    document.getElementById('successBookingStatus').innerText = res.statusText;
                    document.getElementById('successBookingAmount').innerText = res.netAmount.toLocaleString() + ' ฿';

                    const slotNames = slotsArray.map(s => `${s.courtName} (${s.timeRange})`).join(', ');
                    document.getElementById('successBookingSlots').innerText = slotNames || '-';

                    if (cartArray.length > 0) {
                        const itemsSummary = cartArray.map(i => `${i.productName} x ${i.qty}`).join(', ');
                        document.getElementById('successBookingItems').innerText = itemsSummary;
                        document.getElementById('successBookingItemsRow').style.display = 'flex';
                    } else {
                        document.getElementById('successBookingItemsRow').style.display = 'none';
                    }

                    // Update Stat counter
                    const statEl = document.getElementById('statMyBookings');
                    if (statEl) statEl.innerText = parseInt(statEl.innerText || '0') + 1;

                    // Mark slots as booked visually
                    selectedSlots.forEach((slot, key) => {
                        const el = document.querySelector(`.slot-cell[data-court-id="${slot.courtId}"][data-slot-id="${slot.slotId}"]`);
                        if (el) {
                            el.classList.remove('selected');
                            el.classList.add('booked');
                            el.removeAttribute('onclick');
                            el.querySelector('.slot-status-text').innerHTML = '<i class="bi bi-lock-fill me-1"></i>จองแล้ว';
                        }
                    });

                    // Clear state
                    customerCart.clear();
                    clearAllSelected();
                    updateCartBadges();
                    clearSlipPreview();

                    // Add new row to recent bookings table
                    prependNewBookingRow(res.bookingCode, res.playDate, slotNames, cartArray, res.netAmount, res.statusText, res.slipUrl);

                    // Show Success Modal
                    const successModal = new bootstrap.Modal(document.getElementById('bookingSuccessModal'));
                    successModal.show();
                } else {
                    if (res.requireLogin) {
                        showGuestAuthPrompt('ดำเนินการชำระเงิน');
                        return;
                    }
                    alert(res.message || 'เกิดข้อผิดพลาดในการบันทึกการจอง');
                }
            } catch (err) {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check2-circle me-1"></i> ยืนยันการจองและส่งสลิป';
                alert('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์: ' + err.message);
            }
        }

        function prependNewBookingRow(code, date, slots, cart, netAmount, statusText, slipUrl) {
            const tableBody = document.getElementById('myBookingsTableBody');
            const emptyMsg = document.getElementById('emptyBookingsMsg');
            if (emptyMsg) emptyMsg.style.display = 'none';
            if (!tableBody) return;

            const tr = document.createElement('tr');
            tr.id = `row_${code}`;
            const cartText = cart.map(c => `${c.productName} x ${c.qty}`).join(', ') || '-';
            const slipBtn = slipUrl ?
                `<button type="button" class="btn btn-sm btn-outline-success py-1 px-2" style="border-radius:8px;" onclick="viewSlipFull('${slipUrl}', '${code}')"><i class="bi bi-image me-1"></i> ดูสลิป</button>` :
                `<button type="button" class="btn btn-sm btn-outline-warning text-dark py-1 px-2" style="border-radius:8px;" onclick="openUploadSlipModal('${code}')"><i class="bi bi-upload me-1"></i> แนบสลิป</button>`;

            tr.innerHTML = `
                <td>
                    <strong class="font-monospace text-primary">${code}</strong>
                    <small class="text-muted d-block" style="font-size:0.75rem;">เมื่อสักครู่</small>
                </td>
                <td><span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i>${date}</span></td>
                <td><div class="small">${slots}</div></td>
                <td><div class="small text-truncate" style="max-width:180px;">${cartText}</div></td>
                <td><strong class="text-dark">${netAmount.toLocaleString()} ฿</strong></td>
                <td><span class="badge bg-warning text-dark px-2 py-1">${statusText}</span></td>
                <td>${slipBtn}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-light border px-2 py-1" style="border-radius:8px;" onclick="quickTrack('${code}')"><i class="bi bi-eye me-1"></i> ติดตาม</button>
                </td>
            `;
            tableBody.prepend(tr);
        }

        // ================= TRACK BOOKING LIVE =================
        async function trackBookingLive() {
            const query = document.getElementById('trackSearchInput').value.trim();
            if (!query) {
                alert('กรุณากรอกรหัสการจอง หรือเบอร์โทรศัพท์');
                return;
            }

            const resultBox = document.getElementById('trackResultBox');
            resultBox.style.display = 'block';
            resultBox.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> กำลังดึงข้อมูลสถานะ...</div>';

            try {
                const response = await fetch(`/Home/TrackBooking?code=${encodeURIComponent(query)}`);
                const res = await response.json();

                if (!res.success) {
                    resultBox.innerHTML = `
                        <div class="alert alert-warning border-0 rounded-4 p-3 d-flex align-items-center gap-3">
                            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
                            <div>
                                <h6 class="fw-bold mb-0">${res.message}</h6>
                                <small class="text-muted">กรุณาตรวจสอบรหัสการจอง เช่น BK-20261116-8842 หรือตรวจสอบเบอร์โทรศัพท์ที่ใช้จอง</small>
                            </div>
                        </div>
                    `;
                    return;
                }

                // Render Progress Stepper
                const step = res.step;
                const step1Class = step >= 1 ? 'step-completed' : 'step-pending';
                const step2Class = step >= 2 ? 'step-completed' : (step === 1 ? 'step-active' : 'step-pending');
                const step3Class = step >= 3 ? 'step-completed' : (step === 2 ? 'step-active' : 'step-pending');
                const step4Class = step >= 4 ? 'step-completed' : (step === 3 ? 'step-active' : 'step-pending');

                const courtListHtml = res.courts && res.courts.length > 0 ?
                    res.courts.map(c => `<li><i class="bi bi-check2 text-success me-1"></i><strong>${c.courtName}</strong> (${c.timeRange}) - ${c.price.toLocaleString()} ฿</li>`).join('') :
                    '<li class="text-muted">ไม่มีการจองคอร์ท</li>';

                const itemsListHtml = res.items && res.items.length > 0 ?
                    res.items.map(i => `<li><i class="bi bi-box-seam me-1"></i>[${i.type === 'RENT' ? 'เช่า' : 'ซื้อ'}] ${i.name} x ${i.qty} (${i.lineTotal.toLocaleString()} ฿)</li>`).join('') :
                    '<li class="text-muted">ไม่มีสินค้า/อุปกรณ์</li>';

                const slipBtnHtml = res.slipUrl ?
                    `<button class="btn btn-sm btn-outline-success mt-2" onclick="viewSlipFull('${res.slipUrl}', '${res.bookingCode}')"><i class="bi bi-image me-1"></i> ดูสลิปที่แนบไว้</button>` :
                    `<button class="btn btn-sm btn-warning mt-2 fw-bold" onclick="openUploadSlipModal('${res.bookingCode}')"><i class="bi bi-upload me-1"></i> แนบสลิปโอนเงินตอนนี้</button>`;

                resultBox.innerHTML = `
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="background:#f8fafc;">
                            <div>
                                <span class="badge ${res.badgeClass} me-2 px-3 py-2 fs-6">${res.statusText}</span>
                                <strong class="font-monospace fs-5 text-primary">${res.bookingCode}</strong>
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-calendar3 me-1"></i>วันที่เล่น: <strong>${res.playDate}</strong> • วันที่ทำรายการ: ${res.createdAt}
                            </div>
                        </div>

                        <!-- 4-Step Visual Progress Stepper -->
                        <div class="p-4 bg-light border-bottom">
                            <div class="d-flex justify-content-between align-items-center position-relative flex-wrap gap-2 text-center" style="max-width:700px; margin:0 auto;">
                                <div class="flex-fill">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-1" style="width:40px; height:40px; background:${step >= 1 ? '#16a34a' : '#94a3b8'};">
                                        <i class="bi bi-clipboard-check"></i>
                                    </div>
                                    <div class="small fw-bold">1. ยื่นคำขอจอง</div>
                                </div>
                                <div class="text-muted"><i class="bi bi-arrow-right"></i></div>
                                <div class="flex-fill">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-1" style="width:40px; height:40px; background:${step >= 2 ? '#16a34a' : (step === 1 ? '#f59e0b' : '#94a3b8')};">
                                        <i class="bi bi-upload"></i>
                                    </div>
                                    <div class="small fw-bold">2. แนบสลิปโอนเงิน</div>
                                </div>
                                <div class="text-muted"><i class="bi bi-arrow-right"></i></div>
                                <div class="flex-fill">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-1" style="width:40px; height:40px; background:${step >= 3 ? '#16a34a' : (step === 2 ? '#f59e0b' : '#94a3b8')};">
                                        <i class="bi bi-shield-check"></i>
                                    </div>
                                    <div class="small fw-bold">3. บัญชีอนุมัติคิว</div>
                                </div>
                                <div class="text-muted"><i class="bi bi-arrow-right"></i></div>
                                <div class="flex-fill">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white mb-1" style="width:40px; height:40px; background:${step >= 4 ? '#2563eb' : '#94a3b8'};">
                                        <i class="bi bi-door-open"></i>
                                    </div>
                                    <div class="small fw-bold">4. เช็คอินเข้าเล่น</div>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-6 border-end">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>ข้อมูลการจอง</h6>
                                    <ul class="list-unstyled small mb-3">
                                        <li><strong>ผู้จอง:</strong> ${res.customerName} (${res.customerPhone})</li>
                                        <li><strong>วันที่เล่น:</strong> ${res.playDate}</li>
                                    </ul>
                                    <h6 class="fw-bold text-dark mb-1"><i class="bi bi-geo-alt me-1 text-success"></i>คอร์ทที่จอง:</h6>
                                    <ul class="list-unstyled small mb-2">${courtListHtml}</ul>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-cart me-1 text-teal"></i>สินค้าและอุปกรณ์เช่า:</h6>
                                    <ul class="list-unstyled small mb-3">${itemsListHtml}</ul>
                                    <div class="p-3 bg-light rounded-3 small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>ค่าคอร์ท:</span> <strong>${res.courtAmount.toLocaleString()} ฿</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>ค่าสินค้า/เช่า:</span> <strong>${(res.saleAmount + res.rentalAmount).toLocaleString()} ฿</strong>
                                        </div>
                                        ${res.discountAmount > 0 ? `<div class="d-flex justify-content-between text-success mb-1"><span>ส่วนลดโปรโมชั่น:</span> <strong>-${res.discountAmount.toLocaleString()} ฿</strong></div>` : ''}
                                        <div class="d-flex justify-content-between pt-1 border-top mt-1">
                                            <span class="fw-bold">ยอดชำระสุทธิ:</span>
                                            <strong class="text-success fs-5">${res.netAmount.toLocaleString()} ฿</strong>
                                        </div>
                                        ${slipBtnHtml}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } catch (err) {
                resultBox.innerHTML = `<div class="alert alert-danger">เกิดข้อผิดพลาดในการดึงข้อมูล: ${err.message}</div>`;
            }
        }

        function quickTrack(code) {
            document.getElementById('trackSearchInput').value = code;
            scrollToTracking();
            setTimeout(trackBookingLive, 200);
        }

        // ================= SLIP VIEWER & UPLOAD FOR EXISTING BOOKING =================
        function viewSlipFull(url, code) {
            document.getElementById('slipViewerImg').src = url;
            document.getElementById('slipViewerCode').innerText = code;
            const modal = new bootstrap.Modal(document.getElementById('slipViewerModal'));
            modal.show();
        }

        function openUploadSlipModal(code) {
            document.getElementById('uploadSlipBookingCode').value = code;
            document.getElementById('uploadSlipFileInput').value = '';
            const modal = new bootstrap.Modal(document.getElementById('uploadSlipModal'));
            modal.show();
        }

        async function submitExistingSlip() {
            const code = document.getElementById('uploadSlipBookingCode').value;
            const fileInput = document.getElementById('uploadSlipFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('กรุณาเลือกไฟล์สลิปโอนเงิน');
                return;
            }

            const btn = document.getElementById('btnSubmitExistingSlip');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> กำลังอัปโหลด...';

            try {
                const fd = new FormData();
                fd.append('bookingCode', code);
                fd.append('slipFile', fileInput.files[0]);

                const response = await fetch('/Home/UploadBookingSlip', {
                    method: 'POST',
                    body: fd
                });
                const res = await response.json();

                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> บันทึกและส่งสลิป';

                if (res.success) {
                    const modalEl = document.getElementById('uploadSlipModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    alert(res.message);
                    quickTrack(code);
                } else {
                    alert(res.message || 'เกิดข้อผิดพลาดในการอัปโหลดสลิป');
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> บันทึกและส่งสลิป';
                alert('ข้อผิดพลาด: ' + err.message);
            }
        }

        function showPromoInfo() {
            const modal = new bootstrap.Modal(document.getElementById('customerPromoModal'));
            modal.show();
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash === '#bookingSection' || window.location.search.includes('date=')) {
                setTimeout(scrollToBooking, 250);
            } else if (window.location.hash === '#myBookingsSection') {
                setTimeout(scrollToTracking, 250);
            }
        });
    </script>
}
