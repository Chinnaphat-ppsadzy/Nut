@model List<Chinnaphat_8272_L005.Models.Booking>
@{
    Layout = "_AccountingLayout";
    ViewData["Title"] = "รายงานสรุปยอดขาย & วิเคราะห์รายได้";

    string reportType = ViewBag.ReportType as string ?? "daily";
    string selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Today.Month;
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Today.Year;

    decimal totalCourt = ViewBag.TotalCourt ?? 0;
    decimal totalSale = ViewBag.TotalSale ?? 0;
    decimal totalRent = ViewBag.TotalRent ?? 0;
    decimal totalDiscount = ViewBag.TotalDiscount ?? 0;
    decimal netTotal = ViewBag.NetTotal ?? 0;
    int transactionsCount = ViewBag.TransactionsCount ?? 0;

    decimal grossTotal = totalCourt + totalSale + totalRent;
    double courtPercent = grossTotal > 0 ? (double)(totalCourt / grossTotal * 100) : 0;
    double salePercent = grossTotal > 0 ? (double)(totalSale / grossTotal * 100) : 0;
    double rentPercent = grossTotal > 0 ? (double)(totalRent / grossTotal * 100) : 0;

    string[] monthNames = { "", "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
                            "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม" };
}

<style>
    @@media print {
        .no-print { display: none !important; }
        body { background: white !important; font-size: 12px; }
        .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    }
</style>

<!-- ============================================================
     HERO BANNER
     ============================================================ -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:18px; background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); color:white;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-white text-success fw-bold mb-2 font-monospace">FINANCIAL PERFORMANCE</span>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-graph-up-arrow me-2"></i>รายงานสรุปยอดขาย & การเงิน CourtBook
                </h4>
                <p class="mb-0 text-white-50 small">
                    สรุปรายได้แยกตามประเภท: ค่าคอร์ทสนาม, ยอดจำหน่ายสินค้า, ค่าบริการเช่าอุปกรณ์ พร้อมหักส่วนลดสุทธิ
                </p>
            </div>
            <div class="d-flex gap-2 no-print">
                <button onclick="window.print();" class="btn btn-light fw-bold text-success px-4 py-2 shadow-sm" style="border-radius:10px;">
                    <i class="bi bi-printer-fill me-1"></i> พิมพ์รายงาน (Print)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     FILTER CONTROLS (DAILY vs MONTHLY)
     ============================================================ -->
<div class="card border-0 shadow-sm mb-4 no-print" style="border-radius:16px;">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <!-- Tabs -->
            <div class="d-flex gap-2">
                <a asp-action="Reports" asp-route-reportType="daily" asp-route-date="@selectedDate"
                   class="btn @(reportType == "daily" ? "btn-success" : "btn-light") fw-semibold px-4 py-2" style="border-radius:10px;">
                    <i class="bi bi-calendar-event me-2"></i> รายงานรายวัน (Daily)
                </a>
                <a asp-action="Reports" asp-route-reportType="monthly" asp-route-month="@selectedMonth" asp-route-year="@selectedYear"
                   class="btn @(reportType == "monthly" ? "btn-success" : "btn-light") fw-semibold px-4 py-2" style="border-radius:10px;">
                    <i class="bi bi-calendar3 me-2"></i> รายงานรายเดือน (Monthly)
                </a>
            </div>

            <!-- Filter Inputs -->
            <form method="get" asp-action="Reports" class="d-flex align-items-center gap-2">
                <input type="hidden" name="reportType" value="@reportType" />

                @if (reportType == "daily")
                {
                    <label class="text-muted small fw-bold mb-0">เลือกวันที่:</label>
                    <input type="date" name="date" class="form-control" value="@selectedDate" style="max-width:180px;" />
                }
                else
                {
                    <label class="text-muted small fw-bold mb-0">เลือกเดือน:</label>
                    <select name="month" class="form-select" style="max-width:150px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <!option value="@m" @(m == selectedMonth ? "selected" : "")>@monthNames[m]</!option>
                        }
                    </select>

                    <label class="text-muted small fw-bold mb-0">ปี:</label>
                    <select name="year" class="form-select" style="max-width:110px;">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                        {
                            <!option value="@y" @(y == selectedYear ? "selected" : "")>@y</!option>
                        }
                    </select>
                }

                <button type="submit" class="btn btn-success fw-bold px-3 py-2" style="background: linear-gradient(135deg, #1a472a, #2d6a4f); border:none; border-radius:8px;">
                    <i class="bi bi-funnel-fill me-1"></i> ดึงรายงาน
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     REPORT PERIOD HEADER
     ============================================================ -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark">
            @if (reportType == "daily")
            {
                <span><i class="bi bi-calendar-check text-success me-2"></i>สรุปผลประกอบการประจำวันที่: <span class="text-success">@DateOnly.Parse(selectedDate).ToString("dd/MM/yyyy")</span></span>
            }
            else
            {
                <span><i class="bi bi-calendar-range text-success me-2"></i>สรุปผลประกอบการประจำเดือน: <span class="text-success">@monthNames[selectedMonth] @selectedYear</span></span>
            }
        </h5>
        <small class="text-muted">ข้อมูลเฉพาะการจองที่อนุมัติและสำเร็จแล้ว (CONFIRMED / CHECKED IN / COMPLETED)</small>
    </div>
    <div class="text-end">
        <span class="badge bg-light text-dark border px-3 py-2 fs-6">
            <i class="bi bi-receipt me-1 text-success"></i> รวมทั้งหมด @transactionsCount รายการ
        </span>
    </div>
</div>

<!-- ============================================================
     5 KPI REVENUE SUMMARY CARDS
     ============================================================ -->
<div class="row g-3 mb-4">
    <!-- 1. Net Total (Highlighted) -->
    <div class="col-lg-4 col-md-6">
        <div class="card border-0 shadow-sm p-4 h-100 text-white" style="border-radius:18px; background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 100%);">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-white-50 small fw-bold text-uppercase">รายได้สุทธิรวม (Net Revenue)</div>
                    <div class="fs-2 fw-bold font-monospace mt-1">@netTotal.ToString("N2") ฿</div>
                </div>
                <div class="rounded-circle bg-white bg-opacity-25 p-3 text-white">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
            <div class="mt-3 text-white-50 small">
                หลังหักส่วนลดทั้งหมด คำนวณจาก @transactionsCount บิล
            </div>
        </div>
    </div>

    <!-- 2. Court Revenue -->
    <div class="col-lg-2 col-md-6">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius:16px; border-top: 4px solid #2d6a4f !important;">
            <div class="text-muted small fw-bold">ค่าสนามแบดมินตัน</div>
            <div class="fs-4 fw-bold text-dark font-monospace mt-1">@totalCourt.ToString("N2") ฿</div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
                <span class="badge bg-success bg-opacity-10 text-success font-monospace">@courtPercent.ToString("F1")%</span>
                <i class="bi bi-dribbble text-success fs-5"></i>
            </div>
        </div>
    </div>

    <!-- 3. Product Sales -->
    <div class="col-lg-2 col-md-6">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius:16px; border-top: 4px solid #0d6efd !important;">
            <div class="text-muted small fw-bold">ยอดขายสินค้า</div>
            <div class="fs-4 fw-bold text-primary font-monospace mt-1">@totalSale.ToString("N2") ฿</div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary font-monospace">@salePercent.ToString("F1")%</span>
                <i class="bi bi-cart3 text-primary fs-5"></i>
            </div>
        </div>
    </div>

    <!-- 4. Rental Revenue -->
    <div class="col-lg-2 col-md-6">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius:16px; border-top: 4px solid #fd7e14 !important;">
            <div class="text-muted small fw-bold">ค่าเช่าอุปกรณ์</div>
            <div class="fs-4 fw-bold text-dark font-monospace mt-1">@totalRent.ToString("N2") ฿</div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
                <span class="badge bg-warning bg-opacity-10 text-warning font-monospace">@rentPercent.ToString("F1")%</span>
                <i class="bi bi-tools text-warning fs-5"></i>
            </div>
        </div>
    </div>

    <!-- 5. Discount Amount -->
    <div class="col-lg-2 col-md-6">
        <div class="card border-0 shadow-sm p-3 h-100" style="border-radius:16px; border-top: 4px solid #dc3545 !important;">
            <div class="text-muted small fw-bold">ส่วนลดโปรโมชั่น</div>
            <div class="fs-4 fw-bold text-danger font-monospace mt-1">-@totalDiscount.ToString("N2") ฿</div>
            <div class="mt-2 d-flex justify-content-between align-items-center">
                <span class="badge bg-danger bg-opacity-10 text-danger">โปรโมชั่น</span>
                <i class="bi bi-tag text-danger fs-5"></i>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     REVENUE PROPORTION BAR
     ============================================================ -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold small text-dark"><i class="bi bi-pie-chart-fill text-success me-1"></i> สัดส่วนที่มาของรายได้ (Revenue Breakdown)</span>
            <small class="text-muted">ยอดรวมก่อนหักส่วนลด: @grossTotal.ToString("N2") ฿</small>
        </div>
        <div class="progress" style="height: 12px; border-radius: 6px;">
            <div class="progress-bar bg-success" role="progressbar" style="width: @courtPercent%" title="ค่าสนาม @courtPercent.ToString("F1")%"></div>
            <div class="progress-bar bg-primary" role="progressbar" style="width: @salePercent%" title="ค่าสินค้า @salePercent.ToString("F1")%"></div>
            <div class="progress-bar bg-warning" role="progressbar" style="width: @rentPercent%" title="ค่าเช่า @rentPercent.ToString("F1")%"></div>
        </div>
        <div class="d-flex gap-4 mt-2 small text-secondary">
            <div><span class="badge bg-success rounded-circle me-1" style="width:10px; height:10px; padding:0; display:inline-block;"></span> ค่าสนาม (@courtPercent.ToString("F1")%)</div>
            <div><span class="badge bg-primary rounded-circle me-1" style="width:10px; height:10px; padding:0; display:inline-block;"></span> ยอดขายสินค้า (@salePercent.ToString("F1")%)</div>
            <div><span class="badge bg-warning rounded-circle me-1" style="width:10px; height:10px; padding:0; display:inline-block;"></span> ค่าเช่าอุปกรณ์ (@rentPercent.ToString("F1")%)</div>
        </div>
    </div>
</div>

<!-- ============================================================
     MONTHLY SUMMARY GROUPED BY DAY (IF MONTHLY REPORT)
     ============================================================ -->
@if (reportType == "monthly")
{
    var dayGroups = Model
        .GroupBy(b => b.PlayDate.Day)
        .OrderBy(g => g.Key)
        .ToList();

    <div class="card border-0 shadow-sm mb-4" style="border-radius:18px; overflow:hidden;">
        <div class="p-3 bg-white border-bottom">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table text-success me-2"></i>สรุปยอดขายแยกรายวันในเดือน @monthNames[selectedMonth] @selectedYear
            </h6>
        </div>
        @if (dayGroups.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-secondary">
                            <th>วันที่</th>
                            <th class="text-center">จำนวนคอร์ท/บิล</th>
                            <th class="text-end">ค่าสนาม (฿)</th>
                            <th class="text-end">ค่าสินค้า (฿)</th>
                            <th class="text-end">ค่าเช่า (฿)</th>
                            <th class="text-end">ส่วนลด (฿)</th>
                            <th class="text-end fw-bold">ยอดสุทธิ (฿)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in dayGroups)
                        {
                            decimal dayCourt = g.Sum(x => x.CourtAmount);
                            decimal daySale = g.Sum(x => x.SaleAmount);
                            decimal dayRent = g.Sum(x => x.RentalAmount);
                            decimal dayDisc = g.Sum(x => x.DiscountAmount);
                            decimal dayNet = g.Sum(x => x.NetAmount);
                            <tr>
                                <td>
                                    <strong>วันที่ @g.Key</strong>
                                    <small class="text-muted">(@g.Key/@selectedMonth/@selectedYear)</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@g.Count() บิล</span>
                                </td>
                                <td class="text-end font-monospace">@dayCourt.ToString("N2")</td>
                                <td class="text-end font-monospace">@daySale.ToString("N2")</td>
                                <td class="text-end font-monospace">@dayRent.ToString("N2")</td>
                                <td class="text-end font-monospace text-danger">-@dayDisc.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold text-success fs-6">@dayNet.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>รวมทั้งเดือน</td>
                            <td class="text-center">@transactionsCount บิล</td>
                            <td class="text-end font-monospace text-success">@totalCourt.ToString("N2")</td>
                            <td class="text-end font-monospace text-primary">@totalSale.ToString("N2")</td>
                            <td class="text-end font-monospace text-warning">@totalRent.ToString("N2")</td>
                            <td class="text-end font-monospace text-danger">-@totalDiscount.ToString("N2")</td>
                            <td class="text-end font-monospace text-success fs-5">@netTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                <i class="bi bi-inbox fs-3 text-success d-block mb-1"></i>
                <small>ไม่มีข้อมูลการขายในเดือนที่เลือก</small>
            </div>
        }
    </div>
}

<!-- ============================================================
     DETAILED TRANSACTIONS TABLE
     ============================================================ -->
<div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-check text-success me-2"></i>รายการธุรกรรมทั้งหมด (@Model.Count รายการ)
        </h6>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-secondary">
                        <th>รหัสการจอง</th>
                        <th>วันที่ใช้บริการ</th>
                        <th>ลูกค้า</th>
                        <th>รายละเอียด</th>
                        <th class="text-end">ค่าสนาม</th>
                        <th class="text-end">ค่าสินค้า</th>
                        <th class="text-end">ค่าเช่า</th>
                        <th class="text-end">ส่วนลด</th>
                        <th class="text-end">ยอดสุทธิ</th>
                        <th class="text-center">สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <strong class="font-monospace text-primary">@b.BookingCode</strong>
                            </td>
                            <td>
                                <div>@b.PlayDate.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">สร้างเมื่อ: @b.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(b.User?.FullName ?? "ลูกค้า")</div>
                                <small class="text-muted">@(b.User?.Phone ?? "-")</small>
                            </td>
                            <td>
                                @if (b.BookingSlots != null && b.BookingSlots.Any())
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-dribbble text-success me-1"></i>@b.BookingSlots.Count สนาม
                                    </span>
                                }
                                @if (b.BookingItems != null && b.BookingItems.Any())
                                {
                                    <span class="badge bg-light text-dark border ms-1">
                                        <i class="bi bi-box-seam me-1"></i>@b.BookingItems.Count รายการสินค้า/เช่า
                                    </span>
                                }
                            </td>
                            <td class="text-end font-monospace">@b.CourtAmount.ToString("N2")</td>
                            <td class="text-end font-monospace">@b.SaleAmount.ToString("N2")</td>
                            <td class="text-end font-monospace">@b.RentalAmount.ToString("N2")</td>
                            <td class="text-end font-monospace text-danger">@(b.DiscountAmount > 0 ? $"-{b.DiscountAmount:N2}" : "0.00")</td>
                            <td class="text-end font-monospace fw-bold text-success fs-6">@b.NetAmount.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-success">@b.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end">รวมยอดสุทธิ:</td>
                        <td class="text-end font-monospace text-success">@totalCourt.ToString("N2")</td>
                        <td class="text-end font-monospace text-primary">@totalSale.ToString("N2")</td>
                        <td class="text-end font-monospace text-warning">@totalRent.ToString("N2")</td>
                        <td class="text-end font-monospace text-danger">-@totalDiscount.ToString("N2")</td>
                        <td class="text-end font-monospace text-success fs-5">@netTotal.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-folder-x fs-1 d-block mb-2 text-success"></i>
            <h6>ไม่มีรายการการจองหรือรายได้ในช่วงเวลาที่เลือก</h6>
            <small>ลองเปลี่ยนวันที่หรือเดือนในการค้นหา</small>
        </div>
    }
</div>
