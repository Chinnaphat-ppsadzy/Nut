                <div>
                    <span class="badge bg-white text-success fw-bold mb-2">
                        <i class="bi bi-clock-history me-1"></i> Real-time Tracking
                    </span>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-search me-2"></i>ติดตามสถานะการจอง
                    </h3>
                    <p class="mb-0 opacity-90 small">
                        ตรวจสอบสถานะการชำระเงินและรายการของคุณได้แบบเรียลไทม์ หลังเข้าสู่ระบบสมาชิก
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4 bg-light">
            <!-- Search Bar -->
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
                <label class="form-label fw-bold text-dark mb-2">
                    <i class="bi bi-upc-scan me-1 text-primary"></i> ค้นหารายการจองด่วน (กรอกรหัสการจอง หรือเบอร์โทรศัพท์):
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="trackSearchInput" class="form-control border-start-0" placeholder="เช่น BK-20261116-8842 หรือ 0812345678" onkeydown="if(event.key==='Enter')trackBookingLive()" />
                    <button class="btn btn-primary px-4 fw-bold" type="button" onclick="trackBookingLive()">
                        <i class="bi bi-arrow-right-circle me-1"></i> ตรวจสอบสถานะ
                    </button>
                </div>
                <small class="text-muted mt-2 d-block">
                    <i class="bi bi-info-circle me-1"></i>เพื่อปกป้องข้อมูลคำสั่งซื้อและสลิป กรุณาเข้าสู่ระบบบัญชีเจ้าของรายการก่อนติดตาม
                </small>
            </div>

            <!-- Dynamic Search Result Box -->
            <div id="trackResultBox" style="display:none;" class="mb-4">
                <!-- Rendered dynamically by JavaScript -->
            </div>
        </div>
    </div>
</div>
} @* end tracking section *@

@* ===== การจองของฉัน: แสดงเมื่อ showAll หรือ section=mybookings ===== *@
@if (showAll || sec == "mybookings")
{
<!-- ============================================================
     MY BOOKINGS SECTION (การจองของฉัน)
     สมาชิก: เห็นเฉพาะการจองของตัวเอง + แนบสลิปได้
     Guest: เห็น Privacy Shield - ไม่เห็นการจองของคนอื่นเด็ดขาด
     ============================================================ -->
<div id="myBookingsSection" class="mt-5 mb-5 scroll-mt-4">
    <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
        <!-- Header - CourtBook Green Theme -->
        <div class="p-4 text-white" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-white text-success fw-bold mb-2">
                        <i class="bi bi-calendar2-check me-1"></i> My Bookings
                    </span>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-person-badge me-2"></i>การจองของฉัน
                    </h3>
                    <p class="mb-0 opacity-90 small">
                        @if (isLoggedIn)
                        {
                            <text>ประวัติการจองทั้งหมดของคุณ — แนบสลิปโอนเงิน, ติดตามสถานะ, ดูรายละเอียดได้ครบจบที่นี่</text>
                        }
                        else
                        {
                            <text>เข้าสู่ระบบสมาชิกเพื่อดูประวัติการจองของคุณ (Guest ไม่สามารถดูการจองของคนอื่นได้)</text>
                        }
                    </p>
                </div>
                @if (isLoggedIn)
                {
                    <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-50 px-3 py-2">
                        <i class="bi bi-bookmark-check me-1"></i> @myBookings.Count รายการ
                    </span>
                }
            </div>
        </div>

        <div class="card-body p-4 bg-light">
            @if (isLoggedIn)
            {
                <!-- ===== ตารางการจองของสมาชิก (เฉพาะของตัวเองเท่านั้น) ===== -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-list-check me-2 text-success"></i>รายการจองของคุณ (@myBookings.Count รายการ)
                        </h6>
                        <small class="text-muted">
                            <i class="bi bi-shield-check me-1 text-success"></i>แสดงเฉพาะการจองของคุณเท่านั้น • อัปเดตจากฝ่ายบัญชีและการเงิน
                        </small>
                    </div>

                    @if (myBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small text-secondary">
                                        <th>รหัสการจอง</th>
                                        <th>วันที่เล่น</th>
                                        <th>คอร์ท & เวลา</th>
                                        <th>สินค้า/เช่า</th>
                                        <th>ยอดชำระสุทธิ</th>
                                        <th>สถานะการจอง</th>
                                        <th>สลิปโอนเงิน</th>
                                        <th class="text-end">รายละเอียด</th>
                                    </tr>
                                </thead>
                                <tbody id="myBookingsTableBody">
                                    @foreach (var b in myBookings)
                                    {
                                        <tr id="row_@b.BookingCode">
                                            <td>
                                                <strong class="font-monospace text-success">@b.BookingCode</strong>
                                                <small class="text-muted d-block" style="font-size:0.75rem;">@b.CreatedAt.ToString("dd/MM HH:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    <i class="bi bi-calendar3 me-1"></i>@b.PlayDate
                                                </span>
                                            </td>
                                            <td>
                                                @if (b.CourtSlots.Any())
                                                {
                                                    <div class="small">
                                                        @foreach (var cs in b.CourtSlots)
                                                        {
                                                            <div><i class="bi bi-circle-fill text-success" style="font-size:0.5rem;"></i> @cs</div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (b.ItemsSummary.Any())
                                                {
                                                    <div class="small text-truncate" style="max-width:180px;" title="@string.Join(", ", b.ItemsSummary)">
                                                        @string.Join(", ", b.ItemsSummary)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                            <td>
                                                <strong class="text-dark">@b.NetAmount.ToString("N0") ฿</strong>
                                                @if (b.DiscountAmount > 0)
                                                {
                                                    <small class="text-success d-block" style="font-size:0.75rem;">ลด @b.DiscountAmount.ToString("N0") ฿</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @b.StatusBadgeClass px-2 py-1">
                                                    @b.StatusText
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(b.SlipImageUrl))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success py-1 px-2" style="border-radius:8px;" onclick="viewSlipFull('@b.SlipImageUrl', '@b.BookingCode')">
                                                        <i class="bi bi-image me-1"></i> ดูสลิป
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-warning text-dark fw-bold py-1 px-2" style="border-radius:8px;" onclick="openUploadSlipModal('@b.BookingCode')">
                                                        <i class="bi bi-upload me-1"></i> แนบสลิป
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-light border px-2 py-1" style="border-radius:8px;" onclick="quickTrack('@b.BookingCode')">
                                                    <i class="bi bi-eye me-1"></i> ติดตาม
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted" id="emptyBookingsMsg">
                            <i class="bi bi-inbox" style="font-size:3rem;"></i>
                            <p class="mt-2 mb-1">ยังไม่มีประวัติการจอง</p>
                            <p class="mb-3 small">คุณสามารถเลือกคอร์ทและกดจองสนามได้เลยทันที</p>
                            <a href="/Home/Customer?section=booking" class="btn btn-sm btn-outline-success" style="border-radius:10px;">
                                <i class="bi bi-calendar-plus me-1"></i> ไปจองสนามเลย
                            </a>
                        </div>
                    }
                </div>

                <!-- คำแนะนำการแนบสลิป -->
                <div class="card border-0 shadow-sm rounded-4 mt-3 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width:42px; height:42px;">
                                <i class="bi bi-info-circle text-info fs-5"></i>
                            </div>
                            <div class="small">
                                <strong class="text-dark">วิธีแนบสลิปโอนเงิน:</strong>
                                <ol class="mb-0 mt-1 ps-3 text-muted">
                                    <li>กดปุ่ม <span class="badge bg-warning text-dark"><i class="bi bi-upload me-1"></i>แนบสลิป</span> ที่รายการจองที่ต้องการ</li>
                                    <li>เลือกไฟล์สลิปโอนเงิน (JPG / PNG)</li>
                                    <li>กด "บันทึกและส่งสลิป" → ระบบจะส่งสลิปให้ฝ่ายบัญชีตรวจสอบทันที</li>
                                    <li>สถานะจะเปลี่ยนเป็น <span class="badge bg-warning text-dark">รอฝ่ายบัญชีตรวจสอบสลิป</span> → รอฝ่ายบัญชีอนุมัติ</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- ===== GUEST PRIVACY SHIELD — ไม่เห็นการจองของคนอื่นเด็ดขาด ===== -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-5 text-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:80px; height:80px;">
                            <i class="bi bi-shield-lock text-warning" style="font-size:2.5rem;"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-2">กรุณาเข้าสู่ระบบสมาชิก</h4>
                        <p class="text-muted mb-1">ฟีเจอร์ "การจองของฉัน" สำหรับสมาชิกที่เข้าสู่ระบบแล้วเท่านั้น</p>
                        <p class="text-muted small mb-4">
                            <i class="bi bi-shield-check text-success me-1"></i>ในโหมดผู้เยี่ยมชม (Guest) ระบบจะไม่แสดงข้อมูลการจองของบุคคลอื่นโดยเด็ดขาด
                            เพื่อปกป้องความเป็นส่วนตัวของสมาชิกทุกท่าน
                        </p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <a asp-action="Login" asp-controller="User" class="btn btn-success fw-bold px-4 py-2" style="border-radius:10px;">
                                <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ (Login)
                            </a>
                            <a asp-action="Register" asp-controller="User" class="btn btn-outline-success fw-bold px-4 py-2" style="border-radius:10px;">
                                <i class="bi bi-person-plus me-1"></i> สมัครสมาชิกใหม่
                            </a>
                        </div>
                        <div class="mt-4 p-3 bg-light rounded-3 text-start small">
                            <div class="fw-bold text-dark mb-1"><i class="bi bi-lightbulb text-warning me-1"></i>ต้องการติดตามสถานะการจอง?</div>
                            <p class="text-muted mb-0">
                                หากคุณต้องการตรวจสอบสถานะการจองเฉพาะรายการ สามารถใช้เมนู
                            <a href="/Home/Customer?section=tracking" class="text-success fw-bold"><i class="bi bi-search me-1"></i>ติดตามสถานะการจอง</a>
                                โดยเข้าสู่ระบบบัญชีสมาชิกที่ใช้ทำรายการ
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
} @* end mybookings section *@

<!-- ============================================================
     GUEST AUTH REQUIRED MODAL
     ============================================================ -->
<div class="modal fade" id="guestAuthModal" tabindex="-1" aria-labelledby="guestAuthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:20px; border:none; box-shadow:0 25px 60px rgba(0,0,0,0.25); overflow:hidden;">
            <div class="modal-header border-0 bg-warning bg-opacity-10 p-4 pb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width:50px; height:50px; font-size:1.6rem;">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="guestAuthModalLabel">
                            กรุณาเข้าสู่ระบบสมาชิก
                        </h5>
                        <small class="text-muted">Guest ดูข้อมูลได้อย่างเดียว ไม่สามารถจองหรือชำระเงินได้</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 pt-3">
                <p class="text-secondary mb-3">
                    ขณะนี้ท่านกำลังเข้าชมในฐานะ <strong class="text-dark">ผู้เยี่ยมชม (Guest)</strong> ระบบเปิดให้ดูตารางสนามและสินค้าเท่านั้น หากต้องการ<strong class="text-success" id="guestActionLabel">จองคอร์ทหรือสั่งซื้อสินค้า</strong> กรุณาเข้าสู่ระบบด้วยบัญชีสมาชิกก่อนครับ
                </p>
                <div class="p-3 bg-light rounded-3 border mb-3 small">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-stars text-warning me-1"></i> สิทธิพิเศษเมื่อเป็นสมาชิก CourtBook:</div>
                    <ul class="mb-0 ps-3 text-muted">
                        <li>จองคอร์ทแบดมินตันมาตรฐานสากลล่วงหน้า</li>
                        <li>สั่งซื้อและเช่าอุปกรณ์พร้อมส่วนลดโปรโมชั่นอัตโนมัติ 5 รายการ</li>
                        <li>ชำระเงินผ่าน PromptPay QR และแนบสลิปสะดวกรวดเร็ว</li>
                        <li>บันทึกประวัติการจองและเช็คสถานะได้แบบเรียลไทม์ 24 ชม.</li>
                    </ul>
                </div>
                <div class="d-grid gap-2">
                    <a asp-action="Login" asp-controller="User" class="btn btn-success fw-bold py-2 shadow-sm" style="border-radius:10px;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ (Login)
                    </a>
                    <a asp-action="Register" asp-controller="User" class="btn btn-outline-success fw-bold py-2" style="border-radius:10px;">
                        <i class="bi bi-person-plus me-1"></i> สมัครสมาชิกใหม่ (Register)
                    </a>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2 px-4 justify-content-center">
                <button type="button" class="btn btn-link text-muted text-decoration-none btn-sm" data-bs-dismiss="modal">
                    ดูข้อมูลต่อในฐานะ Guest
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     BOOKING CONFIRMATION & PAYMENT MODAL
     ============================================================ -->
<div class="modal fade" id="bookingConfirmModal" tabindex="-1" aria-labelledby="bookingConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="border-radius:20px; overflow:hidden; border:none; box-shadow:0 25px 60px rgba(0,0,0,0.25);">
            <div class="modal-header-gradient" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); color:white; padding:1.25rem 1.75rem;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="bookingConfirmModalLabel">
                            <i class="bi bi-shield-check me-2"></i>ยืนยันการจองสนาม & สรุปรายการสินค้า (CourtBook)
                        </h5>
                        <small class="text-white-50">ตรวจสอบรายการคอร์ท สินค้า/อุปกรณ์ คำนวณโปรโมชั่นอัตโนมัติ และแนบสลิปโอนเงิน</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="modal-body p-4 bg-light">
                <div class="row g-4">
                    <!-- รายการคอร์ท & สินค้าที่เลือก -->
                    <div class="col-lg-7">
                        <!-- Court Slots -->
                        <div class="p-3 bg-white rounded-4 border mb-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2 text-success fw-bold">
                                    <i class="bi bi-geo-alt-fill"></i> CourtBook Arena (สาขาพญาไท)
                                </div>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-calendar3 me-1"></i> <span id="modalBookingDate">10 พ.ย. 2026</span>
                                </span>
                            </div>
                            <label class="small text-muted fw-bold mb-2">
                                <i class="bi bi-calendar2-range me-1 text-success"></i> ช่วงเวลาคอร์ทที่เลือก:
                            </label>
                            <div id="modalSelectedSlotsList" class="d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                                <!-- Dynamic List -->
                            </div>
                        </div>

                        <!-- Cart Products / Equipment -->
                        <div class="p-3 bg-white rounded-4 border mb-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="small text-muted fw-bold mb-0">
                                    <i class="bi bi-box-seam me-1 text-teal"></i> สินค้าและอุปกรณ์เช่าในบิลนี้:
                                </label>
                                <a href="@Url.Action("Customer", "Home", new { section = "product" })" class="small fw-semibold text-teal" style="color:#0d9488; text-decoration:none;" onclick="window.location.assign(this.href); return false;">
                                    + เลือกสินค้าเพิ่ม
                                </a>
                            </div>
                            <div id="modalCartItemsList" class="d-flex flex-column gap-2" style="max-height: 180px; overflow-y: auto;">
                                <!-- Dynamic Cart Items -->
                            </div>
                        </div>

                        <!-- สรุปยอดเงิน & ส่วนลดโปรโมชั่นอัตโนมัติ -->
                        <div class="bg-white rounded-4 border p-3 shadow-sm">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-receipt me-1 text-success"></i>สรุปยอดเงินและส่วนลด</h6>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">รวมค่าเช่าคอร์ท</span>
                                <span class="fw-bold" id="modalCourtTotal">0 ฿</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">รวมค่าซื้อสินค้า</span>
                                <span class="fw-bold" id="modalSaleTotal">0 ฿</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1 small">
                                <span class="text-muted">รวมค่าเช่าอุปกรณ์</span>
                                <span class="fw-bold" id="modalRentalTotal">0 ฿</span>
                            </div>

                            <!-- Auto Promotion Badges List -->
                            <div id="appliedPromoList" class="mt-2 mb-2 pt-2 border-top" style="display:none;">
                                <small class="text-muted fw-bold d-block mb-1">🎁 โปรโมชั่นที่ระบบคำนวณให้อัตโนมัติ:</small>
                                <div id="promoTagsContainer" class="d-flex flex-column gap-1"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-success fw-bold pt-2 border-top" id="promoDiscountRow" style="display:none !important;">
                                <span>ส่วนลดรวมทั้งหมด</span>
                                <span id="modalDiscount">-0 ฿</span>
                            </div>

                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold fs-6">ยอดชำระสุทธิ</span>
                                    <small class="text-muted d-block" style="font-size:0.75rem;">(รวมภาษีมูลค่าเพิ่มแล้ว)</small>
                                </div>
                                <span class="fw-bold text-success fs-3" id="modalFinalPrice">0 ฿</span>
                            </div>

                            <div class="small text-success mt-2"><i class="bi bi-check-circle me-1"></i>ระบบใช้โปรโมชั่นที่เข้าเงื่อนไขให้อัตโนมัติ</div>
                        </div>
                    </div>

                    <!-- ข้อมูลผู้จอง & ชำระเงิน & แนบสลิป -->
                    <div class="col-lg-5">
                        <div class="bg-white rounded-4 border p-3 mb-3 shadow-sm">
                            <h6 class="fw-bold text-success mb-3"><i class="bi bi-person me-1"></i>ข้อมูลผู้จอง</h6>
                            <div class="mb-2">
                                <label class="small text-muted">ชื่อ-นามสกุล <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="custName" value="@(string.IsNullOrEmpty(currentUserName) ? "คุณลูกค้า CourtBook" : currentUserName)" required>
                            </div>
                            <div class="mb-2">
                                <label class="small text-muted">เบอร์โทรศัพท์ <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control form-control-sm" id="custPhone" placeholder="08x-xxx-xxxx" value="@(string.IsNullOrEmpty(currentUserPhone) ? "" : currentUserPhone)" required>
                            </div>
                        </div>

                        <!-- การชำระเงินแบบ PromptPay QR & อัปโหลดสลิป -->
                        <div class="bg-white rounded-4 border p-3 text-center shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-qr-code-scan me-1 text-success"></i>สแกนชำระผ่าน PromptPay QR</h6>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success small">พร้อมเพย์</span>
                            </div>

                            <div class="p-2 bg-light rounded border d-inline-block my-2 shadow-sm text-center">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=PROMPTPAY-COURTBOOK-PHAYATHAI"
                                     alt="PromptPay QR Code" class="img-fluid" style="width:130px; height:130px;" />
                                <div class="mt-1 small fw-bold text-dark" id="qrPromptPayAmount">ยอดชำระ: 0 ฿</div>
                            </div>
                            <div class="small text-muted mb-3" style="font-size:0.8rem;">
                                ธนาคารกสิกรไทย • บัญชี CourtBook Arena • สาขาพญาไท
                            </div>

                            <!-- ส่วนอัปโหลดสลิปโอนเงิน (พร้อม Live Image Preview) -->
                            <div class="text-start p-3 rounded-3 border" style="background:#f8fafc;">
                                <label class="fw-bold text-dark small mb-1">
                                    <i class="bi bi-upload me-1 text-primary"></i> แนบสลิปการโอนเงิน (Slip Upload) <span class="text-danger">*</span>
                                </label>
                                <small class="text-muted d-block mb-2" style="font-size:0.75rem;">
                                    รองรับไฟล์รูปภาพ .JPG, .PNG เพื่อส่งให้ฝ่ายบัญชีตรวจสอบและอนุมัติคิว
                                </small>
                                <input type="file" class="form-control form-control-sm mb-2" id="slipUploadInput" accept="image/*" onchange="previewSlipImage(this)">

                                <!-- Image Preview Box -->
