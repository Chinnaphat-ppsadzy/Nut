@model Chinnaphat_8272_L005.Models.Receipt
@{
    Layout = null;
    bool isTaxInvoice = Model.DocType == "TAX_INVOICE";
    string docTitle = isTaxInvoice ? "ใบกำกับภาษี / ใบเสร็จรับเงิน" : "ใบเสร็จรับเงิน";
    string docTitleEn = isTaxInvoice ? "TAX INVOICE / RECEIPT" : "OFFICIAL RECEIPT";
    decimal netTotal = Model.Amount + Model.VatAmount;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.ReceiptNo - @docTitle (CourtBook Arena)</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Font: Sarabun -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Sarabun', sans-serif;
            box-sizing: border-box;
        }

        body {
            background-color: #f1f5f9;
            color: #1e293b;
            font-size: 14px;
            margin: 0;
            padding: 20px 0;
        }

        .receipt-container {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px 48px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
        }

        .doc-header-border {
            border-bottom: 2px solid #2d6a4f;
            padding-bottom: 16px;
            margin-bottom: 24px;
        }

        .company-logo {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 100%);
            color: #ffffff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 10px rgba(45, 106, 79, 0.25);
        }

        .badge-doc-type {
            background-color: #e8f5e9;
            color: #1a472a;
            border: 1px solid #a3cfbb;
            font-size: 13px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 8px;
            display: inline-block;
        }

        .info-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px 18px;
        }

        .table-items {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .table-items th {
            background-color: #f1f5f9;
            color: #1a472a;
            font-weight: 700;
            padding: 10px 12px;
            font-size: 13px;
            border-bottom: 2px solid #cbd5e1;
            text-align: left;
        }

        .table-items td {
            padding: 10px 12px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 13.5px;
            vertical-align: middle;
        }

        .signature-box {
            border-top: 1px dashed #94a3b8;
            padding-top: 8px;
            text-align: center;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        /* Action bar */
        .action-bar {
            max-width: 820px;
            margin: 0 auto 16px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .action-bar {
                display: none !important;
            }
            .receipt-container {
                box-shadow: none;
                border: none;
                padding: 15px 20px;
                max-width: 100%;
            }
            @@page {
                size: A4;
                margin: 15mm;
            }
        }
    </style>
</head>
<body>

    <!-- Top Action Bar (hidden in print) -->
    <div class="action-bar">
        <div class="d-flex align-items-center gap-2">
            <a href="javascript:window.close();" class="btn btn-outline-secondary btn-sm px-3 shadow-sm" style="border-radius:8px;">
                <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ / ปิดหน้า
            </a>
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i> เอกสารพร้อมพิมพ์หรือบันทึกเป็น PDF (A4)
            </span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-success fw-bold px-4 py-2 shadow-sm" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 100%); border:none; border-radius:8px;">
                <i class="bi bi-printer-fill me-1"></i> สั่งพิมพ์เอกสาร (Print)
            </button>
        </div>
    </div>

    <!-- Main Receipt Document Container -->
    <div class="receipt-container">

        <!-- Header: Company & Doc Title -->
        <div class="doc-header-border">
            <div class="d-flex justify-content-between align-items-start">
                <!-- Company Info -->
                <div class="d-flex align-items-start gap-3">
                    <div class="company-logo">
                        <i class="bi bi-dribbble"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1" style="color:#1a472a; letter-spacing:-0.3px;">CourtBook Badminton Arena</h4>
                        <div class="text-muted small">บริษัท คอร์ทบุ๊ค สปอร์ต อารีน่า จำกัด (สำนักงานใหญ่)</div>
                        <div class="text-muted small">123/45 ถนนพุทธมณฑล สาย 4 ต.ศาลายา อ.พุทธมณฑล จ.นครปฐม 73170</div>
                        <div class="text-muted small">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong> 0-1055-62098-76-5 &nbsp;|&nbsp; <strong>โทร:</strong> 02-123-4567
                        </div>
                    </div>
                </div>

                <!-- Document Title & Badge -->
                <div class="text-end">
                    <div class="badge-doc-type mb-1">ต้นฉบับ (ORIGINAL)</div>
                    <h5 class="fw-bold mb-0 text-dark">@docTitle</h5>
                    <div class="text-muted small font-monospace">@docTitleEn</div>
                </div>
            </div>
        </div>

        <!-- Info Grid (Doc Meta & Customer Info) -->
        <div class="row g-3 mb-3">
            <!-- Customer Info -->
            <div class="col-7">
                <div class="info-box h-100">
                    <div class="text-muted small fw-bold mb-1 text-uppercase" style="letter-spacing:0.5px;">ข้อมูลลูกค้า / ผู้รับบริการ</div>
                    <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
                    
                    @if (!string.IsNullOrEmpty(Model.TaxId))
                    {
                        <div class="small text-secondary mt-1">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong> <span class="font-monospace">@Model.TaxId</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <div class="small text-secondary mt-1">
                            <strong>ที่อยู่:</strong> @Model.Address
                        </div>
                    }

                    @if (Model.Booking?.User != null && !string.IsNullOrEmpty(Model.Booking.User.Phone))
                    {
                        <div class="small text-secondary mt-1">
                            <strong>เบอร์โทรศัพท์:</strong> @Model.Booking.User.Phone
                        </div>
                    }
                </div>
            </div>

            <!-- Doc Meta Info -->
            <div class="col-5">
                <div class="info-box h-100">
                    <div class="text-muted small fw-bold mb-2 text-uppercase" style="letter-spacing:0.5px;">รายละเอียดเอกสาร</div>
                    <table class="w-100 small">
                        <tr>
                            <td class="text-muted py-1" style="width:110px;">เลขที่เอกสาร:</td>
                            <td class="fw-bold font-monospace text-dark py-1">@Model.ReceiptNo</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">วันที่ออก:</td>
                            <td class="text-dark py-1">@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm") น.</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">รหัสการจอง:</td>
                            <td class="font-monospace text-primary fw-semibold py-1">@(Model.Booking?.BookingCode ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-1">วันที่ใช้บริการ:</td>
                            <td class="text-dark py-1">@(Model.Booking?.PlayDate.ToString("dd/MM/yyyy") ?? "-")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="mb-3">
            <table class="table-items">
                <thead>
                    <tr>
                        <th style="width: 45px;" class="text-center">#</th>
                        <th>รายการสินค้า / บริการ (Description)</th>
                        <th style="width: 80px;" class="text-center">จำนวน</th>
                        <th style="width: 120px;" class="text-end">ราคา/หน่วย</th>
                        <th style="width: 130px;" class="text-end">จำนวนเงิน (฿)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int itemIndex = 1;
                    }

                    <!-- 1. Court Booking Slots -->
                    @if (Model.Booking?.BookingSlots != null && Model.Booking.BookingSlots.Any())
                    {
                        foreach (var slot in Model.Booking.BookingSlots)
                        {
                            <tr>
                                <td class="text-center text-muted">@itemIndex</td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        ค่าบริการสนามแบดมินตัน - @(slot.Court?.CourtName ?? "คอร์ทแบดมินตัน")
                                    </div>
                                    <small class="text-muted">
                                        รอบเวลา: @(slot.Slot?.StartTime.ToString(@"hh\:mm") ?? "00:00") - @(slot.Slot?.EndTime.ToString(@"hh\:mm") ?? "00:00") น.
                                    </small>
                                </td>
                                <td class="text-center">1 คอร์ท</td>
                                <td class="text-end font-monospace">@slot.Price.ToString("N2")</td>
                                <td class="text-end fw-bold font-monospace">@slot.Price.ToString("N2")</td>
                            </tr>
                            itemIndex++;
                        }
                    }

                    <!-- 2. Booking Items (Merchandise / Rentals) -->
                    @if (Model.Booking?.BookingItems != null && Model.Booking.BookingItems.Any())
                    {
                        foreach (var item in Model.Booking.BookingItems)
                        {
                            string itemCategory = item.ItemType == "RENTAL" ? "เช่าอุปกรณ์" : "สินค้า";
                            <tr>
                                <td class="text-center text-muted">@itemIndex</td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @(item.Product?.ProductName ?? "สินค้า/อุปกรณ์")
                                    </div>
                                    <small class="text-muted">
                                        ประเภท: [@itemCategory]
                                    </small>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end font-monospace">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold font-monospace">@item.LineTotal.ToString("N2")</td>
                            </tr>
                            itemIndex++;
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Calculation & Summary -->
        <div class="row g-3 mb-4">
            <!-- Left: Payment Notes & Baht text placeholder -->
            <div class="col-7">
                <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="small fw-bold text-dark mb-1">
                            <i class="bi bi-credit-card-2-front text-success me-1"></i> วิธีการชำระเงิน:
                        </div>
                        <div class="small text-secondary mb-2">
                            โอนเงินผ่านระบบธนาคาร / พร้อมเพย์ QR Payment (ตรวจสอบและอนุมัติแล้ว)
                        </div>
                        <div class="small text-muted">
                            <em>* เอกสารนี้ออกโดยระบบอัตโนมัติของ CourtBook Badminton Arena</em>
                        </div>
                    </div>
                    <div class="pt-2 border-top mt-2">
                        <small class="text-dark fw-bold">
                            สถานะ: <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>ชำระเงินเรียบร้อย (PAID)</span>
                        </small>
                    </div>
                </div>
            </div>

            <!-- Right: Subtotal, VAT, Total -->
            <div class="col-5">
                <table class="w-100 small">
                    @if (Model.Booking != null && Model.Booking.DiscountAmount > 0)
                    {
                        <tr>
                            <td class="text-muted py-1">ส่วนลดโปรโมชั่น:</td>
                            <td class="text-end text-danger py-1 font-monospace">-@Model.Booking.DiscountAmount.ToString("N2") ฿</td>
                        </tr>
                    }
                    <tr>
                        <td class="text-muted py-1">มูลค่ารวมก่อนภาษี:</td>
                        <td class="text-end text-dark py-1 font-monospace">@Model.Amount.ToString("N2") ฿</td>
                    </tr>
                    <tr>
                        <td class="text-muted py-1">ภาษีมูลค่าเพิ่ม 7% (VAT):</td>
                        <td class="text-end text-dark py-1 font-monospace">@Model.VatAmount.ToString("N2") ฿</td>
                    </tr>
                    <tr class="border-top border-bottom border-dark">
                        <td class="fw-bold fs-6 py-2" style="color:#1a472a;">จำนวนเงินรวมทั้งสิ้น:</td>
                        <td class="text-end fw-bold fs-5 py-2 font-monospace" style="color:#1a472a;">@netTotal.ToString("N2") ฿</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Signatures Block -->
        <div class="row g-4 pt-3">
            <div class="col-6">
                <div class="signature-box">
                    <div class="fw-bold text-dark small">(@(Model.Booking?.User?.FullName ?? Model.CustomerName))</div>
                    <div class="text-muted small">ผู้รับบริการ / ลูกค้า</div>
                </div>
            </div>
            <div class="col-6">
                <div class="signature-box">
                    <div class="fw-bold text-dark small">(@(Model.IssuedByNavigation?.FullName ?? "ฝ่ายบัญชีและการเงิน"))</div>
                    <div class="text-muted small">ผู้รับเงิน / เจ้าหน้าที่การเงิน CourtBook</div>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
