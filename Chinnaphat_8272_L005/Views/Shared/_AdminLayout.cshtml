<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CourtBook Admin</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

</head>
<body class="bg-light">


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-dark bg-success shadow-sm">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold"
               asp-action="Admin" asp-controller="Home">

                <i class="bi bi-dribbble me-2"></i>

                CourtBook Admin

            </a>


            <div class="d-flex align-items-center text-white">

                <i class="bi bi-person-circle fs-4 me-2"></i>

                <div>

                    <div class="fw-semibold">
                        Admin
                    </div>

                    <small>
                        ผู้ดูแลระบบ
                    </small>

                </div>

            </div>

        </div>

    </nav>



    <!-- ================= MAIN ================= -->

    <div class="container-fluid">

        <div class="row">


            <!-- ================= SIDEBAR ================= -->

            <aside class="col-md-3 col-lg-2 bg-white border-end min-vh-100 p-3">


                <div class="text-secondary small fw-bold mb-3">

                    เมนูหลัก

                </div>


                <!-- Dashboard -->

                <a asp-action="Admin" asp-controller="Home"
                   class="btn btn-success w-100 text-start mb-2">

                    <i class="bi bi-speedometer2 me-2"></i>

                    Dashboard

                </a>


                <!-- Court -->

                <a href="/Admin/Court"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-building me-2"></i>

                    จัดการสนาม

                </a>


                <!-- Promotion -->

                <a href="/Admin/Promotion"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-ticket-perforated me-2"></i>

                    โปรโมชั่น

                </a>


                <!-- Product -->

                <a href="/Admin/Product"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-box-seam me-2"></i>

                    สินค้า

                </a>



                <hr />


                <div class="text-secondary small fw-bold mb-3">

                    จัดการบุคลากร

                </div>


                <!-- Employee -->

                <a asp-action="UserList" asp-controller="User"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-people me-2"></i>

                    รายชื่อผู้ใช้

                </a>


                <!-- AddUser -->

                <a asp-action="AddUser" asp-controller="User"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-person-plus me-2"></i>

                    เพิ่มผู้ใช้

                </a>



                <hr />


                <!-- Logout -->

                <a asp-action="Login" asp-controller="User"
                   class="btn btn-outline-danger w-100 text-start">

                    <i class="bi bi-box-arrow-right me-2"></i>

                    ออกจากระบบ

                </a>


            </aside>



            <!-- ================= CONTENT ================= -->

            <main class="col-md-9 col-lg-10 p-4">


                <!-- Page Header -->

                <div class="d-flex justify-content-between
                            align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            @ViewData["Title"]

                        </h2>

                        <p class="text-muted mb-0">

                            ระบบจัดการสนามกีฬาออนไลน์

                        </p>

                    </div>


                    <div>

                        <button class="btn btn-outline-success">

                            <i class="bi bi-bell"></i>

                        </button>

                    </div>

                </div>



                <!-- Page Content -->

                @RenderBody()


            </main>


        </div>

    </div>



    <!-- ================= FOOTER ================= -->

    <footer class="bg-white border-top text-center text-muted py-2">

        <small>

            © 2026 CourtBook
            | ระบบจองสนามกีฬาออนไลน์

        </small>

    </footer>
    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
