@using Chinnaphat_8272_L005.Models
@{ Layout = "_SalesStaffLayout"; ViewData["Title"] = "ตรวจรับสินค้าคืน"; var rows = ViewBag.RefundRequests as List<BookingRefundRequest> ?? new(); var allRows = ViewBag.AllBookingRefundRequests as List<BookingRefundRequest> ?? new(); var posOptions = ViewBag.PosReturnOptions as List<Chinnaphat_8272_L005.Controllers.PosSaleProductRefundOption> ?? new(); }
<h3 class="fw-bold mb-2"><i class="bi bi-arrow-counterclockwise text-success me-2"></i>ตรวจรับสินค้าคืนและส่งบัญชี</h3>
<p class="text-muted mb-3">หน้านี้ใช้ตรวจรับสินค้าที่ลูกค้าส่งคืนเท่านั้น เมื่อยืนยันแล้วคำขอจะไปแสดงที่ฝ่ายบัญชี &gt; คิดค่าปรับ &amp; จัดการคืนเงิน &gt; จัดการคืนเงินลูกค้า</p>
@if (TempData["SuccessMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="card-header bg-white fw-bold">คำขอคืนสินค้าจากสมาชิกที่รอตรวจฝ่ายขาย (@rows.Count)</div>
@if (rows.Count == 0) { <div class="p-5 text-center text-muted">ไม่มีคำขอรอตรวจ</div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>บิล/ลูกค้า</th><th>สินค้าที่คืน</th><th>ยอดคืนสินค้า</th><th>เหตุผลลูกค้า</th><th>ตรวจรับ/ส่งบัญชี</th></tr></thead><tbody>
@foreach (var r in rows) { <tr><td><strong>@r.ReferenceCode</strong><br />@r.CustomerName<br /><small>@r.CustomerPhone</small></td><td><strong>@r.ProductName</strong><br/><small>จำนวน @r.ProductQuantity · @r.ServiceDate.ToString("dd/MM/yyyy")</small></td><td class="text-success fw-bold">@r.Amount.ToString("N2") ฿</td><td>@r.Reason</td><td><form asp-action="ReviewBookingRefund" method="post" class="d-flex flex-column gap-2">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.RequestId"/><input name="salesNote" class="form-control form-control-sm" maxlength="500" placeholder="บันทึกผลตรวจ หรือเหตุผลที่ปฏิเสธ"/><button name="itemReturned" value="true" class="btn btn-sm btn-outline-success">รับคืนสินค้าและส่งบัญชี</button><button name="itemReturned" value="false" class="btn btn-sm btn-outline-danger">ปฏิเสธคำขอ</button></form></td></tr> }
</tbody></table></div> }</div>
<div class="card border-0 shadow-sm rounded-4 my-4"><div class="card-header bg-white fw-bold">รับคืนสินค้าจากลูกค้า Walk-in / POS</div><div class="card-body"><form asp-action="ReceivePosProductRefund" method="post" class="row g-3 align-items-end">@Html.AntiForgeryToken()<div class="col-lg-6"><label class="form-label">ใบเสร็จและสินค้า</label><select name="saleProductKey" class="form-select" required><option value="">เลือกรายการสินค้าที่ซื้อ</option>@foreach(var p in posOptions){<option value="@p.SaleId|@p.ProductId">@p.ReceiptCode · @p.CustomerName · @p.ProductName × @p.Quantity · คืน @p.Amount.ToString("N2") ฿</option>}</select></div><div class="col-lg-3"><label class="form-label">เหตุผลคืนสินค้า</label><input name="reason" class="form-control" maxlength="500" required /></div><div class="col-lg-2"><div class="form-check"><input name="itemReturned" value="true" type="checkbox" class="form-check-input" required/><label class="form-check-label">รับและตรวจสินค้าคืนแล้ว</label></div></div><div class="col-lg-1"><button class="btn btn-success">ส่งบัญชี</button></div></form><small class="text-muted">รายการเลือกได้เฉพาะสินค้าที่ขายผ่าน POS ไม่รวมค่าคอร์ท ค่าเช่า และเงินมัดจำอุปกรณ์</small></div></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-4"><div class="card-header bg-white fw-bold">ติดตามสถานะคำขอคืนสินค้า (@allRows.Count)</div>@if(allRows.Count == 0){<div class="p-4 text-center text-muted">ยังไม่มีคำขอ</div>}else{<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead class="table-light"><tr><th>รหัสอ้างอิง</th><th>ลูกค้า</th><th>สินค้า</th><th>เหตุผล</th><th>สถานะ</th><th>ผลตรวจ</th></tr></thead><tbody>@foreach(var r in allRows){<tr><td>@r.ReferenceCode</td><td>@r.CustomerName</td><td>@r.ProductName · @r.ProductQuantity</td><td>@r.Reason</td><td><span class="badge @(r.Status == "COMPLETED" ? "bg-success" : r.Status == "REJECTED" ? "bg-danger" : r.Status == "PENDING_ACCOUNTING" ? "bg-info text-dark" : "bg-warning text-dark")">@r.Status</span></td><td>@r.SalesNote @if(!string.IsNullOrWhiteSpace(r.AccountingNote)){<span> · บัญชี: @r.AccountingNote</span>}</td></tr>}</tbody></table></div>}</div>
