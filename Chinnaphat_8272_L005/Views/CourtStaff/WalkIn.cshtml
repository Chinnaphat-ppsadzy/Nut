@model List<Chinnaphat_8272_L005.Models.WalkInQueue>
@{
    Layout = "_CourtStaffLayout";
    ViewData["Title"] = "จัดการคิว Walk-in ประจำวัน";

    string selectedDateStr = ViewBag.SelectedDate as string ?? DateFormatHelper.ToIsoDate(DateTime.Today);
    var courts = ViewBag.Courts as List<Chinnaphat_8272_L005.Models.Court> ?? new();
    var timeSlots = ViewBag.TimeSlots as List<Chinnaphat_8272_L005.Models.TimeSlot> ?? new();
    decimal paidWalkInTotal = ViewBag.PaidWalkInTotal ?? 0m;
    int unpaidWalkInCount = ViewBag.UnpaidWalkInCount ?? 0;
    bool canIssueWalkIn = ViewBag.CanIssueWalkIn ?? true;

    string? queryCourtId = Context.Request.Query["courtId"];
    string? querySlotId = Context.Request.Query["slotId"];
}

<div class="row g-4">
    <!-- ================= FORM: ออกบัตรคิว WALK-IN ================= -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 text-white" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);">
                <h5 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-ticket-perforated-fill me-2 fs-4"></i>ออกบัตรคิว Walk-in หน้าร้าน
                </h5>
                <small class="text-white-50">สำหรับลูกค้าที่ไม่ได้จองออนไลน์ล่วงหน้า</small>
            </div>

            <div class="card-body p-4 bg-white">
                <form method="post" asp-action="AddWalkIn">
                    <fieldset disabled="@(!canIssueWalkIn)">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            ชื่อ-นามสกุล ลูกค้า <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input type="text" name="customerName" class="form-control" placeholder="เช่น คุณสมศักดิ์" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            เบอร์โทรศัพท์ติดต่อ
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input type="text" name="phone" class="form-control" placeholder="กรอกเบอร์โทรศัพท์ 10 หลัก" inputmode="numeric" autocomplete="tel-national" pattern="[0-9]{10}" minlength="10" maxlength="10" title="กรุณากรอกตัวเลข 10 หลัก" required oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            คอร์ทที่ต้องการ (ถ้ามี)
                        </label>
                        <select name="courtId" class="form-select">
                            <option value="">-- จัดคอร์ทว่างใดก็ได้ (Auto Assign) --</option>
                            @foreach (var c in courts)
                            {
                                <option value="@c.CourtId" disabled="@(c.Status != "AVAILABLE")" selected="@(queryCourtId == c.CourtId.ToString())">
                                    @c.CourtName (@c.PricePerHour.ToString("N0") ฿/ชม.)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">
                            ช่วงเวลาที่ต้องการเข้าเล่น
                        </label>
                        <select name="slotId" class="form-select">
                            <option value="">-- รอบถัดไปที่ว่างทันที (Next Available) --</option>
                            @foreach (var s in timeSlots)
                            {
                                <option value="@s.SlotId" selected="@(querySlotId == s.SlotId.ToString())">
                                    @s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm") น.
                                </option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius:10px; background:linear-gradient(135deg, #1a472a, #2d6a4f); border:none;">
                        <i class="bi bi-plus-circle me-1"></i> ออกบัตรคิว Walk-in
                    </button>
                    </fieldset>
                    @if (!canIssueWalkIn)
                    {
                        <div class="alert alert-info small mt-3 mb-0">ออกคิว Walk-in ได้เฉพาะวันที่ปัจจุบัน โปรดเลือกวันที่วันนี้ก่อน</div>
                    }
                </form>
            </div>
        </div>
    </div>

    <!-- ================= LIST: รายการคิว WALK-IN ประจำวัน ================= -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-card-list text-info me-2"></i>คิว Walk-in ประจำวันที่ @selectedDateStr
                    </h5>
                    <small class="text-muted">ทั้งหมด @Model.Count รายการ</small>
                    <div class="d-flex gap-2 flex-wrap mt-2">
                        <span class="badge bg-success-subtle text-success border">รับชำระแล้ว @paidWalkInTotal.ToString("N2") ฿</span>
                        <span class="badge bg-warning-subtle text-dark border">รอชำระ @unpaidWalkInCount คิว</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <form method="get" asp-action="WalkIn" class="d-flex gap-2">
                        <input type="date" name="date" class="form-control form-control-sm" value="@selectedDateStr" lang="th-TH" onchange="this.form.submit()" />
                    </form>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> ผังตารางคอร์ท
                    </a>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>ลำดับคิว</th>
                                <th>ชื่อลูกค้า</th>
                                <th>เบอร์โทร</th>
                                <th>คอร์ท & เวลา</th>
                                <th class="text-end">ค่าคอร์ท</th>
                                <th>เวลาออกคิว</th>
                                <th>การชำระ</th>
                                <th>สถานะ</th>
                                <th class="text-end">การจัดการคิว</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr id="walkin-row-@q.QueueId">
                                    <td>
                                        <span class="badge bg-dark font-monospace fs-6 px-3 py-2">
                                            W-@q.QueueNo.ToString("D2")
                                        </span>
                                    </td>
                                    <td>
                                        <strong class="text-dark">@q.CustomerName</strong>
                                    </td>
                                    <td>
                                        <span class="small text-muted"><i class="bi bi-telephone me-1"></i>@(q.Phone ?? "-")</span>
                                    </td>
                                    <td>
                                        @if (q.Court != null)
                                        {
                                            <span class="badge bg-secondary me-1">@q.Court.CourtName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border me-1">คอร์ทใดก็ได้</span>
                                        }

                                        @if (q.Slot != null)
                                        {
                                            <span class="small text-muted">@q.Slot.StartTime.ToString("HH:mm") - @q.Slot.EndTime.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">รอบที่ว่าง</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (q.CourtFee > 0) { <strong>@q.CourtFee.ToString("N2") ฿</strong> }
                                        else { <span class="text-muted">รอจัดคอร์ท</span> }
                                    </td>
                                    <td><small class="text-muted">@q.CreatedAt.ToString("HH:mm:ss น.")</small></td>
                                    <td id="walkin-payment-status-@q.QueueId">
                                        @if (q.PaymentStatus == "PAID")
                                        {
                                            <span class="badge bg-success">ชำระแล้ว</span>
                                            <small class="d-block text-muted">สแกน QR · บัญชีตรวจแล้ว</small>
                                        }
                                        else if (q.PaymentStatus == "PENDING_VERIFY")
                                        {
                                            <span class="badge bg-info text-dark">รอฝ่ายบัญชีตรวจสลิป</span>
                                        }
                                        else if (q.Status == "ASSIGNED")
                                        {
                                            <span class="badge @(q.PaymentStatus == "REJECTED" ? "bg-danger" : "bg-warning text-dark")">@(q.PaymentStatus == "REJECTED" ? "สลิปไม่ผ่าน · รอส่งใหม่" : "รอสแกนชำระ")</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td>
                                        @switch (q.Status?.ToUpper())
                                        {
                                            case "ASSIGNED":
                                                <span class="badge bg-info text-dark px-2 py-1">
                                                    <i class="bi bi-grid-3x3-gap me-1"></i> จัดคอร์ทแล้ว
                                                </span>
                                                break;
                                            case "DONE":
                                                <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>เสร็จสิ้น</span>
                                                break;
                                            case "CANCELLED":
                                                <span class="badge bg-secondary px-2 py-1">
                                                    <i class="bi bi-x-circle me-1"></i> ยกเลิก
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-primary px-2 py-1">
                                                    <i class="bi bi-hourglass-split me-1"></i> รอจัดคอร์ท
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end" id="walkin-payment-action-@q.QueueId">
                                        @if (q.Status == "WAITING")
                                        {
                                            <button type="button" class="btn btn-sm btn-success px-2" onclick="updateQueueStatus(@q.QueueId, 'ASSIGNED')" title="จัดคอร์ทว่างและคำนวณค่าบริการ">
                                                <i class="bi bi-check-lg"></i> จัดคอร์ทว่าง
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2" onclick="updateQueueStatus(@q.QueueId, 'CANCELLED')" title="ยกเลิกคิว">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }
                                        else if (q.Status == "ASSIGNED" && q.PaymentStatus == "PENDING_VERIFY")
                                        {
                                            <span class="small text-info fw-semibold"><i class="bi bi-hourglass-split me-1"></i>ส่งบัญชีแล้ว</span>
                                        }
                                        else if (q.Status == "ASSIGNED" && q.PaymentStatus != "PAID")
                                        {
                                            <button type="button" class="btn btn-sm btn-success px-2" onclick="openWalkInPayment(@q.QueueId, '@q.QueueNo.ToString("D2")', '@q.CourtFee.ToString(System.Globalization.CultureInfo.InvariantCulture)')">
                                                <i class="bi bi-qr-code-scan me-1"></i>สแกน QR / แนบสลิป
                                            </button>
                                        }
                                        else if (q.Status == "ASSIGNED" && q.PaymentStatus == "PAID")
                                        {
                                            <button type="button" class="btn btn-sm btn-success px-2" onclick="updateQueueStatus(@q.QueueId, 'DONE')">
                                                <i class="bi bi-check-circle me-1"></i>ปิดคิว
                                            </button>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                    <h6>ยังไม่มีคิว Walk-in ในวันนี้</h6>
                    <small>กดออกบัตรคิวที่แบบฟอร์มด้านซ้ายเมื่อมีลูกค้าติดต่อหน้าร้าน</small>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="walkInPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#1a472a,#2d6a4f);">
                <div>
                    <h5 class="modal-title fw-bold"><i class="bi bi-qr-code me-2"></i>ชำระ Walk-in ด้วย QR</h5>
                    <small class="text-white-50">คิว W-<span id="walkInPaymentQueueNo">-</span></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-md-5 text-center">
                        <img src="~/images/walkin-promptpay-qr.png" alt="PromptPay QR" class="img-fluid border rounded-3 shadow-sm" style="max-height:360px;" />
                        <div class="fw-bold text-success fs-5 mt-2">ยอดชำระ <span id="walkInPaymentAmount">0.00</span> บาท</div>
                    </div>
                    <div class="col-md-7">
                        <ol class="small text-secondary ps-3">
                            <li>ให้ลูกค้าสแกน QR และโอนตามยอดที่แสดง</li>
                            <li>ถ่ายรูปหรือเลือกภาพสลิปจากอุปกรณ์</li>
                            <li>ส่งสลิปให้ฝ่ายบัญชีตรวจสอบก่อนยืนยันการชำระ</li>
                        </ol>
                        <label for="walkInSlipFile" class="form-label fw-bold">แนบรูปสลิป <span class="text-danger">*</span></label>
                        <input type="file" id="walkInSlipFile" class="form-control" accept="image/jpeg,image/png,image/webp" capture="environment" required />
                        <small class="text-muted d-block mt-2">รองรับ JPG, PNG, WEBP ขนาดไม่เกิน 5 MB</small>
                        <div id="walkInSlipPreviewWrap" class="d-none mt-3 text-center">
                            <img id="walkInSlipPreview" alt="ตัวอย่างสลิป" class="img-fluid rounded border" style="max-height:220px;" />
                        </div>
                    </div>
                </div>
                <input type="hidden" id="walkInPaymentQueueId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-success fw-bold" id="btnUploadWalkInSlip" onclick="uploadWalkInSlip()"><i class="bi bi-cloud-upload me-1"></i>ส่งสลิปให้บัญชี</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="walkInTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
    <script>
        async function postWalkIn(url, values, confirmText) {
            if (confirmText && !confirm(confirmText)) return;
            const token = document.querySelector('#walkInTokenForm input[name="__RequestVerificationToken"]')?.value || '';
            const body = new URLSearchParams({ ...values, __RequestVerificationToken: token });
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body
                });
                const data = await response.json();
                alert(data.message || (data.success ? 'บันทึกสำเร็จ' : 'ทำรายการไม่สำเร็จ'));
                if (data.success) window.location.reload();
            } catch {
                alert('เชื่อมต่อระบบไม่ได้ กรุณาลองใหม่');
            }
        }

        function updateQueueStatus(queueId, status) {
            const message = status === 'ASSIGNED'
                ? 'ให้ระบบจัดคอร์ทว่างและรอบถัดไปให้ พร้อมคำนวณค่าบริการหรือไม่?'
                : status === 'DONE' ? 'ยืนยันว่าลูกค้าใช้บริการเสร็จแล้วหรือไม่?' : 'ยืนยันยกเลิกคิวนี้หรือไม่?';
            postWalkIn('/CourtStaff/UpdateQueueStatus', { queueId, status }, message);
        }

        function openWalkInPayment(queueId, queueNo, amount) {
            document.getElementById('walkInPaymentQueueId').value = queueId;
            document.getElementById('walkInPaymentQueueNo').textContent = queueNo;
            document.getElementById('walkInPaymentAmount').textContent = Number(amount).toLocaleString('th-TH', { minimumFractionDigits: 2 });
            document.getElementById('walkInSlipFile').value = '';
            document.getElementById('walkInSlipPreviewWrap').classList.add('d-none');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('walkInPaymentModal')).show();
        }

        document.getElementById('walkInSlipFile')?.addEventListener('change', function () {
            const file = this.files?.[0];
            const wrap = document.getElementById('walkInSlipPreviewWrap');
            if (!file) { wrap.classList.add('d-none'); return; }
            if (file.size > 5 * 1024 * 1024) {
                alert('ไฟล์สลิปต้องมีขนาดไม่เกิน 5 MB');
                this.value = '';
                wrap.classList.add('d-none');
                return;
            }
            document.getElementById('walkInSlipPreview').src = URL.createObjectURL(file);
            wrap.classList.remove('d-none');
        });

        async function uploadWalkInSlip() {
            const fileInput = document.getElementById('walkInSlipFile');
            if (!fileInput.files?.length) { alert('กรุณาถ่ายรูปหรือเลือกภาพสลิปก่อนส่ง'); return; }
            const token = document.querySelector('#walkInTokenForm input[name="__RequestVerificationToken"]')?.value || '';
            const form = new FormData();
            form.append('queueId', document.getElementById('walkInPaymentQueueId').value);
            form.append('slipFile', fileInput.files[0]);
            form.append('__RequestVerificationToken', token);
            const button = document.getElementById('btnUploadWalkInSlip');
            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังส่งสลิป...';
            try {
                const response = await fetch('/CourtStaff/UploadWalkInSlip', { method: 'POST', body: form });
                const data = await response.json();
                if (!data.success) {
                    alert(data.message || 'ส่งสลิปไม่สำเร็จ');
                    return;
                }

                const queueId = document.getElementById('walkInPaymentQueueId').value;
                document.getElementById(`walkin-payment-status-${queueId}`).innerHTML = '<span class="badge bg-info text-dark">รอฝ่ายบัญชีตรวจสลิป</span>';
                document.getElementById(`walkin-payment-action-${queueId}`).innerHTML = '<span class="small text-info fw-semibold"><i class="bi bi-hourglass-split me-1"></i>ส่งบัญชีแล้ว</span>';
                bootstrap.Modal.getInstance(document.getElementById('walkInPaymentModal'))?.hide();
                alert(data.message || 'ส่งสลิปให้ฝ่ายบัญชีแล้ว');
            } catch {
                alert('เชื่อมต่อระบบไม่ได้ กรุณาลองใหม่');
            } finally {
                button.disabled = false;
                button.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>ส่งสลิปให้บัญชี';
            }
        }
    </script>
}
