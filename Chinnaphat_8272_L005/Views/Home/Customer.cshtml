                    <button type="button" class="btn btn-success px-4 py-2 fw-bold shadow-sm" id="btnSubmitBooking" style="border-radius:10px; background:linear-gradient(135deg,#1a472a,#2d6a4f); border:none;" onclick="submitBookingWithSlip()">
