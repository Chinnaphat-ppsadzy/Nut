<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CourtBook Admin</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Google Fonts: Sarabun (ฟอนต์ภาษาไทย) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
          rel="stylesheet">

    <style>
        * { font-family: 'Sarabun', sans-serif; }
        body { font-size: 1rem; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Sarabun', sans-serif; font-weight: 700; }
        .navbar, .btn, .form-control, .form-select, .badge, .alert, .table {
            font-family: 'Sarabun', sans-serif;
        }
        small, .small { font-size: 0.85rem; }
    </style>

</head>
<body class="bg-light">


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-dark bg-success shadow-sm">

        <div class="container-fluid">

            <div class="d-flex align-items-center">
                <a class="navbar-brand fw-bold mb-0"
                   asp-action="Admin" asp-controller="Home">
                    <i class="bi bi-shield-check me-2"></i>
                    CourtBook Admin
                </a>
                <span class="badge bg-warning text-dark font-monospace d-none d-sm-inline-block">ระบบหลังบ้าน (ADMIN)</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-action="Customer" asp-controller="Home" class="btn btn-sm btn-light fw-bold text-success shadow-sm">
                    <i class="bi bi-shop me-1"></i> หน้าระบบลูกค้า
                </a>

                <div class="d-flex align-items-center text-white border-start ps-3">
                    <i class="bi bi-person-circle fs-4 me-2"></i>
                    <div>
                        <div class="fw-semibold lh-1">Admin</div>
                        <small class="text-white-50" style="font-size:0.75rem;">ผู้ดูแลระบบ</small>
                    </div>
                </div>
            </div>

        </div>

    </nav>



    <!-- ================= MAIN ================= -->

    <div class="container-fluid">

        <div class="row">


            <!-- ================= SIDEBAR ================= -->

            <aside class="col-md-3 col-lg-2 bg-white border-end min-vh-100 p-3">


                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-shield-lock me-1 text-success"></i>เมนูจัดการระบบหลังบ้าน (Admin)
                </div>

                @{
                    string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }

                <!-- Dashboard -->
                <a asp-action="Admin" asp-controller="Home"
                   class="btn @((currentCtrl == "Home" && currentAct == "Admin") || (currentCtrl == "Admin" && (currentAct == "Dashboard" || currentAct == "Index")) ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard ภาพรวม
                </a>

                <!-- Court -->
                <a asp-action="Court" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Court" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-building me-2"></i>
                    จัดการสนาม
                </a>

                <!-- Promotion -->
                <a asp-action="Promotion" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Promotion" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-ticket-perforated me-2"></i>
                    จัดการโปรโมชั่น (5 แบบ)
                </a>

                <!-- Product -->
                <a asp-action="Product" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Product" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-box-seam me-2"></i>
                    สินค้าและอุปกรณ์
                </a>

                <hr />

                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-people me-1 text-primary"></i>จัดการบุคลากร
                </div>

                <!-- Employee -->
                <a asp-action="UserList" asp-controller="User"
                   class="btn @(currentCtrl == "User" && currentAct == "UserList" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-people me-2"></i>
                    รายชื่อผู้ใช้
                </a>

                <!-- AddUser -->
                <a asp-action="AddUser" asp-controller="User"
                   class="btn @(currentCtrl == "User" && currentAct == "AddUser" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-person-plus me-2"></i>
                    เพิ่มผู้ใช้
                </a>

                <hr />

                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-arrow-left-right me-1 text-info"></i>สลับไปยังหน้าลูกค้า
                </div>

                <!-- Switch to Customer Portal -->
                <a asp-action="Customer" asp-controller="Home"
                   class="btn btn-outline-success w-100 text-start mb-2">
                    <i class="bi bi-shop me-2"></i>
                    หน้าระบบลูกค้า (Customer)
                </a>

                <a asp-action="Index" asp-controller="Home"
                   class="btn btn-light w-100 text-start mb-2 text-muted">
                    <i class="bi bi-house me-2"></i>
                    หน้าแรก (Hub)
                </a>

                <hr />

                <!-- Logout -->
                <a asp-action="Login" asp-controller="User"
                   class="btn btn-outline-danger w-100 text-start">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    ออกจากระบบ
                </a>


            </aside>



            <!-- ================= CONTENT ================= -->

            <main class="col-md-9 col-lg-10 p-4">


                <!-- Page Header -->

                <div class="d-flex justify-content-between
                            align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            @ViewData["Title"]

                        </h2>

                        <p class="text-muted mb-0">

                            ระบบจัดการสนามกีฬาออนไลน์

                        </p>

                    </div>


                    <div>

                        <button class="btn btn-outline-success">

                            <i class="bi bi-bell"></i>

                        </button>

                    </div>

                </div>



                <!-- Page Content -->

                @RenderBody()


            </main>


        </div>

    </div>



    <!-- ================= FOOTER ================= -->

    <footer class="bg-white border-top text-center text-muted py-2">

        <small>

            © 2026 CourtBook
            | ระบบจองสนามกีฬาออนไลน์

        </small>

    </footer>
    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
