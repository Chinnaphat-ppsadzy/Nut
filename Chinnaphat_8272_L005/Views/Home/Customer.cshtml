@{
    ViewData["Title"] = "หน้าหลัก - จองสนามกีฬา";
    Layout = "_CustomerLayout";

    string selectedDateStr = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    DateTime selectedDate = DateTime.TryParse(selectedDateStr, out var pDate) ? pDate : DateTime.Today;

    var courts = ViewBag.Courts as List<Chinnaphat_8272_L005.Models.Court>;
    if (courts == null || !courts.Any())
    {
        courts = new List<Chinnaphat_8272_L005.Models.Court>
        {
            new() { CourtId = 1, CourtName = "Court 1", Description = "พื้นยาง BWF มาตรฐานสากล", PricePerHour = 200, Status = "AVAILABLE" },
            new() { CourtId = 2, CourtName = "Court 2", Description = "พื้นยาง BWF มาตรฐานสากล", PricePerHour = 200, Status = "AVAILABLE" },
            new() { CourtId = 3, CourtName = "Court 3", Description = "พื้นยาง BWF มาตรฐานสากล", PricePerHour = 200, Status = "AVAILABLE" },
            new() { CourtId = 4, CourtName = "Court 4", Description = "พื้นยาง BWF มาตรฐานสากล", PricePerHour = 200, Status = "AVAILABLE" }
        };
    }

    var timeSlots = ViewBag.TimeSlots as List<Chinnaphat_8272_L005.Models.TimeSlot>;
    if (timeSlots == null || !timeSlots.Any())
    {
        timeSlots = new List<Chinnaphat_8272_L005.Models.TimeSlot>();
        for (int h = 8; h <= 21; h++)
        {
            timeSlots.Add(new Chinnaphat_8272_L005.Models.TimeSlot
            {
                SlotId = (byte)(h - 7),
                StartTime = new TimeOnly(h, 0),
                EndTime = new TimeOnly(h + 1, 0),
                IsActive = true
            });
        }
    }

    var promotions = ViewBag.Promotions as List<Chinnaphat_8272_L005.Models.Promotion>;
    if (promotions == null || !promotions.Any())
    {
        promotions = new List<Chinnaphat_8272_L005.Models.Promotion>
        {
            new() { PromoName = "โปรฯ เช่าสนาม (Time-based)", PromoCode = "COURT_OFFPEAK", Description = "จองคอร์ทช่วงเวลา 09.00 - 15.00 น. (จันทร์-ศุกร์) ลดราคาค่าเช่าคอร์ท 20%", DiscountValue = 20, DiscountType = "PERCENT", IsActive = true },
            new() { PromoName = "โปรฯ ส่งเสริมการขาย (Volume-based Sale)", PromoCode = "SHUTTLE_2ND_50", Description = "หากลูกค้าซื้อลูกแบดมินตันรุ่นใดก็ได้ตั้งแต่ 2 หลอดขึ้นไป ระบบจะลดราคาลูกแบดหลอดที่ 2 ทันที 50%", DiscountValue = 50, DiscountType = "PERCENT", IsActive = true },
            new() { PromoName = "โปรฯ ส่งเสริมการเช่า (Bundle Rental)", PromoCode = "BUNDLE_RENT_20", Description = "หากลูกค้าเช่าไม้แบดมินตัน 2 ไม้ พร้อมกับเช่ารองเท้า 2 คู่ ในบิลเดียวกัน ระบบจะลดราคาค่าเช่าอุปกรณ์เซ็ตนี้ 20%", DiscountValue = 20, DiscountType = "PERCENT", IsActive = true },
            new() { PromoName = "โปรฯ ซื้อคู่เช่า (Cross-selling Buy & Rent)", PromoCode = "CROSS_FREE_SHOES", Description = "หากลูกค้าซื้อลูกแบดมินตัน 1 หลอด + เช่าไม้แบดมินตัน 2 ไม้ รับสิทธิ์เช่ารองเท้าฟรี 1 คู่ (ระบบตัดราคารองเท้าออก 1 คู่)", DiscountValue = 1, DiscountType = "FREE_ITEM", IsActive = true },
            new() { PromoName = "โปรฯ ยอดซื้อรวม (Total Bill Discount)", PromoCode = "NEW_MEMBER_100", Description = "สมาชิกใหม่ที่จองคอร์ทครั้งแรก และมียอดรวมในบิลตั้งแต่ 600 บาทขึ้นไป รับส่วนลดหักท้ายบิลทันที 100 บาท", DiscountValue = 100, DiscountType = "FIXED_AMOUNT", MinBillAmount = 600, IsActive = true }
        };
    }

    var products = ViewBag.Products as List<Chinnaphat_8272_L005.Models.Product> ?? new();
    var myBookings = ViewBag.MyBookings as List<Chinnaphat_8272_L005.ViewModels.BookingTrackItem> ?? new();

    string? userId = Context.Session.GetString("UserId") ?? Context.Request.Cookies["cb_user_id"];
    string? rawUserName = Context.Session.GetString("FullName") ?? Context.Request.Cookies["cb_user_name"];
    string? currentUserName = !string.IsNullOrEmpty(rawUserName) ? System.Net.WebUtility.UrlDecode(rawUserName) : null;
    string? currentUserPhone = Context.Request.Cookies["cb_phone"];
    bool isLoggedIn = !string.IsNullOrEmpty(userId);
}

<style>
    /* ============================================================
       THEME & COLOR PALETTE: CourtBook Green Palette
       ============================================================ */
    :root {
        --cb-primary: #2d6a4f;
        --cb-primary-dark: #1a472a;
        --cb-primary-light: #52b788;
        --cb-mint-bg: #f0fdf4;
        --cb-mint-border: #bbf7d0;
        --cb-surface: #ffffff;
        --cb-muted: #64748b;
        --cb-booked: #f1f5f9;
        --cb-booked-border: #e2e8f0;
    }

    .theme-gradient {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 55%, #52b788 100%);
    }

    /* Hero Venue Card (Matchday Inspired) */
    .venue-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .venue-cover {
        height: 180px;
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);
        position: relative;
        padding: 1.5rem;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .venue-cover::after {
        content: '';
        position: absolute;
        inset: 0;
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60"><circle cx="30" cy="30" r="1.5" fill="rgba(255,255,255,0.15)"/></svg>');
        pointer-events: none;
    }
    .venue-badge-pill {
        background: rgba(255,255,255,0.22);
        backdrop-filter: blur(8px);
        color: #fff;
        padding: 0.35rem 0.85rem;
        border-radius: 30px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    /* Date Selector (Matchday Style Horizontal Pills) */
    .date-scroll-container {
        display: flex;
        gap: 0.65rem;
        overflow-x: auto;
        padding-bottom: 0.75rem;
        scrollbar-width: thin;
        scrollbar-color: #52b788 transparent;
    }
    .date-scroll-container::-webkit-scrollbar {
        height: 6px;
    }
    .date-scroll-container::-webkit-scrollbar-thumb {
        background-color: #bbf7d0;
        border-radius: 6px;
    }
    .date-pill {
        flex: 0 0 auto;
        width: 74px;
        padding: 0.65rem 0.4rem;
        border-radius: 14px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        color: inherit;
        display: block;
        user-select: none;
    }
    .date-pill:hover {
        border-color: #52b788;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(45,106,79,0.15);
    }
    .date-pill.active {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 100%);
        color: #fff !important;
        border-color: #2d6a4f;
        box-shadow: 0 6px 16px rgba(45,106,79,0.3);
        transform: translateY(-2px);
    }
    .date-pill .day-name {
        font-size: 0.76rem;
        font-weight: 600;
        text-transform: uppercase;
        opacity: 0.8;
    }
    .date-pill .day-num {
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.2;
    }
    .date-pill .month-name {
        font-size: 0.72rem;
        opacity: 0.8;
    }
    .date-pill.active .tag-today {
        background: rgba(255,255,255,0.25);
        color: white;
    }
    .tag-today {
        font-size: 0.62rem;
        background: #e8f5e9;
        color: #2d6a4f;
        border-radius: 10px;
        padding: 0.1rem 0.35rem;
        margin-top: 0.2rem;
        display: inline-block;
        font-weight: 700;
    }

    /* Timetable Table Styles (Matchday Style Matrix) */
    .timetable-wrapper {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #fff;
        overflow-x: auto;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }
    .table-schedule {
        margin-bottom: 0;
        width: 100%;
        min-width: 680px;
    }
    .table-schedule thead th {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        font-weight: 700;
        font-size: 0.92rem;
        color: #1e293b;
        padding: 1rem 0.75rem;
        text-align: center;
    }
    .table-schedule thead th.court-col {
        min-width: 140px;
    }
    .table-schedule tbody td {
        padding: 0.6rem 0.5rem;
        vertical-align: middle;
        border-color: #f1f5f9;
    }
    .time-slot-label {
        font-weight: 700;
        font-size: 0.88rem;
        color: #334155;
        white-space: nowrap;
        text-align: center;
        padding-left: 1rem;
        padding-right: 0.75rem;
    }
    .prime-badge {
        font-size: 0.65rem;
        color: #f59e0b;
        background: #fef3c7;
        padding: 0.1rem 0.4rem;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        margin-left: 0.3rem;
    }

    /* Slot Button (ว่าง / จองแล้ว / เลือกอยู่) */
    .slot-cell {
        display: block;
        width: 100%;
        min-height: 48px;
        border-radius: 10px;
        border: 1.5px solid #cbd5e1;
        background: #ffffff;
        text-align: center;
        padding: 0.55rem 0.4rem;
        font-size: 0.84rem;
        cursor: pointer;
        transition: all 0.18s ease-in-out;
        user-select: none;
        position: relative;
    }
    .slot-cell:hover:not(.booked) {
        border-color: #52b788;
        background: #f0fdf4;
        transform: scale(1.02);
        box-shadow: 0 4px 10px rgba(82,183,136,0.2);
    }
    .slot-cell .slot-price {
        font-weight: 700;
        color: #2d6a4f;
    }
    .slot-cell .slot-status-text {
        font-size: 0.7rem;
        color: #64748b;
        display: block;
    }

    /* Selected state */
    .slot-cell.selected {
        background: linear-gradient(135deg, #2d6a4f, #52b788) !important;
        border-color: #1a472a !important;
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(45,106,79,0.35);
        transform: scale(1.03);
    }
    .slot-cell.selected .slot-price,
    .slot-cell.selected .slot-status-text {
        color: #ffffff !important;
    }

    /* Booked (ไม่ว่าง) */
    .slot-cell.booked {
        background: #f1f5f9;
        border-color: #e2e8f0;
        color: #94a3b8;
        cursor: not-allowed;
        opacity: 0.75;
    }
    .slot-cell.booked .slot-price {
        color: #94a3b8;
        text-decoration: line-through;
    }
    .slot-cell.booked .slot-status-text {
        color: #ef4444;
        font-weight: 600;
    }

    /* Floating Booking Summary Bar */
    .floating-summary-bar {
        position: fixed;
        bottom: 1.5rem;
        left: calc(50% + 100px);
        transform: translateX(-50%) translateY(120%);
        background: #ffffff;
        border: 2px solid #52b788;
        border-radius: 18px;
        padding: 1rem 1.6rem;
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
        z-index: 1040;
        width: min(850px, 92vw);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .floating-summary-bar.show {
        transform: translateX(-50%) translateY(0);
    }
    @@media (max-width: 991px) {
        .floating-summary-bar {
            left: 50%;
            bottom: 1rem;
            padding: 0.85rem 1.2rem;
        }
    }

    /* Modal Styling */
    .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    }
    .modal-header-gradient {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);
        color: white;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        padding: 1.5rem;
    }
</style>

@{
    string sec = ViewBag.Section as string ?? "";
    bool showAll = sec == "";
}

@* ===== หน้าหลัก: แสดงเฉพาะเมื่อ showAll ===== *@
@if (showAll)
{
<!-- ============================================================
     TOP SECTION: Welcome & Stats
     ============================================================ -->
<div class="row g-4 mb-4">
    <!-- Welcome Card -->
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius:16px; background: linear-gradient(135deg,#2d6a4f,#52b788); color:white;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="bi bi-hand-wave me-2"></i>ยินดีต้อนรับสู่ CourtBook!</h4>
                        <p class="mb-0 opacity-75">ระบบจองสนามกีฬาออนไลน์ที่ง่ายและสะดวกที่สุด ตรวจสอบคอร์ทว่างและจองได้ทันที 24 ชม.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="#bookingSection" class="btn btn-light fw-bold text-success px-4 py-2" style="border-radius:10px;" onclick="scrollToBooking(event)">
                            <i class="bi bi-calendar-plus me-1"></i> จองสนามเลย
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
            <div class="card-body p-4 text-center">
                <div class="mb-2" style="font-size:2.5rem; color:#52b788;"><i class="bi bi-building"></i></div>
                <h3 class="fw-bold mb-0">@courts.Count</h3>
                <p class="text-muted mb-0">สนามแบดมินตันมาตรฐาน (สาขาพญาไท)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
            <div class="card-body p-4 text-center">
                <div class="mb-2" style="font-size:2.5rem; color:#3b82f6;"><i class="bi bi-calendar-check"></i></div>
                <h3 class="fw-bold mb-0" id="statMyBookings">@myBookings.Count</h3>
                <p class="text-muted mb-0">การจองของฉัน (ในระบบ)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
            <div class="card-body p-4 text-center">
                <div class="mb-2" style="font-size:2.5rem; color:#f59e0b;"><i class="bi bi-ticket-perforated"></i></div>
                <h3 class="fw-bold mb-0">@promotions.Count(p => p.IsActive == true)</h3>
                <p class="text-muted mb-0">โปรโมชั่นที่ใช้ได้</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-1"></i>เมนูด่วน</h5>
        <div class="row g-3">
            <div class="col-6 col-md">
                <a href="#bookingSection" class="btn btn-outline-success w-100 py-3" style="border-radius:12px;" onclick="scrollToBooking(event)">
                    <i class="bi bi-calendar-plus d-block mb-1" style="font-size:1.5rem;"></i>
                    <span class="fw-bold">จองสนาม</span>
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="#myBookingsSection" class="btn btn-outline-primary w-100 py-3" style="border-radius:12px;">
                    <i class="bi bi-clock-history d-block mb-1" style="font-size:1.5rem;"></i>
                    <span class="fw-bold">ติดตามสถานะการจอง</span>
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="#productSection" class="btn btn-outline-teal w-100 py-3" style="border-radius:12px; color:#0d9488; border-color:#0d9488;" onmouseover="this.style.background='#0d9488';this.style.color='#fff';" onmouseout="this.style.background='transparent';this.style.color='#0d9488';">
                    <i class="bi bi-box-seam d-block mb-1" style="font-size:1.5rem;"></i>
                    <span>ซื้อ/เช่าอุปกรณ์</span>
                </a>
            </div>
            <div class="col-6 col-md">
                <a href="javascript:void(0)" class="btn btn-outline-warning w-100 py-3" style="border-radius:12px;" onclick="showPromoInfo()">
                    <i class="bi bi-ticket-perforated d-block mb-1" style="font-size:1.5rem;"></i>
                    <span>โปรโมชั่น</span>
                </a>
            </div>
            <div class="col-6 col-md">
                <a asp-action="Login" asp-controller="User" class="btn btn-outline-danger w-100 py-3" style="border-radius:12px;">
                    <i class="bi bi-box-arrow-right d-block mb-1" style="font-size:1.5rem;"></i>
                    <span>ออกจากระบบ</span>
                </a>
            </div>
        </div>
    </div>
</div>

} @* end showAll - welcome & quick actions *@

@* ===== จองสนาม: แสดงเมื่อ showAll หรือ section=booking ===== *@
@if (showAll || sec == "booking")
{
<!-- ============================================================
     MAIN MATCHDAY-STYLE COURT BOOKING SECTION
     ============================================================ -->
<div id="bookingSection" class="scroll-mt-4 pt-2">

    <!-- Venue Header Card (Matchday Inspired) -->
    <div class="venue-card">
        <div class="venue-cover">
            <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex gap-2 flex-wrap">
                    <span class="venue-badge-pill">
                        <i class="bi bi-circle-fill text-success" style="font-size: 0.55rem;"></i> เปิดให้บริการปกติ
                    </span>
                    <span class="venue-badge-pill">
                        <i class="bi bi-shield-check"></i> มาตรฐาน BWF
                    </span>
                </div>
                <span class="venue-badge-pill" style="background:rgba(0,0,0,0.35);">
                    <i class="bi bi-clock"></i> 08:00 - 22:00 น.
                </span>
            </div>
            <div>
                <h3 class="fw-bold text-white mb-1">
                    <i class="bi bi-dribbble me-2"></i>CourtBook Arena - สาขาพญาไท
                </h3>
                <p class="text-white-50 mb-0 small">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> ถนนพญาไท แขวงทุ่งพญาไท เขตราชเทวี กรุงเทพมหานคร (BTS พญาไท)
                </p>
            </div>
        </div>

        <div class="p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge bg-success-subtle text-success px-3 py-2" style="border-radius:20px;">
                        <i class="bi bi-check-circle-fill me-1"></i> แบดมินตัน 4 คอร์ท
                    </span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius:20px;">
                        <i class="bi bi-p-square-fill text-primary me-1"></i> ที่จอดรถฟรี
                    </span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius:20px;">
                        <i class="bi bi-wifi text-success me-1"></i> Free Wi-Fi
                    </span>
                    <span class="badge bg-light text-secondary border px-3 py-2" style="border-radius:20px;">
                        <i class="bi bi-droplet-half text-info me-1"></i> ห้องอาบน้ำ
                    </span>
                </div>
                <div class="text-end">
                    <small class="text-muted d-block">อัตราค่าบริการ</small>
                    <span class="fs-5 fw-bold text-success">200 บาท</span>
                    <small class="text-muted"> / ชั่วโมง</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Tool Card -->
    <div class="card border-0 shadow-sm mb-5" style="border-radius:18px;">
        <div class="card-body p-4">

            <!-- Date Selector Section (Matchday Style Horizontal Day Scroll) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0 text-success">
                            <i class="bi bi-calendar3 me-2"></i>เลือกวันที่ต้องการจอง
                        </h5>
                        <small class="text-muted">เลือกวันเพื่อดูตารางคอร์ทว่างแบบเรียลไทม์</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label for="datePickerInput" class="small text-muted mb-0 fw-semibold">เลือกวัน:</label>
                        <input type="date" id="datePickerInput" class="form-control form-control-sm"
                               style="border-radius:8px; border:1.5px solid #cbd5e1; width:auto; cursor:pointer;"
                               value="@selectedDate.ToString("yyyy-MM-dd")"
                               onchange="onDateInputChange(this.value)" />
                    </div>
                </div>

                <!-- Horizontal Date Pills -->
                <div class="date-scroll-container" id="datePillContainer">
                    @{
                        string[] thaiDayNames = { "อา.", "จ.", "อ.", "พ.", "พฤ.", "ศ.", "ส." };
                        string[] thaiMonthNames = { "", "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };

                        for (int i = 0; i < 14; i++)
                        {
                            var loopDate = DateTime.Today.AddDays(i);
                            bool isActive = loopDate.Date == selectedDate.Date;
                            string dayName = thaiDayNames[(int)loopDate.DayOfWeek];
                            string monthName = thaiMonthNames[loopDate.Month];
                            string dateIso = loopDate.ToString("yyyy-MM-dd");

                            <div class="date-pill @(isActive ? "active" : "")"
                                 data-date="@dateIso"
                                 onclick="selectDatePill('@dateIso', this)">
                                <div class="day-name">@dayName</div>
                                <div class="day-num">@loopDate.Day</div>
                                <div class="month-name">@monthName</div>
                                @if (i == 0)
                                {
                                    <span class="tag-today">วันนี้</span>
                                }
                                else if (i == 1)
                                {
                                    <span class="tag-today">พรุ่งนี้</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25">

            <!-- Legend & Filter Bar (Matchday Style) -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 my-3">
                <!-- Filter Court tabs -->
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-success active" id="btnFilterAll" onclick="filterCourt('ALL')">
                        ทั้งหมด (@courts.Count คอร์ท)
                    </button>
                    @foreach (var c in courts)
                    {
                        <button type="button" class="btn btn-outline-success" id="btnFilter_@c.CourtId" onclick="filterCourt('@c.CourtId')">
                            @c.CourtName
                        </button>
                    }
                </div>

                <!-- Legend status badges -->
                <div class="d-flex align-items-center gap-3 flex-wrap small">
                    <div class="d-flex align-items-center gap-1">
                        <span style="width:14px; height:14px; border-radius:4px; border:1.5px solid #cbd5e1; background:#fff; display:inline-block;"></span>
                        <span class="text-secondary">ว่าง</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span style="width:14px; height:14px; border-radius:4px; background:linear-gradient(135deg, #2d6a4f, #52b788); display:inline-block;"></span>
                        <span class="fw-bold text-success">เลือกอยู่</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span style="width:14px; height:14px; border-radius:4px; background:#f1f5f9; border:1px solid #cbd5e1; display:inline-block;"></span>
                        <span class="text-muted">จองแล้ว</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="prime-badge"><i class="bi bi-lightning-fill"></i> Prime Time</span>
                    </div>
                </div>
            </div>

            <!-- Timetable Schedule Matrix -->
            <div class="timetable-wrapper">
                <table class="table table-schedule" id="timetableMatrix">
                    <thead>
                        <tr>
                            <th style="width: 150px; text-align: left; padding-left: 1.25rem;">
                                <i class="bi bi-clock me-1 text-success"></i>ช่วงเวลา
                            </th>
                            @foreach (var court in courts)
                            {
                                <th class="court-col court-header-@court.CourtId">
                                    <div class="fw-bold">@court.CourtName</div>
                                    <small class="fw-normal text-muted" style="font-size:0.75rem;">@court.Description</small>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // จำลอง slot ที่ถูกจองในระบบเพื่อความสมจริงแบบ Matchday
                            // (เช่น ช่วงค่ำ 18:00 - 20:00 บางคอร์ทมีผู้จองแล้ว)
                            var defaultBookedSet = new HashSet<string>
                            {
                                "1_11", // Court 1 at 18:00
                                "2_11", // Court 2 at 18:00
                                "2_12", // Court 2 at 19:00
                                "3_13", // Court 3 at 20:00
                                "4_10", // Court 4 at 17:00
                            };
                        }

                        @foreach (var slot in timeSlots)
                        {
                            string timeRange = $"{slot.StartTime.ToString("HH:mm")} - {slot.EndTime.ToString("HH:mm")}";
                            bool isPrime = slot.StartTime.Hour >= 18 && slot.StartTime.Hour < 22;

                            <tr>
                                <td class="time-slot-label">
                                    <span>@timeRange</span>
                                    @if (isPrime)
                                    {
                                        <span class="prime-badge" title="ช่วงเวลายอดนิยม"><i class="bi bi-lightning-fill"></i></span>
                                    }
                                </td>

                                @foreach (var court in courts)
                                {
                                    string slotKey = $"{court.CourtId}_{slot.SlotId}";
                                    bool isBooked = defaultBookedSet.Contains(slotKey);

                                    <td class="court-cell-@court.CourtId">
                                        @if (isBooked)
                                        {
                                            <div class="slot-cell booked" title="ช่วงเวลานี้ถูกจองแล้ว">
                                                <div class="slot-price">@court.PricePerHour.ToString("N0")฿</div>
                                                <span class="slot-status-text">
                                                    <i class="bi bi-lock-fill me-1"></i>จองแล้ว
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="slot-cell"
                                                 data-court-id="@court.CourtId"
                                                 data-court-name="@court.CourtName"
                                                 data-slot-id="@slot.SlotId"
                                                 data-time-range="@timeRange"
                                                 data-price="@court.PricePerHour"
                                                 onclick="toggleSlot(this)">
                                                <div class="slot-price">@court.PricePerHour.ToString("N0")฿</div>
                                                <span class="slot-status-text">ว่าง</span>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- ============================================================
     FLOATING SUMMARY BAR (Matchday Inspired Sticky Bar)
     ============================================================ -->
<div class="floating-summary-bar shadow-lg" id="floatingSummaryBar">
    <div class="d-flex align-items-center gap-3">
        <div style="width:48px; height:48px; border-radius:12px; background:linear-gradient(135deg,#2d6a4f,#52b788); color:white; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
            <i class="bi bi-bag-check"></i>
        </div>
        <div>
            <div class="small text-muted" id="summarySelectedDate">วันที่เลือก: @selectedDate.ToString("dd/MM/yyyy")</div>
            <div class="fw-bold" style="font-size:1.05rem;">
                คอร์ท: <span class="text-success" id="summaryCount">0</span> ช่อง (<span id="summaryHours">0</span> ชม.)
                <span class="badge ms-1 text-white" id="summaryCartBadge" style="background:#0d9488; display:none;">+ อุปกรณ์ 0 ชิ้น</span>
            </div>
            <small class="text-secondary d-none d-md-inline" id="summaryCourtList">-</small>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="text-end">
            <small class="text-muted d-block">ยอดรวมสุทธิ</small>
            <div class="fw-bold text-success fs-4" id="summaryTotalPrice">0 ฿</div>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2" style="border-radius:10px;" onclick="clearAllSelected()">
            <i class="bi bi-x-circle me-1"></i>ล้าง
        </button>
        @if (!isLoggedIn)
        {
            <button type="button" class="btn btn-warning fw-bold px-4 py-2" style="border-radius:10px;" onclick="showGuestAuthPrompt('จองสนามและชำระเงิน')">
                <i class="bi bi-lock-fill me-1"></i> เข้าสู่ระบบเพื่อจอง <i class="bi bi-arrow-right ms-1"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-success fw-bold px-4 py-2" style="border-radius:10px; background:linear-gradient(135deg,#1a472a,#2d6a4f); border:none;" onclick="openBookingModal()">
                ดำเนินการจอง <i class="bi bi-arrow-right ms-1"></i>
            </button>
        }
    </div>
</div>

} @* end booking section *@

@* ===== ซื้ออุปกรณ์: แสดงเมื่อ showAll หรือ section=product ===== *@
@if (showAll || sec == "product")
{
<!-- ============================================================
     PRODUCT & EQUIPMENT RENTAL SHOWCASE
     ============================================================ -->
<div id="productSection" class="mt-5 mb-5 scroll-mt-4">
    <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
        <div class="p-4 text-white" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 50%, #2dd4bf 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-white text-dark fw-bold mb-2">
                        <i class="bi bi-shop me-1 text-teal"></i> CourtBook Pro Shop & Rental
                    </span>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-box-seam me-2"></i>สินค้าและบริการเช่าอุปกรณ์
                    </h3>
                    <p class="mb-0 opacity-90 small">
                        มีลูกแบดมินตัน เครื่องดื่ม กริปพันด้ามจำหน่าย และมีบริการให้เช่าไม้แบดมินตันและรองเท้ากีฬามาตรฐานสากล ตรวจรับและส่งมอบโดยฝ่ายขาย (Sales Staff)
                    </p>
                </div>
                <div class="d-flex gap-2">
                    @if (!isLoggedIn)
                    {
                        <button class="btn btn-warning fw-bold text-dark px-3 py-2 shadow-sm" style="border-radius:10px;" onclick="showGuestAuthPrompt('สั่งซื้อหรือเช่าอุปกรณ์')">
                            <i class="bi bi-lock-fill me-1"></i> เข้าสู่ระบบเพื่อสั่งซื้อ/เช่า
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-warning fw-bold text-dark px-3 py-2 shadow-sm" style="border-radius:10px;" onclick="openBookingModal()">
                            <i class="bi bi-cart3 me-1"></i> ตะกร้าสินค้า & คอร์ท (<span id="cartCountBadge">0</span>)
                        </button>
                    }
                    <button class="btn btn-light fw-bold text-dark px-3 py-2 shadow-sm" style="border-radius:10px;" onclick="showPromoInfo()">
                        <i class="bi bi-ticket-perforated-fill text-warning me-1"></i> โปรโมชั่นอุปกรณ์
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-4 bg-light">
            <!-- Promo Notice Banner -->
            <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-center gap-3" style="background:#e6fffa; border-left: 4px solid #0d9488 !important; color:#134e4a;">
                <i class="bi bi-stars fs-3 text-teal"></i>
                <div class="small">
                    <strong>สิทธิพิเศษเฉพาะสมาชิก:</strong> ซื้อลูกแบด 2 หลอดขึ้นไป <em>หลอดที่ 2 ลดทันที 50%</em> | เช่าไม้แบด 2 ไม้ + รองเท้า 2 คู่ <em>ลดค่าเช่า 20%</em> | สั่งซื้อและรับของได้ที่เคาน์เตอร์ฝ่ายขายหน้าร้านได้ทันที
                </div>
            </div>

            <!-- Category Filter Pills -->
            <div class="d-flex gap-2 flex-wrap mb-4" id="custProductFilterPills">
                <button type="button" class="btn btn-sm btn-dark px-3 py-2 rounded-pill cust-cat-btn active" data-cat="ALL" onclick="filterCustomerProducts('ALL', this)">
                    <i class="bi bi-grid-fill me-1"></i> ทั้งหมด
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill cust-cat-btn" data-cat="SHUTTLECOCK" onclick="filterCustomerProducts('SHUTTLECOCK', this)">
                    🏸 ลูกแบดมินตัน
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill cust-cat-btn" data-cat="RACKET" onclick="filterCustomerProducts('RACKET', this)">
                    ⚡ ไม้แบดมินตัน (เช่า)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill cust-cat-btn" data-cat="SHOES" onclick="filterCustomerProducts('SHOES', this)">
                    👟 รองเท้าแบดมินตัน (เช่า)
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill cust-cat-btn" data-cat="BEVERAGE" onclick="filterCustomerProducts('BEVERAGE', this)">
                    🥤 เครื่องดื่ม
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill cust-cat-btn" data-cat="GRIP" onclick="filterCustomerProducts('GRIP', this)">
                    🎯 กริปพันด้าม
                </button>
            </div>

            <!-- Product Grid -->
            <div class="row g-3" id="custProductGrid">
                @if (products.Any())
                {
                    foreach (var item in products)
                    {
                        var catCode = item.Category?.CategoryCode ?? "GENERAL";
                        var isRent = item.ProductType == "RENT";
                        <div class="col-6 col-md-4 col-lg-3 cust-product-card" data-cat="@catCode">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden" style="background:#fff; transition: transform 0.2s, box-shadow 0.2s;">
                                <div class="position-relative p-4 text-center" style="background: @(isRent ? "#eff6ff" : "#f0fdf4");">
                                    <span class="badge position-absolute top-0 start-0 m-3 @(isRent ? "bg-primary" : "bg-success")" style="font-size:0.75rem; border-radius:8px;">
                                        @(isRent ? "อุปกรณ์เช่า (Rent)" : "สินค้าขาย (Sale)")
                                    </span>
                                    @if (item.StockQty <= 0)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-3" style="font-size:0.75rem; border-radius:8px;">
                                            สินค้าหมด
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border position-absolute top-0 end-0 m-3" style="font-size:0.75rem; border-radius:8px;">
                                            คงเหลือ @item.StockQty @item.Unit
                                        </span>
                                    }
                                    
                                    <div class="my-3" style="font-size: 3.5rem;">
                                        @if (catCode == "SHUTTLECOCK") { <span>🏸</span> }
                                        else if (catCode == "RACKET") { <span>🎾</span> }
                                        else if (catCode == "SHOES") { <span>👟</span> }
                                        else if (catCode == "BEVERAGE") { <span>🥤</span> }
                                        else { <span>🎯</span> }
                                    </div>
                                    <small class="text-muted font-monospace d-block">SKU: @item.Sku</small>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@item.ProductName</h6>
                                        <small class="text-muted d-block mb-2">@(item.Category?.CategoryName ?? "สินค้าทั่วไป")</small>
                                    </div>

                                    <div class="pt-2 border-top mt-2">
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <span class="small text-muted">@(isRent ? "ค่าเช่า" : "ราคาขาย"):</span>
                                            <strong class="text-dark fs-5">@item.Price.ToString("N0") ฿ <small class="fw-normal text-muted" style="font-size:0.75rem;">/@item.Unit</small></strong>
                                        </div>
                                        @if (isRent && item.Deposit > 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="small text-muted">มัดจำอุปกรณ์:</span>
                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning small">
                                                    @item.Deposit.ToString("N0") ฿ (ได้คืนเมื่อส่งมอบ)
                                                </span>
                                            </div>
                                        }
                                        <div class="mt-2 pt-2 border-top">
                                            @if (item.StockQty <= 0 && !isRent)
                                            {
                                                <button type="button" class="btn btn-sm btn-secondary w-100 disabled" style="border-radius:8px;">
                                                    สินค้าหมดชั่วคราว
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <button type="button" class="btn btn-sm @(isRent ? "btn-outline-primary" : "btn-outline-success") flex-grow-1 fw-bold py-1 px-2"
                                                            style="border-radius:8px;"
                                                            onclick="addToCustomerCart(@item.ProductId, '@Html.Raw(item.ProductName.Replace("'", "\\'"))', '@item.ProductType', '@catCode', @item.Price, '@item.Unit', @item.StockQty)">
                                                        <i class="bi bi-cart-plus me-1"></i> @(isRent ? "+ เลือกเช่า" : "+ ซื้อลงตะกร้า")
                                                    </button>
                                                    <span class="badge bg-success rounded-pill cust-cart-badge" id="cardQty_@item.ProductId" style="display:none; font-size:0.8rem;">0</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-box-seam text-muted" style="font-size:3rem;"></i>
                        <p class="text-muted mt-2">ยังไม่มีรายการสินค้าและอุปกรณ์ในระบบ</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function filterCustomerProducts(cat, btn) {
        document.querySelectorAll('#custProductFilterPills .cust-cat-btn').forEach(b => {
            b.classList.remove('active', 'btn-dark');
            b.classList.add('btn-outline-secondary');
        });
        btn.classList.add('active', 'btn-dark');
        btn.classList.remove('btn-outline-secondary');

        const cards = document.querySelectorAll('.cust-product-card');
        cards.forEach(card => {
            if (cat === 'ALL' || card.dataset.cat === cat) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

} @* end product section *@

@* ===== ดูสถานะการจอง: แสดงเมื่อ showAll หรือ section=tracking ===== *@
@if (showAll || sec == "tracking")
{
