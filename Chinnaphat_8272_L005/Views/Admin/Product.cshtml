@model List<Chinnaphat_8272_L005.Models.Product>

@{
    ViewData["Title"] = "จัดการสินค้าและอุปกรณ์ (Admin)";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<Chinnaphat_8272_L005.Models.ProductCategory> ?? new();
}

<style>
    .page-header-card {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 55%, #52b788 100%);
        border-radius: 16px;
        padding: 1.6rem 2rem;
        color: white;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        position: relative;
        overflow: hidden;
    }
    .page-header-card::after {
        content: '\F1B9'; /* Bootstrap bi-box-seam */
        font-family: 'bootstrap-icons';
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 5rem;
        opacity: 0.12;
    }
    .product-table-wrapper {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }
    .table th {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        color: #334155;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.9rem 0.75rem;
        white-space: nowrap;
    }
    .table td {
        padding: 0.85rem 0.75rem;
        vertical-align: middle;
        border-color: #f1f5f9;
        font-size: 0.9rem;
    }
    .badge-sale {
        background: #dbeafe;
        color: #1e40af;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.3rem 0.65rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    .badge-rent {
        background: #fef3c7;
        color: #b45309;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.3rem 0.65rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    .role-badge-pill {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.55rem;
        border-radius: 10px;
        display: inline-block;
        margin: 0.1rem 0;
        white-space: nowrap;
    }
    .role-sales {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }
    .role-accounting {
        background: #f3e8ff;
        color: #6d28d9;
        border: 1px solid #ddd6fe;
    }
    .role-customer {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }
    .filter-btn.active {
        background-color: #2d6a4f !important;
        color: white !important;
        border-color: #2d6a4f !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: #52b788;
        box-shadow: 0 0 0 3px rgba(82,183,136,0.2);
    }
    /* Pagination styling */
    .pagination .page-link {
        color: #2d6a4f;
        border-radius: 8px;
        margin: 0 2px;
        border: 1px solid #e2e8f0;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        transition: all 0.2s;
    }
    .pagination .page-item.active .page-link {
        background-color: #2d6a4f;
        border-color: #2d6a4f;
        color: #fff;
        font-weight: 700;
    }
    .pagination .page-link:hover {
        background-color: #e8f5e9;
        color: #1a472a;
    }
    .pagination .page-item.disabled .page-link {
        color: #94a3b8;
        background-color: #f8fafc;
        border-color: #e2e8f0;
    }
</style>

<!-- Header -->
<div class="page-header-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>จัดการสินค้าและอุปกรณ์
            </h3>
            <p class="mb-0 opacity-75 small">
                เพิ่ม แก้ไข ลบ และจัดการสต็อกสินค้าขายและอุปกรณ์เช่า
            </p>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#e8f5e9; color:#2d6a4f; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@Model.Count</h4>
                    <small class="text-muted">สินค้าทั้งหมดในระบบ</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-primary">@Model.Count(p => p.ProductType == "SALE")</h4>
                    <small class="text-muted">สินค้าสำหรับขาย (SALE)</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-warning">@Model.Count(p => p.ProductType == "RENT")</h4>
                    <small class="text-muted">อุปกรณ์สำหรับเช่า (RENT)</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#dcfce7; color:#16a34a; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-check2-all"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-success">@Model.Count(p => p.IsActive == true)</h4>
                    <small class="text-muted">เปิดใช้งาน (พร้อมขาย/เช่า)</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Table Card -->
<div class="product-table-wrapper">
    <!-- Top toolbar & Filter buttons -->
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h5 class="fw-bold mb-0 text-dark me-2">
                <i class="bi bi-list-ul me-2 text-success"></i>รายการสินค้าและอุปกรณ์ในฐานข้อมูล
            </h5>
            <!-- Filter buttons -->
            <button type="button" class="btn btn-sm btn-outline-secondary filter-btn active" onclick="filterProducts('ALL', this)">
                ทั้งหมด (@Model.Count)
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary filter-btn" onclick="filterProducts('SALE', this)">
                <i class="bi bi-cart me-1"></i>ขาย (@Model.Count(p => p.ProductType == "SALE"))
            </button>
            <button type="button" class="btn btn-sm btn-outline-warning filter-btn" onclick="filterProducts('RENT', this)">
                <i class="bi bi-arrow-repeat me-1"></i>เช่า (@Model.Count(p => p.ProductType == "RENT"))
            </button>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Search box -->
            <div class="input-group input-group-sm" style="width: 220px;">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" id="productSearchInput" class="form-control border-start-0" placeholder="ค้นหาชื่อสินค้า / SKU..." onkeyup="onSearchProduct(this.value)" />
            </div>

            <button type="button" class="btn btn-success btn-sm px-3 py-1 fw-bold shadow-sm" style="border-radius:8px;"
                    onclick="openAddProductModal()">
                <i class="bi bi-plus-lg me-1"></i> เพิ่มรายการใหม่
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table align-middle mb-0" id="productsTable">
            <thead>
                <tr>
                    <th style="width: 100px;">SKU</th>
                    <th>ชื่อสินค้า / อุปกรณ์</th>
                    <th>หมวดหมู่</th>
                    <th>ประเภท</th>
                    <th class="text-end">ราคา</th>
                    <th class="text-end">มัดจำ</th>
                    <th class="text-center">สต็อก</th>
                    <th class="text-center">สถานะ</th>
                    <th class="text-center" style="width: 140px;">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box mb-2" style="font-size:2.5rem; color:#cbd5e1;"></i>
                            <div class="fw-bold">ยังไม่มีข้อมูลสินค้าหรืออุปกรณ์ในฐานข้อมูล</div>
                            <small class="text-muted">คลิกปุ่ม "เพิ่มสินค้า/อุปกรณ์ใหม่" ด้านบนเพื่อเริ่มต้นสร้างรายการ</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in Model)
                    {
                        bool isSale = prod.ProductType == "SALE";
                        bool isActive = prod.IsActive == true;

                        <tr class="product-row" data-type="@prod.ProductType" data-cat="@prod.CategoryId">
                            <td>
                                <span class="badge bg-light text-dark border font-monospace fw-bold" style="font-size:0.75rem;">
                                    @prod.Sku
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark product-name-cell">@prod.ProductName</div>
                                <small class="text-muted">หน่วย: @prod.Unit</small>
                            </td>
                            <td>
                                <span class="badge bg-white text-secondary border">
                                    @(prod.Category?.CategoryName ?? "-")
                                </span>
                            </td>
                            <td>
                                @if (isSale)
                                {
                                    <span class="badge-sale">
                                        <i class="bi bi-cart"></i> ขาย
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-rent">
                                        <i class="bi bi-arrow-repeat"></i> เช่า
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <span class="fw-bold text-success fs-6">@prod.Price.ToString("N0") ฿</span>
                                <div class="text-muted" style="font-size:0.72rem;">ต่อ @prod.Unit</div>
                            </td>
                            <td class="text-end">
                                @if (prod.Deposit > 0)
                                {
                                    <span class="fw-semibold text-warning">@prod.Deposit.ToString("N0") ฿</span>
                                    <div class="text-muted" style="font-size:0.72rem;">(คืนเมื่อส่งมอบ)</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (prod.StockQty <= 5)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold">
                                        @prod.StockQty @prod.Unit (เหลือน้อย)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border fw-bold">
                                        @prod.StockQty @prod.Unit
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleProductStatus" asp-controller="Admin" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@prod.ProductId" />
                                    <button type="submit" class="btn btn-sm @(isActive ? "btn-outline-success" : "btn-outline-secondary")"
                                            style="border-radius:20px; font-size:0.75rem; padding:0.2rem 0.65rem;"
                                            title="คลิกเพื่อสลับเปิด/ปิดใช้งาน">
                                        <i class="bi @(isActive ? "bi-check-circle-fill text-success" : "bi-pause-circle text-muted") me-1"></i>
                                        @(isActive ? "เปิด" : "ปิด")
                                    </button>
                                </form>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <!-- ปุ่มแก้ไข -->
                                    <button type="button" class="btn btn-outline-primary btn-sm px-2 py-1" style="border-radius:8px;"
                                            onclick="openEditProductModal({
                                                id: @prod.ProductId,
                                                name: '@Html.Raw(prod.ProductName.Replace("'", "\\'"))',
                                                catId: @prod.CategoryId,
                                                type: '@prod.ProductType',
                                                price: @prod.Price,
                                                deposit: @prod.Deposit,
                                                unit: '@Html.Raw(prod.Unit)',
                                                stock: @prod.StockQty,
                                                isActive: @(isActive ? "true" : "false")
                                            })" title="แก้ไขข้อมูล">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- ปุ่มลบ -->
                                    <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1" style="border-radius:8px;"
                                            onclick="openDeleteProductModal(@prod.ProductId, '@Html.Raw(prod.ProductName.Replace("'", "\\'"))')" title="ลบรายการ">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer (แบ่งหน้า และปุ่มถัดไป/ก่อนหน้า) -->
    <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2 small text-muted">
            <span>แสดง</span>
            <select class="form-select form-select-sm d-inline-block bg-white" id="pageSizeSelect" style="width: 80px;" onchange="changePageSize(this.value)">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
            <span>รายการต่อหน้า &bull; แสดงรายการที่ <strong id="pageStart" class="text-dark">1</strong> ถึง <strong id="pageEnd" class="text-dark">5</strong> จากทั้งหมด <strong id="pageTotal" class="text-dark">@Model.Count</strong> รายการ</span>
        </div>

        <nav aria-label="Product table pagination">
            <ul class="pagination pagination-sm mb-0 justify-content-end" id="paginationControls">
                <!-- Injected dynamically by JavaScript -->
            </ul>
        </nav>
    </div>
</div>

<!-- ============================================================
     MODAL 1: เพิ่มสินค้าและอุปกรณ์ใหม่ (Add Product)
     ============================================================ -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:18px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.2);">
            <form asp-action="AddProduct" asp-controller="Admin" method="post" id="addProductForm">
                @Html.AntiForgeryToken()

                <div class="modal-header text-white" style="background:linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); border-top-left-radius:18px; border-top-right-radius:18px; padding:1.25rem 1.75rem;">
                    <div>
                        <h5 class="modal-title fw-bold" id="addProductModalLabel">
                            <i class="bi bi-plus-circle-fill me-2"></i>เพิ่มสินค้าหรืออุปกรณ์ใหม่ลงฐานข้อมูล
                        </h5>
                        <small class="text-white-50">ตรวจสอบข้อมูลให้ครบก่อนบันทึกสินค้าและอุปกรณ์ลงในระบบ</small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- ชื่อสินค้า/อุปกรณ์ -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">ชื่อสินค้า / อุปกรณ์ <span class="text-danger">*</span></label>
                            <input type="text" name="productName" id="addProductName" class="form-control"
                                   placeholder="เช่น ลูกแบดมินตัน Yonex Aerosensa 30 หรือ ไม้แบด Yonex Astrox" required />
                        </div>

                        <!-- รหัส SKU -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">รหัสสินค้า (SKU)</label>
                            <input type="text" name="sku" id="addSku" class="form-control text-uppercase font-monospace"
                                   placeholder="เช่น SHT-01 (เว้นว่างเพื่อ auto)" />
                            <small class="text-muted" style="font-size:0.75rem;">เว้นว่างไว้หากต้องการให้ระบบสร้างให้อัตโนมัติ</small>
                        </div>

                        <!-- หมวดหมู่ -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">หมวดหมู่สินค้า <span class="text-danger">*</span></label>
                            <select name="categoryId" id="addCategoryId" class="form-select" required onchange="onCategoryChanged(this)">
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId" data-type="@cat.ProductType">
                                        @cat.CategoryName (@(cat.ProductType == "SALE" ? "สินค้าขาย" : "อุปกรณ์เช่า"))
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- ประเภท: ขาย หรือ เช่า -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">ประเภทรายการ <span class="text-danger">*</span></label>
                            <select name="productType" id="addProductType" class="form-select fw-bold text-dark" required onchange="onProductTypeChanged(this.value)">
                                <option value="SALE">🛒 สินค้าสำหรับขาย (SALE)</option>
                                <option value="RENT">🏸 อุปกรณ์สำหรับเช่า (RENT)</option>
                            </select>
                        </div>

                        <!-- ราคา -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small" id="lblAddPrice">ราคาขาย (บาท) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">฿</span>
                                <input type="number" step="1" min="0" name="price" id="addPrice" class="form-control fw-bold fs-5 text-success" placeholder="0" required />
                            </div>
                        </div>

                        <!-- ค่ามัดจำ (สำหรับเช่า) -->
                        <div class="col-md-4" id="grpAddDeposit" style="display:none;">
                            <label class="form-label fw-semibold small">ค่ามัดจำอุปกรณ์ (บาท)</label>
                            <div class="input-group">
                                <span class="input-group-text">฿</span>
                                <input type="number" step="1" min="0" name="deposit" id="addDeposit" class="form-control fw-bold fs-5 text-warning" value="0" />
                            </div>
                            <small class="text-muted" style="font-size:0.72rem;">คืนให้ลูกค้าเมื่อตรวจรับคืนอุปกรณ์</small>
                        </div>

                        <!-- หน่วยนับ -->
                        <div class="col-md-4" id="grpAddUnit">
                            <label class="form-label fw-semibold small">หน่วยนับ <span class="text-danger">*</span></label>
                            <input type="text" name="unit" id="addUnit" class="form-control" list="unitList" placeholder="หลอด, ไม้, คู่, ชิ้น" required value="หลอด" />
                            <datalist id="unitList">
                                <option value="หลอด"></option>
                                <option value="ไม้"></option>
                                <option value="คู่"></option>
                                <option value="ขวด"></option>
                                <option value="ชิ้น"></option>
                                <option value="กระป๋อง"></option>
                            </datalist>
                        </div>

                        <!-- จำนวนสต็อกเริ่มต้น -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">จำนวนสต็อกเริ่มต้น <span class="text-danger">*</span></label>
                            <input type="number" min="0" name="stockQty" id="addStockQty" class="form-control" value="20" required />
                        </div>

                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3" style="border-bottom-left-radius:18px; border-bottom-right-radius:18px;">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success fw-bold px-4" style="background:linear-gradient(135deg,#1a472a,#2d6a4f); border:none;">
                        <i class="bi bi-check-circle me-1"></i> บันทึกลงฐานข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL 2: แก้ไขสินค้าและอุปกรณ์ (Edit Product)
     ============================================================ -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:18px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.2);">
            <form asp-action="UpdateProduct" asp-controller="Admin" method="post" id="editProductForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editProductId" name="productId" />

                <div class="modal-header bg-primary text-white" style="border-top-left-radius:18px; border-top-right-radius:18px; padding:1.25rem 1.75rem;">
                    <div>
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-pencil-square me-2"></i>แก้ไขข้อมูลสินค้า / อุปกรณ์
                        </h5>
                        <small class="text-white-50">รหัส ID: #<span id="displayEditId"></span></small>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small">ชื่อสินค้า / อุปกรณ์ <span class="text-danger">*</span></label>
                            <input type="text" name="productName" id="editProductName" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">หมวดหมู่ <span class="text-danger">*</span></label>
                            <select name="categoryId" id="editCategoryId" class="form-select" required>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">ประเภทรายการ <span class="text-danger">*</span></label>
                            <select name="productType" id="editProductType" class="form-select fw-bold" required onchange="onEditProductTypeChanged(this.value)">
                                <option value="SALE"> สินค้าสำหรับขาย (SALE)</option>
                                <option value="RENT"> อุปกรณ์สำหรับเช่า (RENT)</option>
                            </select>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="p-2 bg-light rounded-3 w-100 border mt-3">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" role="switch" name="isActive" id="editIsActive" value="true" style="width:2.2rem; height:1.2rem; cursor:pointer;" />
                                    <label class="form-check-label fw-bold ms-2 small" for="editIsActive">
                                        เปิดใช้งานสินค้าในระบบ
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small" id="lblEditPrice">ราคา (บาท) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">฿</span>
                                <input type="number" step="1" min="0" name="price" id="editPrice" class="form-control fw-bold text-success fs-5" required />
                            </div>
                        </div>

                        <div class="col-md-4" id="grpEditDeposit">
                            <label class="form-label fw-semibold small">ค่ามัดจำ (สำหรับเช่า)</label>
                            <div class="input-group">
                                <span class="input-group-text">฿</span>
                                <input type="number" step="1" min="0" name="deposit" id="editDeposit" class="form-control fw-bold text-warning" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">หน่วยนับ <span class="text-danger">*</span></label>
                            <input type="text" name="unit" id="editUnit" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">จำนวนสต็อกคงเหลือ <span class="text-danger">*</span></label>
                            <input type="number" min="0" name="stockQty" id="editStockQty" class="form-control" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3" style="border-bottom-left-radius:18px; border-bottom-right-radius:18px;">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-save me-1"></i> บันทึกการเปลี่ยนแปลง
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================
     MODAL 3: ยืนยันการลบสินค้า (Delete Product Modal)
     ============================================================ -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:18px; border:none; box-shadow:0 20px 50px rgba(0,0,0,0.2);">
            <form asp-action="DeleteProduct" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteProductId" />
                <div class="modal-body text-center p-4">
                    <div class="text-danger mb-3" style="font-size:3rem;">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>
                    <h5 class="fw-bold mb-2">ยืนยันการลบสินค้า?</h5>
                    <p class="text-muted small mb-3">
                        คุณต้องการลบ "<strong id="deleteProductNameText" class="text-dark"></strong>" ออกจากระบบหรือไม่?
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">ยกเลิก</button>
                        <button type="submit" class="btn btn-danger btn-sm px-3 fw-bold">
                            <i class="bi bi-trash me-1"></i> ลบสินค้า
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pagination state variables
        let currentPage = 1;
        let pageSize = 5;
        let currentFilter = 'ALL';
        let searchKeyword = '';

        // Open Add Modal
        function openAddProductModal() {
            document.getElementById('addProductForm').reset();
            onProductTypeChanged('SALE');
            new bootstrap.Modal(document.getElementById('addProductModal')).show();
        }

        // Category changed in Add Modal
        function onCategoryChanged(sel) {
            const opt = sel.options[sel.selectedIndex];
            const type = opt.getAttribute('data-type');
            if (type) {
                document.getElementById('addProductType').value = type;
                onProductTypeChanged(type);
            }
        }

        // Product type changed (SALE vs RENT)
        function onProductTypeChanged(type) {
            const grpDeposit = document.getElementById('grpAddDeposit');
            const lblPrice = document.getElementById('lblAddPrice');
            const unitInput = document.getElementById('addUnit');
            if (type === 'RENT') {
                grpDeposit.style.display = 'block';
                lblPrice.innerText = 'ราคาค่าเช่า (บาท/ครั้ง) *';
                if (!unitInput.value || unitInput.value === 'หลอด') unitInput.value = 'ไม้';
            } else {
                grpDeposit.style.display = 'none';
                lblPrice.innerText = 'ราคาขาย (บาท) *';
                if (!unitInput.value || unitInput.value === 'ไม้') unitInput.value = 'หลอด';
            }
        }

        // Open Edit Modal
        function openEditProductModal(data) {
            document.getElementById('editProductId').value = data.id;
            document.getElementById('displayEditId').innerText = data.id;
            document.getElementById('editProductName').value = data.name;
            document.getElementById('editCategoryId').value = data.catId;
            document.getElementById('editProductType').value = data.type;
            document.getElementById('editPrice').value = data.price;
            document.getElementById('editDeposit').value = data.deposit || 0;
            document.getElementById('editUnit').value = data.unit;
            document.getElementById('editStockQty').value = data.stock;
            document.getElementById('editIsActive').checked = data.isActive;

            onEditProductTypeChanged(data.type);
            new bootstrap.Modal(document.getElementById('editProductModal')).show();
        }

        function onEditProductTypeChanged(type) {
            const grp = document.getElementById('grpEditDeposit');
            const lbl = document.getElementById('lblEditPrice');
            if (type === 'RENT') {
                grp.style.display = 'block';
                lbl.innerText = 'ราคาค่าเช่า (บาท) *';
            } else {
                grp.style.display = 'none';
                lbl.innerText = 'ราคาขาย (บาท) *';
            }
        }

        // Open Delete Modal
        function openDeleteProductModal(id, name) {
            document.getElementById('deleteProductId').value = id;
            document.getElementById('deleteProductNameText').innerText = name;
            new bootstrap.Modal(document.getElementById('deleteProductModal')).show();
        }

        // ============================================================
        // PAGINATION & FILTER LOGIC (ระบบแบ่งหน้าและปุ่มถัดไป)
        // ============================================================
        function getFilteredRows() {
            const allRows = Array.from(document.querySelectorAll('.product-row'));
            return allRows.filter(row => {
                const rowType = row.getAttribute('data-type');
                const matchFilter = (currentFilter === 'ALL' || rowType === currentFilter);
                
                let matchSearch = true;
                if (searchKeyword) {
                    const text = row.innerText.toLowerCase();
                    matchSearch = text.includes(searchKeyword.toLowerCase());
                }
                return matchFilter && matchSearch;
            });
        }

        function updatePagination() {
            const filteredRows = getFilteredRows();
            const totalItems = filteredRows.length;
            const totalPages = Math.ceil(totalItems / pageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalItems);

            // ซ่อนแถวทั้งหมดก่อน
            const allRows = document.querySelectorAll('.product-row');
            allRows.forEach(r => r.style.display = 'none');

            // แสดงเฉพาะแถวในหน้าที่เลือก
            for (let i = startIndex; i < endIndex; i++) {
                if (filteredRows[i]) {
                    filteredRows[i].style.display = '';
                }
            }

            // จัดการกรณีไม่มีข้อมูลตรงเงื่อนไขค้นหา
            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) {
                emptyRow.style.display = totalItems === 0 ? '' : 'none';
            }

            // อัปเดตข้อความสถิติหน้า
            const startEl = document.getElementById('pageStart');
            const endEl = document.getElementById('pageEnd');
            const totalEl = document.getElementById('pageTotal');
            if (startEl) startEl.innerText = totalItems === 0 ? 0 : (startIndex + 1);
            if (endEl) endEl.innerText = endIndex;
            if (totalEl) totalEl.innerText = totalItems;

            // สร้างปุ่ม Pagination
            const paginationEl = document.getElementById('paginationControls');
            if (!paginationEl) return;
            paginationEl.innerHTML = '';

            // 1. ปุ่ม "« ก่อนหน้า"
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<button type="button" class="page-link" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}><i class="bi bi-chevron-left me-1"></i>ก่อนหน้า</button>`;
            paginationEl.appendChild(prevLi);

            // 2. ปุ่มหมายเลขหน้า
            for (let p = 1; p <= totalPages; p++) {
                const pageLi = document.createElement('li');
                pageLi.className = `page-item ${p === currentPage ? 'active' : ''}`;
                pageLi.innerHTML = `<button type="button" class="page-link" onclick="goToPage(${p})">${p}</button>`;
                paginationEl.appendChild(pageLi);
            }

            // 3. ปุ่ม "ถัดไป »"
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPage === totalPages || totalItems === 0 ? 'disabled' : ''}`;
            nextLi.innerHTML = `<button type="button" class="page-link" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages || totalItems === 0 ? 'disabled' : ''}>ถัดไป <i class="bi bi-chevron-right ms-1"></i></button>`;
            paginationEl.appendChild(nextLi);
        }

        // เปลี่ยนหน้า
        function goToPage(page) {
            currentPage = page;
            updatePagination();
        }

        // เปลี่ยนจำนวนรายการต่อหน้า
        function changePageSize(size) {
            pageSize = parseInt(size, 10);
            currentPage = 1;
            updatePagination();
        }

        // กรองประเภทสินค้า (ทั้งหมด / ขาย / เช่า)
        function filterProducts(type, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = type;
            currentPage = 1;
            updatePagination();
        }

        // ค้นหาชื่อสินค้า / SKU
        function onSearchProduct(keyword) {
            searchKeyword = keyword.trim();
            currentPage = 1;
            updatePagination();
        }

        // เริ่มต้นทำงานทันทีเมื่อโหลดหน้าเว็บเสร็จ
        document.addEventListener('DOMContentLoaded', function () {
            updatePagination();
        });
    </script>
}
