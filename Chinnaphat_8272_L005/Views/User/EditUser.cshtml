@model Chinnaphat_8272_L005.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "แก้ไขผู้ใช้งาน";
    Layout = "_AdminLayout";
    int editId = Model?.UserId ?? (ViewBag.EditId ?? 0);

    // 5 บทบาทผู้ใช้งานในระบบ ตามสิทธิ์การใช้งาน
    var roleDisplayMap = new Dictionary<string, (string Name, string BadgeClass, string Desc)>
    {
        ["CUSTOMER"]    = ("ลูกค้า / สมาชิก (Customer)", "bg-primary bg-opacity-10 text-primary", "จองคอร์ท ซื้อ/เช่าอุปกรณ์ ชำระเงิน ติดตามสถานะ"),
        ["COURT_STAFF"] = ("ฝ่ายดูแลคอร์ท (Court Supervisor)", "bg-warning bg-opacity-10 text-warning", "ดูตารางจอง เช็คอิน/เอาท์ ล็อกคอร์ท ซ่อมบำรุง คิว Walk-in"),
        ["SALES_STAFF"] = ("ฝ่ายซื้อ-เช่าอุปกรณ์ (Sales & Rental Staff)", "bg-info bg-opacity-10 text-info", "จัดการออเดอร์ ส่งมอบ/รับคืนอุปกรณ์ บันทึกความเสียหาย สต็อกหน้าร้าน"),
        ["ACCOUNTING"]  = ("ฝ่ายบัญชีและการเงิน (Accounting / Finance)", "bg-purple bg-opacity-10 text-purple", "ตรวจสอบสลิป อนุมัติคิว ออกใบเสร็จ ค่าปรับ/คืนเงิน รายงานการเงิน"),
        ["ADMIN"]       = ("ผู้ดูแลระบบ / เจ้าของคอร์ท (Admin / Owner)", "bg-danger bg-opacity-10 text-danger", "จัดการโปรโมชั่น ข้อมูลคอร์ท/สินค้า กำหนดสิทธิ์ วิเคราะห์ Dashboard")
    };

    var systemRoles = new List<(string Code, string Name, string BadgeClass, string Desc)>();
    var knownCodes = new HashSet<string>();

    foreach (var kvp in roleDisplayMap)
    {
        systemRoles.Add((kvp.Key, kvp.Value.Name, kvp.Value.BadgeClass, kvp.Value.Desc));
        knownCodes.Add(kvp.Key);
    }

    if (ViewBag.Roles != null)
    {
        foreach (var r in ViewBag.Roles)
        {
            string code = r.RoleCode ?? "";
            if (!string.IsNullOrEmpty(code) && !knownCodes.Contains(code))
            {
                systemRoles.Add((code, r.RoleName ?? code, "bg-secondary bg-opacity-10 text-secondary", ""));
                knownCodes.Add(code);
            }
        }
    }
}

<style>
    .edit-page-header {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 50%, #52b788 100%);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        color: white;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    .edit-page-header::after {
        content: '\270E';
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 4rem;
        opacity: 0.12;
    }
    .form-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        padding: 2rem;
        margin-bottom: 1.5rem;
    }
    .section-title {
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #2d6a4f;
        border-bottom: 2px solid #e8f5e9;
        padding-bottom: 0.5rem;
        margin-bottom: 1.3rem;
    }
    .form-label { font-weight: 600; font-size: 0.87rem; color: #2d3748; margin-bottom: 0.4rem; }
    .form-control, .form-select {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.6rem 1rem 0.6rem 2.6rem;
        font-size: 0.92rem;
        transition: all 0.25s;
        background-color: #fafafa;
    }
    .form-select { padding-left: 2.6rem; }
    .form-control:focus, .form-select:focus {
        border-color: #52b788;
        box-shadow: 0 0 0 3px rgba(82,183,136,0.18);
        background-color: #fff;
        outline: none;
    }
    .form-control.is-invalid { border-color: #e53e3e; }
    .input-wrapper { position: relative; }
    .input-wrapper .bi-icon {
        position: absolute;
        left: 0.85rem;
        top: 50%;
        transform: translateY(-50%);
        color: #52b788;
        font-size: 1rem;
        pointer-events: none;
        z-index: 1;
    }
    .input-wrapper .toggle-pwd {
        position: absolute;
        right: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        cursor: pointer;
        font-size: 1rem;
        z-index: 1;
        transition: color 0.2s;
    }
    .input-wrapper .toggle-pwd:hover { color: #2d6a4f; }
    .avatar-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2d6a4f, #52b788);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        color: white;
        margin: 0 auto 0.75rem;
        box-shadow: 0 4px 16px rgba(45,106,79,0.3);
        letter-spacing: 1px;
        transition: all 0.3s;
    }
    .btn-save {
        background: linear-gradient(135deg, #2d6a4f, #52b788);
        border: none;
        border-radius: 10px;
        padding: 0.7rem 2rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: white;
        transition: all 0.25s;
    }
    .btn-save:hover {
        background: linear-gradient(135deg, #1a472a, #2d6a4f);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(45,106,79,0.4);
        color: white;
    }
    .btn-save:active { transform: translateY(0); }
    .status-box {
        background: #f0fdf4;
        border: 1.5px solid #bbf7d0;
        border-radius: 12px;
        padding: 0.9rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.25s;
    }
    .status-box.inactive { background: #fef2f2; border-color: #fecaca; }
    .crud-badge {
        display: inline-block;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.65rem;
        border-radius: 20px;
        letter-spacing: 0.5px;
    }
    /* legend บทบาท */
    .role-legend-badge {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 20px;
        font-size: 0.73rem;
        font-weight: 600;
        font-family: 'Sarabun', sans-serif;
        white-space: nowrap;
    }
    .text-purple { color: #7c3aed !important; }
    .bg-purple   { background-color: #7c3aed !important; }
</style>

@* Header *@
<div class="edit-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-white">
                <i class="bi bi-pencil-square me-2"></i>แก้ไขข้อมูลผู้ใช้
            </h5>
            <p class="mb-0 text-white-50 small">
                User ID: <strong class="text-white">#@editId</strong> &nbsp;|&nbsp;
                <span class="crud-badge">UPDATE</span>
            </p>
        </div>
        <a asp-action="UserList" asp-controller="User"
           class="btn btn-outline-light btn-sm" style="border-radius:8px;">
            <i class="bi bi-arrow-left me-1"></i>กลับ
        </a>
    </div>
</div>

@* Alert: Validation Error *@
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger py-2 mb-3" style="border-radius:10px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        กรุณาตรวจสอบข้อมูลให้ครบถ้วน
    </div>
}

<form asp-action="EditUser" asp-controller="User" asp-route-id="@editId"
      method="post" id="editUserForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />

    <div class="row g-4">

        @* LEFT: Avatar + Status Card *@
        <div class="col-lg-3">
            <div class="form-card text-center">
                <div class="avatar-circle" id="avatarCircle">
                    @{
                        string initials = "";
                        if (!string.IsNullOrEmpty(Model?.FirstName))
                            initials += Model.FirstName.Substring(0, 1).ToUpper();
                        if (!string.IsNullOrEmpty(Model?.LastName))
                            initials += Model.LastName.Substring(0, 1).ToUpper();
                        if (string.IsNullOrEmpty(initials)) initials = "?";
                    }
                    @initials
                </div>
                <p class="text-muted small mb-0">รูปโปรไฟล์</p>
                <p class="fw-semibold mb-3" style="font-size:0.9rem;" id="avatarName">
                    @(Model?.FirstName) @(Model?.LastName)
                </p>

                <hr class="my-2">

                <p class="section-title text-start mt-2">สถานะบัญชี</p>
                <div class="status-box @(Model?.IsActive == false ? "inactive" : "")" id="statusBox">
                    <div>
                        <div class="fw-semibold" style="font-size:0.9rem;" id="statusLabel">
                            @(Model?.IsActive == true ? "เปิดใช้งาน" : "ปิดใช้งาน")
                        </div>
                        <small class="text-muted">สถานะบัญชีผู้ใช้</small>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" id="isActiveSwitch"
                               role="switch" style="width:2.5rem; height:1.3rem; cursor:pointer;" />
                    </div>
                </div>

                <hr class="my-3">

                <div class="alert alert-info py-2" style="border-radius:10px; font-size:0.8rem; text-align:left;">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>CRUD: UPDATE</strong><br>
                    แก้ไขข้อมูลตาราง <code>users</code><br>
                    ID: <strong>#@editId</strong>
                </div>

                @* Legend บทบาทในระบบ *@
                <div class="mt-3">
                    <p class="section-title text-start">บทบาทในระบบ (5 บทบาท)</p>
                    @foreach (var r in systemRoles)
                    {
                        <div class="mb-2 p-2 rounded-3 border" style="background:#fafbfc;">
                            <span class="role-legend-badge @r.BadgeClass">@r.Name</span>
                            @if (!string.IsNullOrEmpty(r.Desc))
                            {
                                <small class="text-muted d-block mt-1" style="font-size:0.72rem; line-height:1.3;">@r.Desc</small>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* RIGHT: Form Fields *@
        <div class="col-lg-9">

            @* ข้อมูลส่วนตัว *@
            <div class="form-card">
                <p class="section-title"><i class="bi bi-person me-1"></i>ข้อมูลส่วนตัว</p>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            ชื่อ <span class="text-danger">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="bi bi-person bi-icon"></i>
                            <input asp-for="FirstName" class="form-control" id="editFirstName"
                                   placeholder="ชื่อ" autocomplete="given-name" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">
                            นามสกุล <span class="text-danger">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="bi bi-person bi-icon"></i>
                            <input asp-for="LastName" class="form-control" id="editLastName"
                                   placeholder="นามสกุล" autocomplete="family-name" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">เบอร์โทรศัพท์</label>
                        <div class="input-wrapper">
                            <i class="bi bi-telephone bi-icon"></i>
                            <input asp-for="Phone" class="form-control" id="editPhone"
                                   placeholder="0XX-XXX-XXXX" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">บทบาท</label>
                        <div class="input-wrapper">
                            <i class="bi bi-shield-check bi-icon"></i>
                            <select asp-for="Role" class="form-select" id="editRole" onchange="updateRoleDesc(this.value)">
                                <option value="">-- เลือกบทบาทผู้ใช้งาน --</option>
                                @foreach (var r in systemRoles)
                                {
                                    <option value="@r.Code">@r.Name</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <!-- คำอธิบายบทบาทที่เลือก -->
                        <div id="roleDescBox" class="mt-2 p-2 rounded-3 d-none" style="background:#f0fdf4; border:1px solid #bbf7d0; font-size:0.82rem; color:#1a472a;">
                            <i class="bi bi-info-circle me-1"></i><span id="roleDescText"></span>
                        </div>
                    </div>
                </div>
            </div>

            @* ข้อมูลบัญชี *@
            <div class="form-card">
                <p class="section-title"><i class="bi bi-shield-lock me-1"></i>ข้อมูลบัญชีผู้ใช้</p>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        อีเมล <span class="text-danger">*</span>
                    </label>
                    <div class="input-wrapper">
                        <i class="bi bi-envelope bi-icon"></i>
                        <input asp-for="Email" class="form-control" id="editEmail"
                               placeholder="example@email.com" type="email" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        รหัสผ่านใหม่
                        <small class="text-muted fw-normal">(เว้นว่างไว้หากไม่ต้องการเปลี่ยน)</small>
                    </label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock bi-icon"></i>
                        <input asp-for="Password" class="form-control" id="editPassword"
                               type="password" placeholder="รหัสผ่านใหม่ (อย่างน้อย 6 ตัว)" autocomplete="new-password" />
                        <i class="bi bi-eye toggle-pwd" id="toggleEditPwd"
                           onclick="togglePwd('editPassword','toggleEditPwd')"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                @* Action Buttons *@
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-save" id="btnSaveEdit">
                        <i class="bi bi-floppy me-2"></i>บันทึกการแก้ไข
                    </button>
                    <a asp-action="UserList" asp-controller="User"
                       class="btn btn-outline-secondary" style="border-radius:10px; padding:0.7rem 1.5rem;">
                        <i class="bi bi-x-circle me-1"></i>ยกเลิก
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // อัปเดต initials ตามชื่อ-นามสกุลที่พิมพ์
        function updateAvatar() {
            const fn = document.getElementById('editFirstName').value.trim();
            const ln = document.getElementById('editLastName').value.trim();
            const circle = document.getElementById('avatarCircle');
            const nameLabel = document.getElementById('avatarName');
            const i1 = fn.length > 0 ? fn[0].toUpperCase() : '';
            const i2 = ln.length > 0 ? ln[0].toUpperCase() : '';
            circle.textContent = (i1 || i2) ? i1 + i2 : '?';
            nameLabel.textContent = (fn + ' ' + ln).trim() || 'ไม่ระบุชื่อ';
        }
        document.getElementById('editFirstName').addEventListener('input', updateAvatar);
        document.getElementById('editLastName').addEventListener('input', updateAvatar);

        // Status Switch
        const switchEl = document.getElementById('isActiveSwitch');
        const statusBox = document.getElementById('statusBox');
        const statusLabel = document.getElementById('statusLabel');

        function updateStatus(checked) {
            if (checked) {
                statusBox.classList.remove('inactive');
                statusLabel.textContent = 'เปิดใช้งาน';
            } else {
                statusBox.classList.add('inactive');
                statusLabel.textContent = 'ปิดใช้งาน';
            }
        }
        switchEl.addEventListener('change', function () { updateStatus(this.checked); });
        updateStatus(switchEl.checked);

        // Toggle Password Visibility
        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        // คำอธิบายบทบาทที่เลือก
        const roleDescriptions = {
            'CUSTOMER':    'จองคอร์ท ซื้อ/เช่าอุปกรณ์ ชำระเงิน ติดตามสถานะการจองของตนเอง',
            'COURT_STAFF': 'ดูตารางการจองประจำวัน Check-in/Check-out จัดการคิว Walk-in ล็อกคอร์ทชั่วคราว แจ้งอุปกรณ์ชำรุด',
            'SALES_STAFF': 'ดูรายการออเดอร์ ส่งมอบสินค้า ตรวจรับคืนอุปกรณ์เช่า บันทึกความเสียหาย อัปเดตสต็อกหน้าร้าน',
            'ACCOUNTING':  'ตรวจสอบสลิปโอนเงิน อนุมัติคิว ออกใบเสร็จ/ใบกำกับภาษี คิดค่าปรับ จัดการคืนเงิน ดูรายงานการเงิน',
            'ADMIN':       'จัดการโปรโมชั่น 5 แบบ เพิ่ม/ลบ/แก้ไขข้อมูลคอร์ทและสินค้า กำหนดสิทธิ์พนักงาน ดู Dashboard ภาพรวมธุรกิจ'
        };

        function updateRoleDesc(code) {
            const box = document.getElementById('roleDescBox');
            const txt = document.getElementById('roleDescText');
            if (code && roleDescriptions[code]) {
                box.classList.remove('d-none');
                txt.textContent = roleDescriptions[code];
            } else {
                box.classList.add('d-none');
            }
        }

        // กรณีมีค่า default ตอน load (edit mode)
        const initRole = document.getElementById('editRole').value;
        if (initRole) updateRoleDesc(initRole);
    </script>
}
