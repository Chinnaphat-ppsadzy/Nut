@model Chinnaphat_8272_L005.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>สมัครสมาชิก - CourtBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Sarabun', sans-serif; }

        body {
            background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 40%, #52b788 100%);
            min-height: 100vh;
            padding: 2rem 1rem;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .register-card {
            background: rgba(255,255,255,0.97);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            overflow: hidden;
            max-width: 560px;
            width: 100%;
        }

        .register-header {
            background: linear-gradient(135deg, #2d6a4f, #52b788);
            padding: 2rem;
            text-align: center;
            color: white;
        }

        .register-header .logo-icon { font-size: 3rem; margin-bottom: 0.3rem; }
        .register-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.1rem; }
        .register-header p  { font-size: 0.88rem; opacity: 0.85; margin: 0; }

        .register-body { padding: 2rem; }

        .section-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #52b788;
            border-bottom: 2px solid #e8f5e9;
            padding-bottom: 0.4rem;
            margin-bottom: 1rem;
        }

        .form-label { font-weight: 600; color: #2d3748; font-size: 0.88rem; }

        .form-control, .form-select {
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.6rem 1rem 0.6rem 2.6rem;
            font-size: 0.92rem;
            transition: all 0.25s;
        }

        .form-select { padding-left: 2.6rem; }

        .form-control:focus, .form-select:focus {
            border-color: #52b788;
            box-shadow: 0 0 0 3px rgba(82,183,136,0.2);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper .bi-icon {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #52b788;
            font-size: 1rem;
            pointer-events: none;
        }

        .input-wrapper .toggle-password {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            cursor: pointer;
        }

        .btn-register {
            background: linear-gradient(135deg, #2d6a4f, #52b788);
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.25s;
        }

        .btn-register:hover {
            background: linear-gradient(135deg, #1a472a, #2d6a4f);
            transform: translateY(-1px);
            box-shadow: 0 5px 20px rgba(45,106,79,0.4);
            color: white;
        }

        .footer-link { text-align: center; margin-top: 1.2rem; font-size: 0.88rem; color: #718096; }
        .footer-link a { color: #2d6a4f; font-weight: 600; text-decoration: none; }
        .footer-link a:hover { text-decoration: underline; }

        .required-star { color: #e53e3e; }

        .password-strength {
            height: 5px;
            border-radius: 3px;
            background: #e2e8f0;
            margin-top: 6px;
        }

        .password-strength .bar {
            height: 100%;
            border-radius: 3px;
            transition: all 0.4s;
        }
    </style>
</head>
<body>

<div class="register-card my-3">

    <!-- Header -->
    <div class="register-header">
        <div class="logo-icon"><i class="bi bi-person-plus-fill"></i></div>
        <h1>สมัครสมาชิก</h1>
        <p>สร้างบัญชีใหม่เพื่อเริ่มต้นใช้งาน CourtBook</p>
    </div>

    <!-- Body -->
    <div class="register-body">

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger py-2" style="border-radius:10px;">
                <i class="bi bi-exclamation-triangle me-2"></i>กรุณาตรวจสอบข้อมูลให้ครบถ้วน
            </div>
        }

        <form asp-action="Register" asp-controller="User" method="post" id="registerForm">
            @Html.AntiForgeryToken()

            <!-- ส่วนที่ 1: ข้อมูลส่วนตัว -->
            <p class="section-title"><i class="bi bi-person me-1"></i>ข้อมูลส่วนตัว</p>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="FirstName" class="form-label">ชื่อ <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <i class="bi bi-person bi-icon"></i>
                        <input asp-for="FirstName" class="form-control" id="firstName" placeholder="ชื่อ" />
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="LastName" class="form-label">นามสกุล <span class="required-star">*</span></label>
                    <div class="input-wrapper">
                        <i class="bi bi-person bi-icon"></i>
                        <input asp-for="LastName" class="form-control" id="lastName" placeholder="นามสกุล" />
                    </div>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label">เพศ <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <i class="bi bi-gender-ambiguous bi-icon"></i>
                    <select asp-for="Gender" class="form-select" id="gender">
                        <option value="">-- เลือกเพศ --</option>
                        <option value="male">ชาย</option>
                        <option value="female">หญิง</option>
                        <option value="other">อื่น ๆ</option>
                    </select>
                </div>
                <span asp-validation-for="Gender" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">เบอร์โทรศัพท์ <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <i class="bi bi-telephone bi-icon"></i>
                    <input asp-for="Phone" class="form-control" id="phone" placeholder="0XX-XXX-XXXX" />
                </div>
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <!-- ส่วนที่ 2: ข้อมูลบัญชี -->
            <p class="section-title mt-3"><i class="bi bi-shield-lock me-1"></i>ข้อมูลบัญชีผู้ใช้</p>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">อีเมล <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope bi-icon"></i>
                    <input asp-for="Email" class="form-control" id="email" placeholder="example@email.com" type="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>



            <div class="mb-3">
                <label asp-for="Password" class="form-label">รหัสผ่าน <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <i class="bi bi-lock bi-icon"></i>
                    <input asp-for="Password" class="form-control" id="regPassword" placeholder="รหัสผ่าน (อย่างน้อย 6 ตัว)" />
                    <i class="bi bi-eye toggle-password" id="toggleRegPwd" onclick="togglePwd('regPassword','toggleRegPwd')"></i>
                </div>
                <div class="password-strength"><div class="bar" id="strengthBar"></div></div>
                <small id="strengthText" class="text-muted"></small>
                <span asp-validation-for="Password" class="text-danger small d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่าน <span class="required-star">*</span></label>
                <div class="input-wrapper">
                    <i class="bi bi-lock-fill bi-icon"></i>
                    <input asp-for="ConfirmPassword" class="form-control" id="confirmPwd" placeholder="ยืนยันรหัสผ่าน" />
                    <i class="bi bi-eye toggle-password" id="toggleConfirmPwd" onclick="togglePwd('confirmPwd','toggleConfirmPwd')"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-register" id="btnRegister">
                <i class="bi bi-person-check me-2"></i>สมัครสมาชิก
            </button>
        </form>

        <div class="footer-link">
            มีบัญชีอยู่แล้ว?
            <a asp-action="Login" asp-controller="User">เข้าสู่ระบบ</a>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    function togglePwd(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    // Password strength indicator
    document.getElementById('regPassword').addEventListener('input', function () {
        const val  = this.value;
        const bar  = document.getElementById('strengthBar');
        const text = document.getElementById('strengthText');
        let score  = 0;
        if (val.length >= 6)  score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { label: '',          color: '#e2e8f0', width: '0%'   },
            { label: 'อ่อนมาก',   color: '#fc8181', width: '20%'  },
            { label: 'อ่อน',      color: '#fbd38d', width: '40%'  },
            { label: 'พอใช้',     color: '#f6e05e', width: '60%'  },
            { label: 'แข็งแกร่ง', color: '#68d391', width: '80%'  },
            { label: 'ดีมาก',     color: '#48bb78', width: '100%' },
        ];
        bar.style.width      = levels[score].width;
        bar.style.background = levels[score].color;
        text.textContent     = val.length > 0 ? `ความแข็งแกร่ง: ${levels[score].label}` : '';
    });
</script>

</body>
</html>
