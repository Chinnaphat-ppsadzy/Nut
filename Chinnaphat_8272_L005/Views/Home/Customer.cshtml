<!-- ============================================================
     CLIENT-SIDE JAVASCRIPT LOGIC
     ============================================================ -->
@section Scripts {
    <script>
        // State Management
        let selectedSlots = new Map(); // key: courtId_slotId, value: { courtId, courtName, slotId, timeRange, price }
        let currentActiveDate = '@selectedDate.ToString("yyyy-MM-dd")';
        let appliedDiscount = 0;

        // Smooth scroll to booking section
        function scrollToBooking(e) {
            if (e) e.preventDefault();
            const el = document.getElementById('bookingSection');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Handle Date Pill Click
        function selectDatePill(dateIso, pillEl) {
            document.querySelectorAll('.date-pill').forEach(p => p.classList.remove('active'));
            pillEl.classList.add('active');
            currentActiveDate = dateIso;
            document.getElementById('datePickerInput').value = dateIso;

            // Clear previously selected slots when date changes
            clearAllSelected();

            // Update date text
            updateDateLabels(dateIso);
        }

        // Handle Native Date Input change
        function onDateInputChange(dateIso) {
            if (!dateIso) return;
            currentActiveDate = dateIso;

            // Find matching pill or clear active
            let matched = false;
            document.querySelectorAll('.date-pill').forEach(p => {
                if (p.getAttribute('data-date') === dateIso) {
                    p.classList.add('active');
                    p.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                    matched = true;
                } else {
                    p.classList.remove('active');
                }
            });

            clearAllSelected();
            updateDateLabels(dateIso);
        }

        function updateDateLabels(dateIso) {
            const parts = dateIso.split('-');
            const formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
            const summaryDateEl = document.getElementById('summarySelectedDate');
            if (summaryDateEl) summaryDateEl.innerText = `วันที่เลือก: ${formatted}`;
            const modalDateEl = document.getElementById('modalBookingDate');
            if (modalDateEl) modalDateEl.innerText = formatted;
        }

        // Filter Court columns
        function filterCourt(courtId) {
            const buttons = document.querySelectorAll('.btn-group button');
            buttons.forEach(btn => btn.classList.remove('active'));

            if (courtId === 'ALL') {
                document.getElementById('btnFilterAll').classList.add('active');
                document.querySelectorAll('[class*="court-col"], [class*="court-cell-"]').forEach(el => el.style.display = '');
            } else {
                const activeBtn = document.getElementById('btnFilter_' + courtId);
                if (activeBtn) activeBtn.classList.add('active');

                // Hide all court headers and cells except the target one
                document.querySelectorAll('[class*="court-col"]').forEach(th => {
                    th.style.display = th.classList.contains('court-header-' + courtId) ? '' : 'none';
                });
                document.querySelectorAll('[class*="court-cell-"]').forEach(td => {
                    td.style.display = td.classList.contains('court-cell-' + courtId) ? '' : 'none';
                });
            }
        }

        // Toggle Slot Selection
        function toggleSlot(cellEl) {
            const courtId = cellEl.getAttribute('data-court-id');
            const courtName = cellEl.getAttribute('data-court-name');
            const slotId = cellEl.getAttribute('data-slot-id');
            const timeRange = cellEl.getAttribute('data-time-range');
            const price = parseFloat(cellEl.getAttribute('data-price')) || 200;

            const key = `${courtId}_${slotId}`;

            if (selectedSlots.has(key)) {
                selectedSlots.delete(key);
                cellEl.classList.remove('selected');
                cellEl.querySelector('.slot-status-text').innerText = 'ว่าง';
            } else {
                selectedSlots.set(key, { courtId, courtName, slotId, timeRange, price });
                cellEl.classList.add('selected');
                cellEl.querySelector('.slot-status-text').innerHTML = '<i class="bi bi-check2"></i> เลือกแล้ว';
            }

            updateSummaryBar();
        }

        // Clear all selected slots
        function clearAllSelected() {
            selectedSlots.clear();
            document.querySelectorAll('.slot-cell.selected').forEach(el => {
                el.classList.remove('selected');
                el.querySelector('.slot-status-text').innerText = 'ว่าง';
            });
            updateSummaryBar();
        }

        // Update Floating Summary Bar
        function updateSummaryBar() {
            const count = selectedSlots.size;
            const bar = document.getElementById('floatingSummaryBar');

            if (count > 0) {
                bar.classList.add('show');
            } else {
                bar.classList.remove('show');
            }

            document.getElementById('summaryCount').innerText = count;
            document.getElementById('summaryHours').innerText = count;

            let total = 0;
            const courtSet = new Set();
            selectedSlots.forEach(s => {
                total += s.price;
                courtSet.add(s.courtName);
            });

            document.getElementById('summaryTotalPrice').innerText = total.toLocaleString() + ' ฿';
            document.getElementById('summaryCourtList').innerText = Array.from(courtSet).join(', ');
        }

        // Open Confirmation Modal
        function openBookingModal() {
            if (selectedSlots.size === 0) return;

            const listContainer = document.getElementById('modalSelectedSlotsList');
            listContainer.innerHTML = '';

            let total = 0;
            selectedSlots.forEach((slot, key) => {
                total += slot.price;
                const row = document.createElement('div');
                row.className = 'd-flex justify-content-between align-items-center bg-white p-2 rounded border small';
                row.innerHTML = `
                    <div>
                        <strong class="text-success">${slot.courtName}</strong>: ${slot.timeRange}
                    </div>
                    <span class="fw-bold">${slot.price.toLocaleString()} ฿</span>
                `;
                listContainer.appendChild(row);
            });

            const hours = selectedSlots.size;
            document.getElementById('modalTotalHours').innerText = `${hours} ชม.`;
            document.getElementById('modalSubtotal').innerText = `${total.toLocaleString()} ฿`;

            appliedDiscount = 0;
            document.getElementById('promoDiscountRow').style.setProperty('display', 'none', 'important');
            document.getElementById('modalFinalPrice').innerText = `${total.toLocaleString()} ฿`;
            document.getElementById('promoMsg').innerText = '';
            document.getElementById('promoCodeInput').value = '';

            const modal = new bootstrap.Modal(document.getElementById('bookingConfirmModal'));
            modal.show();
        }

        // Active promotions loaded dynamically from database
        const activePromotions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            promotions.Where(p => p.IsActive == true).Select(p => new {
                code = p.PromoCode,
                name = p.PromoName,
                type = p.PromoType,
                discount = p.DiscountValue,
                discountType = p.DiscountType,
                minBill = p.MinBillAmount ?? 0
            })
        ));

        // Apply Promo Code
        function applyPromoCode() {
            const code = document.getElementById('promoCodeInput').value.trim().toUpperCase();
            const promoMsg = document.getElementById('promoMsg');

            let total = 0;
            selectedSlots.forEach(s => total += s.price);

            const matchedPromo = activePromotions.find(p => p.code && p.code.toUpperCase() === code);

            if (matchedPromo) {
                if (matchedPromo.type === 'TOTAL_BILL' && total < matchedPromo.minBill) {
                    promoMsg.className = 'small mt-1 text-warning fw-bold';
                    promoMsg.innerText = `โค้ดนี้ต้องมียอดบิลขั้นต่ำ ${matchedPromo.minBill.toLocaleString()} บาท (ปัจจุบัน ${total.toLocaleString()} ฿)`;
                    return;
                }

                if (matchedPromo.discountType === 'PERCENT') {
                    appliedDiscount = Math.round((total * matchedPromo.discount) / 100);
                } else if (matchedPromo.discountType === 'FIXED_AMOUNT') {
                    appliedDiscount = matchedPromo.discount;
                } else if (matchedPromo.discountType === 'FREE_ITEM') {
                    appliedDiscount = 50; // มูลค่าของแถมฟรี เช่น เช่ารองเท้า 1 คู่
                }

                document.getElementById('promoDiscountRow').style.setProperty('display', 'flex', 'important');
                document.getElementById('modalDiscount').innerText = `-${appliedDiscount.toLocaleString()} ฿`;
                const finalTotal = Math.max(0, total - appliedDiscount);
                document.getElementById('modalFinalPrice').innerText = `${finalTotal.toLocaleString()} ฿`;
                promoMsg.className = 'small mt-1 text-success fw-bold';
                promoMsg.innerHTML = `<i class="bi bi-check-circle me-1"></i>ใช้โค้ด ${matchedPromo.name} สำเร็จ! ลด ${appliedDiscount.toLocaleString()} บาท`;
            } else if (code === 'COURT10' || code === 'WELCOME50' || code === 'MATCHDAY') {
                appliedDiscount = 50;
                document.getElementById('promoDiscountRow').style.setProperty('display', 'flex', 'important');
                document.getElementById('modalDiscount').innerText = `-${appliedDiscount} ฿`;
                const finalTotal = Math.max(0, total - appliedDiscount);
                document.getElementById('modalFinalPrice').innerText = `${finalTotal.toLocaleString()} ฿`;
                promoMsg.className = 'small mt-1 text-success fw-bold';
                promoMsg.innerHTML = '<i class="bi bi-check-circle me-1"></i>ใช้โค้ดส่วนลด 50 บาท สำเร็จ!';
            } else {
                appliedDiscount = 0;
                document.getElementById('promoDiscountRow').style.setProperty('display', 'none', 'important');
                document.getElementById('modalFinalPrice').innerText = `${total.toLocaleString()} ฿`;
                promoMsg.className = 'small mt-1 text-danger';
                promoMsg.innerText = 'โค้ดส่วนลดไม่ถูกต้อง หรือหมดอายุ';
            }
        }

        // Confirm Booking Success
        function confirmBookingSuccess() {
            // Close Confirm modal
            const confirmModalEl = document.getElementById('bookingConfirmModal');
            const confirmModal = bootstrap.Modal.getInstance(confirmModalEl);
            if (confirmModal) confirmModal.hide();

            // Populate Success modal
            const randomCode = 'CB-' + currentActiveDate.replace(/-/g, '') + '-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('successBookingCode').innerText = randomCode;
            document.getElementById('successBookingDate').innerText = document.getElementById('modalBookingDate').innerText;

            let slotSummary = [];
            let total = 0;
            selectedSlots.forEach(s => {
                slotSummary.push(`${s.courtName} (${s.timeRange})`);
                total += s.price;
            });
            total = Math.max(0, total - appliedDiscount);

            document.getElementById('successBookingSlots').innerText = slotSummary.join(', ');
            document.getElementById('successBookingAmount').innerText = total.toLocaleString() + ' ฿';

            // Increase Stat counter
            const myBookingsEl = document.getElementById('statMyBookings');
            if (myBookingsEl) {
                myBookingsEl.innerText = parseInt(myBookingsEl.innerText || '0') + 1;
            }

            // Mark slots as booked visually
            selectedSlots.forEach((slot, key) => {
                const el = document.querySelector(`.slot-cell[data-court-id="${slot.courtId}"][data-slot-id="${slot.slotId}"]`);
                if (el) {
                    el.classList.remove('selected');
                    el.classList.add('booked');
                    el.removeAttribute('onclick');
                    el.querySelector('.slot-status-text').innerHTML = '<i class="bi bi-lock-fill me-1"></i>จองแล้ว';
                }
            });

            clearAllSelected();

            // Show Success modal
            setTimeout(() => {
                const successModal = new bootstrap.Modal(document.getElementById('bookingSuccessModal'));
                successModal.show();
            }, 300);
        }

        function showPromoInfo() {
            const modal = new bootstrap.Modal(document.getElementById('customerPromoModal'));
            modal.show();
        }

        // Check hash or date query on load
        window.addEventListener('DOMContentLoaded', () => {
            if (window.location.hash === '#bookingSection' || window.location.search.includes('date=')) {
                setTimeout(scrollToBooking, 250);
            }
        });
    </script>
}
