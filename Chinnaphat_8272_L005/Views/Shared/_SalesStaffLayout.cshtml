<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ฝ่ายซื้อ-เช่าอุปกรณ์ CourtBook</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Font: Sarabun -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        * { font-family: 'Sarabun', sans-serif; }
        body { font-size: 0.95rem; background-color: #f8fafc; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Sarabun', sans-serif; font-weight: 700; }
        
        .sales-navbar {
            background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);
            box-shadow: 0 4px 16px rgba(26, 71, 42, 0.15);
        }
        .nav-pill-custom {
            color: rgba(255, 255, 255, 0.85);
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 10px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }
        .nav-pill-custom:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.18);
        }
        .nav-pill-custom.active {
            color: #1a472a;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }
    </style>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg sales-navbar navbar-dark sticky-top">
        <div class="container-fluid px-4">
            <!-- Brand -->
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-action="Sales" asp-controller="SalesStaff">
                <i class="bi bi-box-seam-fill me-2 fs-4"></i>
                <div>
                    <div class="lh-1">CourtBook Badminton Arena</div>
                    <small class="text-white-50" style="font-size:0.75rem;">ฝ่ายซื้อ-เช่าอุปกรณ์ (Sales & Rental Staff)</small>
                </div>
            </a>

            <!-- Toggle for mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#salesNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Nav Links -->
            <div class="collapse navbar-collapse" id="salesNav">
                @{
                    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                }
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-pill-custom @(action == "Sales" ? "active" : "")" asp-action="Sales" asp-controller="SalesStaff">
                            <i class="bi bi-cart3"></i> ขายสินค้า/เช่า
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-custom @(action == "Stock" ? "active" : "")" asp-action="Stock" asp-controller="SalesStaff">
                            <i class="bi bi-boxes"></i> จัดการสต็อกสินค้า
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-custom @(action == "Rentals" ? "active" : "")" asp-action="Rentals" asp-controller="SalesStaff">
                            <i class="bi bi-arrow-repeat"></i> ตรวจรับคืน & บันทึกชำรุด
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-pill-custom @(action == "Index" ? "active" : "")" asp-action="Index" asp-controller="SalesStaff">
                            <i class="bi bi-speedometer2"></i> แดชบอร์ด
                        </a>
                    </li>
                </ul>

                <!-- User & Role Info + Logout -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-white text-dark fw-bold px-3 py-2 rounded-pill font-monospace" style="font-size:0.78rem;">
                        <i class="bi bi-shield-check text-info me-1"></i> SALES_STAFF
                    </span>

                    <a asp-action="Logout" asp-controller="User" class="btn btn-light btn-sm text-danger fw-semibold px-3" style="border-radius:8px;">
                        <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
