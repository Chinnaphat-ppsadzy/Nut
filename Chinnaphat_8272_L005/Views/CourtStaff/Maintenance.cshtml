@model List<Chinnaphat_8272_L005.Models.CourtBlock>
@{
    Layout = "_CourtStaffLayout";
    ViewData["Title"] = "ล็อกคอร์ทชั่วคราวกรณีซ่อมบำรุง";

    var courts = ViewBag.Courts as List<Chinnaphat_8272_L005.Models.Court> ?? new();
    var timeSlots = ViewBag.TimeSlots as List<Chinnaphat_8272_L005.Models.TimeSlot> ?? new();
    var dailyBookings = ViewBag.DailyBookings as List<Chinnaphat_8272_L005.Models.BookingSlot> ?? new();
    var selectedDate = ViewBag.SelectedDate is DateTime date ? date : DateTime.Today;
}

<div class="row g-4">
    <!-- ================= FORM: บันทึกล็อกคอร์ทชั่วคราว ================= -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 text-white" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);">
                <h5 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-tools me-2 fs-4"></i>ล็อกคอร์ทชั่วคราว (ซ่อมบำรุง)
                </h5>
                <small class="text-white-50">ปิดรับจองเฉพาะช่วงเวลาที่เลือกจากตารางสนาม</small>
            </div>

            <div class="card-body p-4 bg-white">
                <form method="post" asp-action="AddCourtBlock">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            เลือกสนามที่ต้องการล็อก <span class="text-danger">*</span>
                        </label>
                        <select name="courtId" class="form-select" required>
                            @foreach (var c in courts)
                            {
                                <option value="@c.CourtId">@c.CourtName - @c.Description (สถานะ: @c.Status)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            วันที่ล็อกคอร์ท <span class="text-danger">*</span>
                        </label>
                        <input type="date" name="blockDate" class="form-control" value="@DateFormatHelper.ToIsoDate(selectedDate)" min="@DateFormatHelper.ToIsoDate(DateTime.Today)" lang="th-TH" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            รอบเวลาเริ่มต้น <span class="text-danger">*</span>
                        </label>
                        <select name="startSlotId" id="blockStartSlot" class="form-select" required>
                            <option value="">-- เลือกรอบเริ่มต้น --</option>
                            @for (var index = 0; index < timeSlots.Count; index++)
                            {
                                var slot = timeSlots[index];
                                <option value="@slot.SlotId" data-index="@index">@slot.StartTime.ToString("HH:mm")–@slot.EndTime.ToString("HH:mm")</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            รอบเวลาสิ้นสุด <span class="text-danger">*</span>
                        </label>
                        <select name="endSlotId" id="blockEndSlot" class="form-select" required>
                            <option value="">-- เลือกรอบสุดท้าย --</option>
                            @for (var index = 0; index < timeSlots.Count; index++)
                            {
                                var slot = timeSlots[index];
                                <option value="@slot.SlotId" data-index="@index">@slot.StartTime.ToString("HH:mm")–@slot.EndTime.ToString("HH:mm")</option>
                            }
                        </select>
                        <small class="text-muted">คอร์ทจะปิดตั้งแต่รอบเริ่มต้นจนจบรอบสุดท้ายที่เลือก</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            เหตุผลในการล็อกคอร์ท <span class="text-danger">*</span>
                        </label>
                        <select class="form-select mb-2" onchange="document.getElementById('reasonInput').value = this.value">
                            <option value="">-- เลือกเหตุผลทั่วไป --</option>
                            <option value="พื้นยาง BWF หลุดลอก / ซ่อมแซมพื้นผิว">พื้นยาง BWF หลุดลอก / ซ่อมแซมพื้นผิว</option>
                            <option value="ตาข่ายชำรุด / เสาตาข่ายหลวม">ตาข่ายชำรุด / เสาตาข่ายหลวม</option>
                            <option value="ทำความสะอาดใหญ่และฆ่าเชื้อประจำรอบ">ทำความสะอาดใหญ่และฆ่าเชื้อประจำรอบ</option>
                        </select>
                        <textarea name="reason" id="reasonInput" class="form-control" rows="3" maxlength="255" placeholder="ระบุเหตุผลในการล็อกสนาม" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius:10px; background:linear-gradient(135deg, #1a472a, #2d6a4f); border:none;">
                        <i class="bi bi-lock-fill me-1"></i> ล็อกเฉพาะช่วงเวลานี้
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ================= LIST: รายการล็อกคอร์ททั้งหมด ================= -->
    <div class="col-lg-8">
        <!-- สถานะปัจจุบันของแต่ละคอร์ท -->
        <div class="row g-3 mb-4">
            @foreach (var c in courts)
            {
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 bg-white" style="border-radius:14px;">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-dark">@c.CourtName</strong>
                                @if (c.Status == "MAINTENANCE")
                                {
                                    <span class="badge bg-danger">ซ่อมบำรุง</span>
                                }
                                else if (c.Status == "AVAILABLE")
                                {
                                    <span class="badge bg-success">เปิดบริการ</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">ปิดใช้งาน</span>
                                }
                            </div>
                            <small class="text-muted d-block" style="font-size:0.75rem;">@c.Description</small>
                            <small class="text-secondary fw-semibold">@c.PricePerHour.ToString("N0") ฿/ชม.</small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card border-0 shadow-sm mb-4" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar2-week text-success me-2"></i>รายการจองสนามของวันที่เลือก</h5>
                    <small class="text-muted">ตรวจสอบรอบที่มีลูกค้าจองแล้วก่อนกำหนดเวลาซ่อม</small>
                </div>
                <form method="get" asp-action="Maintenance" class="d-flex gap-2 align-items-center">
                    <input type="date" name="date" class="form-control form-control-sm" value="@DateFormatHelper.ToIsoDate(selectedDate)" min="@DateFormatHelper.ToIsoDate(DateTime.Today)" lang="th-TH" onchange="this.form.requestSubmit()" aria-label="เลือกวันที่ดูรายการจอง" />
                    <button type="submit" class="btn btn-sm btn-outline-success text-nowrap"><i class="bi bi-search me-1"></i>ดูวัน</button>
                </form>
            </div>
            @if (dailyBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary"><th>สนาม</th><th>ช่วงเวลาที่จอง</th><th>ลูกค้า</th><th>รหัสจอง</th><th>สถานะ</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var bookingSlot in dailyBookings)
                            {
                                <tr>
                                    <td><span class="badge bg-dark">@(bookingSlot.Court?.CourtName ?? $"Court {bookingSlot.CourtId}")</span></td>
                                    <td class="fw-semibold">@bookingSlot.Slot.StartTime.ToString("HH:mm")–@bookingSlot.Slot.EndTime.ToString("HH:mm")</td>
                                    <td>@(bookingSlot.Booking.User?.FullName ?? "ลูกค้า")</td>
                                    <td class="font-monospace small">@bookingSlot.Booking.BookingCode</td>
                                    <td><span class="badge bg-primary-subtle text-primary">@bookingSlot.Booking.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-calendar-check fs-3 d-block mb-2 text-success"></i>
                    ไม่มีรายการจองในวันที่ @selectedDate.ToString("dd/MM/yyyy")
                </div>
            }
        </div>

        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-cone-striped text-warning me-2"></i>รายการล็อกคอร์ทซ่อมบำรุงทั้งหมด
                    </h5>
                    <small class="text-muted">ตารางการปิดปรับปรุงและล็อกสนามชั่วคราว</small>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> กลับหน้าตารางคอร์ท
                </a>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>สนาม</th>
                                <th>ช่วงเวลาที่ล็อก</th>
                                <th>เหตุผลการซ่อมบำรุง</th>
                                <th>ผู้บันทึก</th>
                                <th>สถานะช่วงเวลา</th>
                                <th class="text-end">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                bool isCurrentlyActive = DateTime.Now >= b.BlockStart && DateTime.Now < b.BlockEnd;
                                bool isPast = DateTime.Now > b.BlockEnd;

                                <tr>
                                    <td>
                                        <span class="badge bg-dark fs-6 px-2 py-1">
                                            @(b.Court?.CourtName ?? $"Court {b.CourtId}")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark small">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i>@b.BlockStart.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        <div class="small text-muted">
                                            ถึง @b.BlockEnd.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <strong class="text-danger small">@b.Reason</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">@(b.CreatedByNavigation?.FullName ?? "เจ้าหน้าที่ดูแลคอร์ท")</small>
                                    </td>
                                    <td>
                                        @if (isCurrentlyActive)
                                        {
                                            <span class="badge bg-danger px-2 py-1">
                                                <i class="bi bi-exclamation-circle-fill me-1"></i> กำลังซ่อมบำรุง
                                            </span>
                                        }
                                        else if (isPast)
                                        {
                                            <span class="badge bg-secondary px-2 py-1">
                                                เสร็จสิ้นแล้ว
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1">
                                                กำหนดการล่วงหน้า
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-action="RemoveCourtBlock" class="d-inline" onsubmit="return confirm('ยืนยันยกเลิกการล็อกเฉพาะช่วงเวลานี้?')">
                                            <input type="hidden" name="blockId" value="@b.BlockId" />
                                            <input type="hidden" name="restoreCourtAvailable" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold" style="border-radius:8px;">
                                                <i class="bi bi-unlock-fill me-1"></i> ปลดล็อกคอร์ท
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                    <h6>ไม่มีรายการล็อกคอร์ทในขณะนี้</h6>
                    <small>สนามทุกคอร์ทพร้อมเปิดให้บริการตามปกติ</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const start = document.getElementById('blockStartSlot');
            const end = document.getElementById('blockEndSlot');
            if (!start || !end) return;
            start.addEventListener('change', () => {
                const startOption = start.selectedOptions[0];
                const startIndex = startOption ? Number(startOption.dataset.index) : -1;
                [...end.options].forEach(option => {
                    const index = Number(option.dataset.index);
                    option.disabled = option.value !== '' && index < startIndex;
                });
                const endOption = end.selectedOptions[0];
                if (!endOption || endOption.value === '' || Number(endOption.dataset.index) < startIndex) {
                    end.value = start.value;
                }
            });
        })();
    </script>
}
