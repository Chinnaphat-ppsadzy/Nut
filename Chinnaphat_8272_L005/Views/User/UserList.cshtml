@model Chinnaphat_8272_L005.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "รายชื่อผู้ใช้งาน";
    Layout = "_AdminLayout";
}

<style>
    .user-table th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6b7280;
        font-weight: 600;
    }

    .user-table td { vertical-align: middle; font-size: 0.92rem; }

    .badge-role {
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        font-weight: 600;
        font-family: 'Sarabun', sans-serif;
        white-space: nowrap;
    }

    .avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2d6a4f, #52b788);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .avatar-new {
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
    }

    .source-badge {
        font-size: 0.68rem;
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
    }

    .stat-card {
        border-radius: 14px;
        border: none;
        transition: transform .15s;
    }

    .stat-card:hover { transform: translateY(-2px); }

    /* ✅ แสดงเบอร์โทรเป็นตัวเลขสากล ไม่เปลี่ยนเป็นเลขไทย */
    .phone-number {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
        font-family: 'Sarabun', 'Roboto', 'Noto Sans', sans-serif;
        letter-spacing: 0.3px;
        direction: ltr;
        unicode-bidi: bidi-override;
    }

    /* ✅ สีสำหรับ badge บทบาท ACCOUNTING */
    .text-purple  { color: #7c3aed !important; }
    .bg-purple    { background-color: #7c3aed !important; }
</style>

@* แสดง Success/Error Message *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" id="alertSuccess">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* แสดงข้อมูลผู้ใช้ที่ล็อกอินอยู่ *@
@if (Model.IsLoggedIn && !string.IsNullOrEmpty(Model.LoggedInUsername))
{
    <div class="alert alert-info border-0 mb-4" style="border-radius:12px; background:#eff6ff;">
        <i class="bi bi-person-check-fill me-2 text-primary"></i>
        กำลังเข้าสู่ระบบในฐานะ: <strong>@Model.LoggedInUsername</strong>
    </div>
}

@* สรุปสถิติ *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card shadow-sm p-3 text-center">
            <div class="fs-2 fw-bold text-success">@Model.TotalUsers</div>
            <div class="text-muted small">ผู้ใช้ทั้งหมด</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm p-3 text-center">
            <div class="fs-2 fw-bold text-primary">@Model.ActiveUsers</div>
            <div class="text-muted small">ใช้งานอยู่</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card shadow-sm p-3 text-center">
            <div class="fs-2 fw-bold text-danger">@Model.AdminCount</div>
            <div class="text-muted small">ผู้ดูแลระบบ</div>
        </div>
    </div>
</div>

<!-- คู่มือ 5 บทบาทผู้ใช้งานในระบบ -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:14px; background:#f8fafc; border:1px solid #e2e8f0 !important;">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#roleGuideCollapse">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <span class="fw-bold text-dark">โครงสร้าง 5 บทบาทในระบบ (ตามสิทธิ์การใช้งาน)</span>
                <span class="badge bg-success-subtle text-success small font-monospace">5 ROLES</span>
            </div>
            <small class="text-muted">คลิกเพื่อดูรายละเอียด <i class="bi bi-chevron-down ms-1"></i></small>
        </div>
        <div class="collapse mt-3" id="roleGuideCollapse">
            <div class="row g-3 pt-2 border-top">
                <div class="col-md-6 col-lg-4">
                    <div class="p-2 bg-white rounded-3 border h-100">
                        <span class="badge-role bg-primary bg-opacity-10 text-primary mb-1 d-inline-block">1. ลูกค้า / สมาชิก (Customer)</span>
                        <ul class="small text-muted ps-3 mb-0" style="font-size:0.8rem;">
                            <li>สมัครสมาชิกและล็อกอินเข้าสู่ระบบ</li>
                            <li>ดูตารางว่างและกดจองคอร์ท</li>
                            <li>เลือกซื้อสินค้าหรือเช่าอุปกรณ์ลงตะกร้า (ระบบคำนวณโปรโมชั่นอัตโนมัติ)</li>
                            <li>อัปโหลดสลิปชำระเงิน และติดตามสถานะการจอง</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-2 bg-white rounded-3 border h-100">
                        <span class="badge-role bg-warning bg-opacity-10 text-warning mb-1 d-inline-block">2. ฝ่ายดูแลคอร์ท (Court Supervisor)</span>
                        <ul class="small text-muted ps-3 mb-0" style="font-size:0.8rem;">
                            <li>ดูตารางการจองประจำวัน (Daily Schedule) เตรียมเปิดไฟ/พัดลม</li>
                            <li>อัปเดตสถานะ Check-in / Check-out เมื่อลูกค้ามาถึง</li>
                            <li>จัดการคิว Walk-in หรือกดล็อกคอร์ทชั่วคราวกรณีซ่อมบำรุง</li>
                            <li>แจ้ง Admin หากอุปกรณ์ในสนามชำรุด</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="p-2 bg-white rounded-3 border h-100">
                        <span class="badge-role bg-info bg-opacity-10 text-info mb-1 d-inline-block">3. ฝ่ายซื้อ-เช่าอุปกรณ์ (Sales & Rental Staff)</span>
                        <ul class="small text-muted ps-3 mb-0" style="font-size:0.8rem;">
                            <li>ดูรายการสินค้า/อุปกรณ์ที่ลูกค้าสั่งจองล่วงหน้า</li>
                            <li>ส่งมอบสินค้าและตรวจรับคืนอุปกรณ์เช่า</li>
                            <li>ตรวจสอบความเสียหายอุปกรณ์ (เช่น ไม้แบดหัก) ส่งเรื่องให้ฝ่ายบัญชีคิดค่าปรับ</li>
                            <li>จัดการสต็อกหน้าร้าน อัปเดตสินค้าคงเหลือรายวัน</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6">
                    <div class="p-2 bg-white rounded-3 border h-100">
                        <span class="badge-role bg-purple bg-opacity-10 text-purple mb-1 d-inline-block">4. ฝ่ายบัญชีและการเงิน (Accounting / Finance)</span>
                        <ul class="small text-muted ps-3 mb-0" style="font-size:0.8rem;">
                            <li>ตรวจสอบความถูกต้องของสลิปโอนเงิน ยอดเงิน และกด "อนุมัติ" ยืนยันคิวให้ลูกค้า</li>
                            <li>ออกใบเสร็จรับเงิน หรือใบกำกับภาษีให้ลูกค้า</li>
                            <li>คิดค่าปรับกรณีอุปกรณ์เสียหาย หรือจัดการคืนเงิน (Refund) กรณีลูกค้ายกเลิก</li>
                            <li>ดูรายงานสรุปยอดขายรายวัน/รายเดือน (แยกค่าสนาม, ค่าสินค้า, ค่าเช่า)</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6">
                    <div class="p-2 bg-white rounded-3 border h-100">
                        <span class="badge-role bg-danger bg-opacity-10 text-danger mb-1 d-inline-block">5. ผู้ดูแลระบบ / เจ้าของคอร์ท (Admin / Owner)</span>
                        <ul class="small text-muted ps-3 mb-0" style="font-size:0.8rem;">
                            <li>จัดการโปรโมชั่น: เปิด-ปิด หรือตั้งค่าเงื่อนไข/ส่วนลดแคมเปญ 5 แบบ</li>
                            <li>จัดการข้อมูลหลัก: เพิ่ม ลบ แก้ไข ข้อมูลคอร์ท สินค้า ราคาสินค้า/เช่า</li>
                            <li>จัดการบุคคล: เพิ่ม ลบ หรือกำหนดสิทธิ์ (Permission) ให้พนักงานแต่ละฝ่าย</li>
                            <li>วิเคราะห์ธุรกิจ: ดู Dashboard สถิติเชิงลึก ภาพรวมรายได้ และช่วงเวลายอดนิยม (Peak Time)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Toolbar *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        แสดงทั้งหมด <strong>@Model.TotalUsers</strong> รายการ
    </span>
    <a asp-action="AddUser" asp-controller="User"
       class="btn btn-success" id="btnAddUser" style="border-radius:10px;">
        <i class="bi bi-person-plus me-1"></i> เพิ่มผู้ใช้
    </a>
</div>

@* Table Card *@
<div class="card border-0 shadow-sm" style="border-radius:14px; overflow:hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 user-table" id="userTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th class="py-3">ชื่อ-นามสกุล / อีเมล</th>
                        <th class="py-3">เบอร์โทร</th>
                        <th class="py-3">บทบาท</th>
                        <th class="py-3">สถานะ</th>
                        <th class="py-3">วันที่สมัคร</th>
                        <th class="py-3 text-center">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="px-4">@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm">
                                        @(user.FullName.Length > 0 ? user.FullName.Substring(0, 1) : "?")
                                    </div>
                                    <div>
                                        <div class="fw-semibold" style="font-size:0.92rem;">@user.FullName</div>
                                        <div class="text-muted" style="font-size:0.78rem;">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="phone-number">@user.Phone</span></td>
                            <td>
                                @{
                                    var roleBadge = user.RoleCode switch {
                                        "ADMIN"       => ("bg-danger bg-opacity-10 text-danger",   "ผู้ดูแลระบบ / เจ้าของคอร์ท (Admin / Owner)"),
                                        "COURT_STAFF" => ("bg-warning bg-opacity-10 text-warning", "ฝ่ายดูแลคอร์ท (Court Supervisor)"),
                                        "SALES_STAFF" => ("bg-info bg-opacity-10 text-info",       "ฝ่ายซื้อ-เช่าอุปกรณ์ (Sales & Rental Staff)"),
                                        "ACCOUNTING"  => ("bg-purple bg-opacity-10 text-purple",   "ฝ่ายบัญชีและการเงิน (Accounting / Finance)"),
                                        "CUSTOMER"    => ("bg-primary bg-opacity-10 text-primary", "ลูกค้า / สมาชิก (Customer)"),
                                        _             => ("bg-secondary bg-opacity-10 text-secondary", user.Role)
                                    };
                                }
                                <span class="badge-role @roleBadge.Item1">@roleBadge.Item2</span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success"
                                          style="border-radius:20px; font-size:0.75rem;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.45rem;"></i>เปิดใช้งาน
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger"
                                          style="border-radius:20px; font-size:0.75rem;">
                                        <i class="bi bi-circle-fill me-1" style="font-size:0.45rem;"></i>ปิดใช้งาน
                                    </span>
                                }
                            </td>
                            <td class="text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="EditUser" asp-controller="User" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary me-1" title="แก้ไข" style="border-radius:8px;">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeleteUser" asp-controller="User" method="post" class="d-inline"
                                      onsubmit="return confirm('ยืนยันการลบผู้ใช้ @user.FullName?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบ" style="border-radius:8px;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
