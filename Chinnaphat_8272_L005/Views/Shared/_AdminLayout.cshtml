@{
    var adminFlashNotifications = new List<object>();
    string? adminSuccessMessage = TempData["SuccessMessage"]?.ToString();
    string? adminErrorMessage = TempData["ErrorMessage"]?.ToString();
    string adminCurrentUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    if (!string.IsNullOrWhiteSpace(adminSuccessMessage))
        adminFlashNotifications.Add(new { type = "flash-success", title = "ทำรายการสำเร็จ", message = adminSuccessMessage, createdAt = DateTime.Now, url = adminCurrentUrl });
    if (!string.IsNullOrWhiteSpace(adminErrorMessage))
        adminFlashNotifications.Add(new { type = "flash-error", title = "เกิดข้อผิดพลาด", message = adminErrorMessage, createdAt = DateTime.Now, url = adminCurrentUrl });
}
<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CourtBook Admin</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Google Fonts: Sarabun (ฟอนต์ภาษาไทย) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
          rel="stylesheet">

    <style>
        * { font-family: 'Sarabun', sans-serif; }
        body { font-size: 1rem; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Sarabun', sans-serif; font-weight: 700; }
        .navbar, .btn, .form-control, .form-select, .badge, .alert, .table {
            font-family: 'Sarabun', sans-serif;
        }
        small, .small { font-size: 0.85rem; }
        .admin-notification-menu { width:min(430px, 94vw); max-height: min(70vh, 620px); overflow:hidden; }
        .admin-notification-list { max-height:calc(min(70vh, 620px) - 112px); overflow-y:auto; }
        .admin-notification-item { white-space:normal; }
        .admin-notification-item:hover { background:#f0fdf4; }
    </style>

</head>
<body class="bg-light">


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-dark shadow-sm" style="background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%);">

        <div class="container-fluid">

            <div class="d-flex align-items-center">
                <a class="navbar-brand fw-bold mb-0"
                   asp-action="Admin" asp-controller="Home">
                    <i class="bi bi-shield-check me-2"></i>
                    CourtBook Admin
                </a>
                <span class="badge bg-white text-success font-monospace d-none d-sm-inline-block">ระบบหลังบ้าน (ADMIN)</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center text-white ps-2">
                    <i class="bi bi-person-circle fs-4 me-2"></i>
                    <div>
                        <div class="fw-semibold lh-1">Admin</div>
                        <small class="text-white-50" style="font-size:0.75rem;">ผู้ดูแลระบบ</small>
                    </div>
                </div>
            </div>

        </div>

    </nav>



    <!-- ================= MAIN ================= -->

    <div class="container-fluid">

        <div class="row">


            <!-- ================= SIDEBAR ================= -->

            <aside class="col-md-3 col-lg-2 bg-white border-end min-vh-100 p-3">


                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-shield-lock me-1 text-success"></i>เมนูจัดการระบบหลังบ้าน (Admin)
                </div>

                @{
                    string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }

                <!-- Dashboard -->
                <a asp-action="Admin" asp-controller="Home"
                   class="btn @((currentCtrl == "Home" && currentAct == "Admin") || (currentCtrl == "Admin" && (currentAct == "Dashboard" || currentAct == "Index")) ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard ภาพรวม
                </a>

                <!-- Court -->
                <a asp-action="Court" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Court" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-building me-2"></i>
                    จัดการสนาม
                </a>

                <!-- Promotion -->
                <a asp-action="Promotion" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Promotion" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-ticket-perforated me-2"></i>
                    จัดการโปรโมชั่น
                </a>

                <!-- Product -->
                <a asp-action="Product" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "Product" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-box-seam me-2"></i>
                    สินค้าและอุปกรณ์
                </a>

                <!-- Court Issues -->
                <a asp-action="CourtIssues" asp-controller="Admin"
                   class="btn @(currentCtrl == "Admin" && currentAct == "CourtIssues" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-exclamation-triangle me-2 text-success"></i>
                    แจ้งซ่อม/อุปกรณ์ชำรุด
                </a>

                <hr />

                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-people me-1 text-success"></i>จัดการบุคลากร
                </div>

                <!-- Employee -->
                <a asp-action="UserList" asp-controller="User"
                   class="btn @(currentCtrl == "User" && currentAct == "UserList" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-people me-2"></i>
                    รายชื่อผู้ใช้
                </a>

                <!-- AddUser -->
                <a asp-action="AddUser" asp-controller="User"
                   class="btn @(currentCtrl == "User" && currentAct == "AddUser" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-person-plus me-2"></i>
                    เพิ่มผู้ใช้
                </a>

                <hr />

                <!-- Logout -->
                <a asp-action="Logout" asp-controller="User"
                   class="btn btn-outline-danger w-100 text-start">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    ออกจากระบบ
                </a>


            </aside>



            <!-- ================= CONTENT ================= -->

            <main class="col-md-9 col-lg-10 p-4">


                <!-- Page Header -->

                <div class="d-flex justify-content-between
                            align-items-center mb-4">

                    <div>

                        <h2 class="fw-bold mb-1">

                            @ViewData["Title"]

                        </h2>

                        <p class="text-muted mb-0">

                            ระบบจัดการสนามกีฬาออนไลน์

                        </p>

                    </div>


                    <div class="dropdown">
                        <button class="btn btn-outline-success position-relative" id="adminNotificationsButton" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="เปิดการแจ้งเตือนของผู้ดูแลระบบ"
                                title="การแจ้งเตือนของผู้ดูแลระบบ">
                            <i class="bi bi-bell"></i>
                            <span id="adminNotificationsBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-0 admin-notification-menu" aria-labelledby="adminNotificationsButton">
                            <div class="d-flex justify-content-between align-items-center px-3 py-3 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">แจ้งเตือนผู้ดูแลระบบ</div>
                                    <small class="text-muted">รายการที่ต้องดูแลในระบบหลังบ้าน</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-light text-success" id="refreshAdminNotifications" title="รีเฟรชการแจ้งเตือน" aria-label="รีเฟรชการแจ้งเตือน">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div id="adminNotificationsList" class="admin-notification-list p-2">
                                <div class="text-center text-muted small p-4">กำลังโหลดการแจ้งเตือน...</div>
                            </div>
                            <a class="d-block text-center border-top p-2 small fw-semibold text-success text-decoration-none" asp-action="Admin" asp-controller="Home">
                                เปิดแดชบอร์ดผู้ดูแลระบบ <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>

                </div>



                <!-- Page Content -->

                @RenderBody()


            </main>


        </div>

    </div>



    <!-- ================= FOOTER ================= -->

    <footer class="bg-white border-top text-center text-muted py-2">

        <small>

            © 2026 CourtBook
            | ระบบจองสนามกีฬาออนไลน์

        </small>

    </footer>
    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    <script>
        const adminFlashNotifications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(adminFlashNotifications));

        async function refreshAdminNotifications() {
            const list = document.getElementById('adminNotificationsList');
            const badge = document.getElementById('adminNotificationsBadge');
            if (!list || !badge) return;

            try {
                const response = await fetch(`/Admin/Notifications?_=${Date.now()}`, {
                    cache: 'no-store',
                    headers: { 'Accept': 'application/json' }
                });
                if (!response.ok) throw new Error('โหลดรายการแจ้งเตือนไม่สำเร็จ');
                const data = await response.json();
                // Keep this client-side allowlist as a safeguard if an older
                // server response or cached payload still contains other teams' work.
                const adminTypes = new Set(['issue', 'stock', 'court']);
                const adminItems = (data.items || []).filter(item => adminTypes.has(item.type));
                const allNotifications = [...adminFlashNotifications, ...adminItems]
                    .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
                const count = allNotifications.length;
                badge.textContent = count > 99 ? '99+' : String(count);
                badge.classList.toggle('d-none', count === 0);
                list.replaceChildren();

                if (allNotifications.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'text-center text-muted small p-4';
                    empty.innerHTML = '<i class="bi bi-check-circle text-success fs-4 d-block mb-2"></i>ไม่มีรายการค้างที่ต้องติดตาม';
                    list.appendChild(empty);
                    return;
                }

                const icons = { payment: 'bi-receipt', issue: 'bi-tools', damage: 'bi-exclamation-triangle', refund: 'bi-arrow-counterclockwise', stock: 'bi-box-seam', court: 'bi-building', 'flash-success': 'bi-check-circle', 'flash-error': 'bi-exclamation-circle' };
                allNotifications.forEach(item => {
                    const link = document.createElement('a');
                    link.className = 'dropdown-item admin-notification-item rounded-3 px-2 py-2 d-flex gap-2 align-items-start';
                    link.href = item.url || '#';

                    const icon = document.createElement('span');
                    icon.className = `${item.type === 'flash-error' ? 'text-danger' : 'text-success'} pt-1`;
                    const iconElement = document.createElement('i');
                    iconElement.className = `bi ${icons[item.type] || 'bi-bell'}`;
                    icon.appendChild(iconElement);

                    const content = document.createElement('span');
                    content.className = 'flex-grow-1';
                    const title = document.createElement('span');
                    title.className = `d-block fw-semibold ${item.type === 'flash-error' ? 'text-danger' : 'text-dark'} small`;
                    title.textContent = item.title || 'แจ้งเตือน';
                    const message = document.createElement('span');
                    message.className = 'd-block text-muted small';
                    message.textContent = item.message || '';
                    const time = document.createElement('small');
                    time.className = 'd-block text-secondary mt-1';
                    const date = item.createdAt ? new Date(item.createdAt) : null;
                    time.textContent = date && !Number.isNaN(date.getTime()) ? date.toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' }) : '';
                    content.append(title, message, time);
                    link.append(icon, content);
                    list.appendChild(link);
                });
            } catch (error) {
                list.innerHTML = '<div class="text-center text-danger small p-4">ไม่สามารถโหลดการแจ้งเตือนได้ กรุณาลองใหม่</div>';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshAdminNotifications();
            document.getElementById('adminNotificationsButton')?.addEventListener('shown.bs.dropdown', refreshAdminNotifications);
            document.getElementById('refreshAdminNotifications')?.addEventListener('click', refreshAdminNotifications);
            window.setInterval(refreshAdminNotifications, 60000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
