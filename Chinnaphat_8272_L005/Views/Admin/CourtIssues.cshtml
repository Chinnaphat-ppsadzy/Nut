@model List<Chinnaphat_8272_L005.Models.CourtIssue>
@{
    ViewData["Title"] = "แจ้งซ่อม/อุปกรณ์ชำรุด (จากฝ่ายดูแลคอร์ท)";
    Layout = "_AdminLayout";

    int pendingCount = ViewBag.PendingCount ?? 0;
    int inProgressCount = ViewBag.InProgressCount ?? 0;
    int resolvedCount = ViewBag.ResolvedCount ?? 0;
    var courts = ViewBag.Courts as List<Chinnaphat_8272_L005.Models.Court> ?? new();
    var timeSlots = ViewBag.TimeSlots as List<Chinnaphat_8272_L005.Models.TimeSlot> ?? new();
    var defaultRepairDate = DateTime.Today;
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:18px; background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 60%, #52b788 100%); color:white;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-wrench-adjustable me-2"></i>รายการแจ้งซ่อม / อุปกรณ์ชำรุดในสนาม
                </h4>
                <p class="mb-0 text-white-50 small">
                    Admin ตรวจสอบเหตุผลก่อนรับเรื่อง และกำหนดช่วงเวลาปิดคอร์ทเท่าที่จำเป็น
                </p>
            </div>
        </div>
    </div>
</div>

<!-- สถิติการแจ้งซ่อม -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning" style="border-radius:14px;">
            <div class="card-body p-3">
                <div class="small text-muted mb-1"><i class="bi bi-hourglass-split me-1 text-warning"></i>รอ Admin รับเรื่อง</div>
                <h3 class="fw-bold mb-0 text-warning">@pendingCount</h3>
                <small class="text-muted">รอดำเนินการ</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-info" style="border-radius:14px;">
            <div class="card-body p-3">
                <div class="small text-muted mb-1"><i class="bi bi-tools me-1 text-info"></i>กำลังดำเนินการแก้ไข</div>
                <h3 class="fw-bold mb-0 text-info">@inProgressCount</h3>
                <small class="text-muted">กำลังซ่อมแซม</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-success" style="border-radius:14px;">
            <div class="card-body p-3">
                <div class="small text-muted mb-1"><i class="bi bi-check-circle me-1 text-success"></i>ซ่อมแซมเสร็จสิ้น</div>
                <h3 class="fw-bold mb-0 text-success">@resolvedCount</h3>
                <small class="text-muted">ปิดเรื่องแล้ว</small>
            </div>
        </div>
    </div>
</div>

<!-- ตารางรายการแจ้งซ่อม -->
<div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-task me-2 text-danger"></i>รายการที่แจ้งเข้ามาทั้งหมด (@Model.Count เรื่อง)
        </h5>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-secondary">
                        <th>รหัสเรื่อง</th>
                        <th>สนาม / บริเวณ</th>
                        <th>รายละเอียดอุปกรณ์ชำรุด</th>
                        <th>ผู้แจ้ง (ฝ่ายดูแลคอร์ท)</th>
                        <th>วันที่แจ้ง</th>
                        <th>สถานะ</th>
                        <th class="text-end">การจัดการ (Admin)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr id="issue-@i.IssueId">
                            <td>
                                <strong class="font-monospace text-primary">#ISSUE-@i.IssueId.ToString("D3")</strong>
                            </td>
                            <td>
                                @if (i.Court != null)
                                {
                                    <span class="badge bg-dark fs-6 px-2 py-1">@i.Court.CourtName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">ส่วนกลาง / ทั่วไป</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark small" style="max-width:300px;">
                                    @i.Description
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@(i.ReportedByNavigation?.FullName ?? "ฝ่ายดูแลคอร์ท")</small>
                            </td>
                            <td>
                                <small class="text-muted">@i.CreatedAt.ToString("dd/MM/yyyy HH:mm น.")</small>
                            </td>
                            <td>
                                @switch (i.Status?.ToUpper())
                                {
                                    case "RESOLVED":
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> ซ่อมเสร็จสิ้น
                                        </span>
                                        break;
                                    case "IN_PROGRESS":
                                        <span class="badge bg-info text-dark px-2 py-1">
                                            <i class="bi bi-tools me-1"></i> กำลังซ่อมแซม
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-warning text-dark px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> รอดำเนินการ
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-success me-1" type="button" data-bs-toggle="collapse" data-bs-target="#edit-issue-@i.IssueId" aria-expanded="false">
                                    <i class="bi bi-pencil-square me-1"></i>แก้ไข
                                </button>
                                @if (i.Status == "OPEN")
                                {
                                    @if (i.CourtId.HasValue)
                                    {
                                        <button class="btn btn-sm btn-info text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#schedule-issue-@i.IssueId">
                                            <i class="bi bi-calendar2-check me-1"></i>รับเรื่องและกำหนดเวลาซ่อม
                                        </button>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="UpdateIssueStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="issueId" value="@i.IssueId" />
                                            <input type="hidden" name="status" value="IN_PROGRESS" />
                                            <button type="submit" class="btn btn-sm btn-info text-dark fw-bold">
                                                <i class="bi bi-wrench me-1"></i>รับเรื่อง (ส่วนกลาง)
                                            </button>
                                        </form>
                                    }
                                }
                                else if (i.Status == "IN_PROGRESS")
                                {
                                    <form method="post" asp-action="UpdateIssueStatus" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="issueId" value="@i.IssueId" />
                                        <input type="hidden" name="status" value="RESOLVED" />
                                        <button type="submit" class="btn btn-sm btn-success fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i> ซ่อมแซมเสร็จสิ้น
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        แก้ไขโดย @(i.ResolvedByNavigation?.FullName ?? "Admin")
                                    </span>
                                }
                            </td>
                        </tr>
                        <tr class="collapse bg-light" id="edit-issue-@i.IssueId">
                            <td colspan="7" class="p-3">
                                <form method="post" asp-action="UpdateCourtIssue" class="row g-2 align-items-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="issueId" value="@i.IssueId" />
                                    <div class="col-md-3">
                                        <label class="form-label small">สนาม / บริเวณ</label>
                                        <select name="courtId" class="form-select form-select-sm">
                                            <option value="">ส่วนกลาง / อุปกรณ์ทั่วไป</option>
                                            @foreach (var court in courts)
                                            {
                                                <option value="@court.CourtId" selected="@(i.CourtId == court.CourtId)">@court.CourtName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-7">
                                        <label class="form-label small">รายละเอียดปัญหา</label>
                                        <textarea name="description" class="form-control form-control-sm" rows="2" required maxlength="500">@i.Description</textarea>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-success btn-sm w-100"><i class="bi bi-save me-1"></i>บันทึกการแก้ไข</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        @if (i.Status == "OPEN" && i.CourtId.HasValue)
                        {
                            <tr class="collapse bg-success-subtle" id="schedule-issue-@i.IssueId">
                                <td colspan="7" class="p-3">
                                    <form method="post" asp-action="UpdateIssueStatus" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="issueId" value="@i.IssueId" />
                                        <input type="hidden" name="status" value="IN_PROGRESS" />
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">วันที่ซ่อม</label>
                                            <input type="date" name="blockDate" class="form-control form-control-sm" value="@DateFormatHelper.ToIsoDate(defaultRepairDate)" min="@DateFormatHelper.ToIsoDate(defaultRepairDate)" lang="th-TH" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">รอบเวลาเริ่มต้น</label>
                                            <select name="startSlotId" class="form-select form-select-sm" required>
                                                @for (var slotIndex = 0; slotIndex < timeSlots.Count; slotIndex++)
                                                {
                                                    var slot = timeSlots[slotIndex];
                                                    <option value="@slot.SlotId" data-index="@slotIndex">@slot.StartTime.ToString("HH:mm")–@slot.EndTime.ToString("HH:mm")</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">รอบเวลาสิ้นสุด</label>
                                            <select name="endSlotId" class="form-select form-select-sm" required>
                                                @for (var slotIndex = 0; slotIndex < timeSlots.Count; slotIndex++)
                                                {
                                                    var slot = timeSlots[slotIndex];
                                                    <option value="@slot.SlotId" data-index="@slotIndex">@slot.StartTime.ToString("HH:mm")–@slot.EndTime.ToString("HH:mm")</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 small text-muted">ปิดตั้งแต่รอบเริ่มต้นจนจบรอบสุดท้ายที่เลือก</div>
                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-success btn-sm w-100"><i class="bi bi-check-circle me-1"></i>ยืนยันรับเรื่อง</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
            <h6>ไม่มีรายการแจ้งอุปกรณ์ชำรุด</h6>
            <small>ระบบสนามและอุปกรณ์ทุกชิ้นทำงานได้ตามปกติ</small>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('tr[id^="schedule-issue-"]').forEach(row => {
            const start = row.querySelector('select[name="startSlotId"]');
            const end = row.querySelector('select[name="endSlotId"]');
            if (!start || !end) return;
            start.addEventListener('change', () => {
                const startIndex = Number(start.selectedOptions[0]?.dataset.index ?? -1);
                [...end.options].forEach(option => {
                    const index = Number(option.dataset.index);
                    option.disabled = option.value !== '' && index < startIndex;
                });
                const endIndex = Number(end.selectedOptions[0]?.dataset.index ?? -1);
                if (end.value === '' || endIndex < startIndex) end.value = start.value;
            });
        });
    </script>
}
