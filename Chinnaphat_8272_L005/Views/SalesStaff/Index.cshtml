@model List<Chinnaphat_8272_L005.Models.Product>

@{
    ViewData["Title"] = "แดชบอร์ดฝ่ายซื้อ-เช่าอุปกรณ์ (Sales Staff)";
    Layout = "_SalesStaffLayout";
}

<style>
    .sales-hero-banner {
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 50%, #14b8a6 100%);
        border-radius: 18px;
        padding: 2rem;
        color: white;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(15, 118, 110, 0.12);
    }
    .action-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        padding: 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        text-decoration: none;
        color: inherit;
        display: block;
        height: 100%;
    }
    .action-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(15, 118, 110, 0.15);
        border-color: #0d9488;
        color: inherit;
    }
    .action-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }
</style>

<!-- Banner -->
<div class="sales-hero-banner">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark font-monospace fw-bold">SALES & RENTAL STAFF</span>
                <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;">CourtBook Badminton Arena</span>
            </div>
            <h3 class="fw-bold mb-1">ยินดีต้อนรับสู่ระบบฝ่ายซื้อ-เช่าอุปกรณ์</h3>
            <p class="mb-0 opacity-75 small">
                ระบบจัดการขายสินค้าหน้าร้าน , ตรวจนับสต็อก และบริหารจัดการอุปกรณ์ให้เช่าประจำวัน
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Sales" class="btn btn-warning fw-bold text-dark px-4 py-2 shadow-sm" style="border-radius:10px;">
                <i class="bi bi-cart3 me-1"></i> เปิดหน้าขายสินค้า
            </a>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#f0fdfa; color:#0d9488; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@ViewBag.TotalProducts</h4>
                    <small class="text-muted">สินค้าทั้งหมดในระบบ</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-primary">@ViewBag.SaleProductsCount</h4>
                    <small class="text-muted">สินค้าขาย (SALE)</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-warning">@ViewBag.RentProductsCount</h4>
                    <small class="text-muted">อุปกรณ์เช่า (RENT)</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px; height:48px; border-radius:12px; background:#fef2f2; color:#ef4444; display:flex; align-items:center; justify-content:center; font-size:1.4rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-danger">@ViewBag.LowStockCount</h4>
                    <small class="text-muted">สต็อกเหลือน้อย (&le; 5)</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Action Cards -->
<div class="row g-4 mb-4">
    <!-- 1. POS SALES -->
    <div class="col-md-4">
        <a asp-action="Sales" class="action-card">
            <div class="action-icon" style="background:#f0fdfa; color:#0d9488;">
                <i class="bi bi-cart3"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">ขายสินค้า & ให้เช่าอุปกรณ์</h5>
            <p class="text-muted small mb-0">
                หน้าจอแคชเชียร์หน้าร้านสำหรับคิดเงิน ตัดสต็อกอัตโนมัติ และคำนวณโปรโมชั่นส่วนลด (ลูกแบด, เครื่องดื่ม, ไม้แบด, รองเท้า)
            </p>
            <div class="mt-3 text-teal fw-bold small" style="color:#0d9488;">
                ไปหน้าขายสินค้า <i class="bi bi-arrow-right ms-1"></i>
            </div>
        </a>
    </div>

    <!-- 2. STOCK MANAGEMENT -->
    <div class="col-md-4">
        <a asp-action="Stock" class="action-card">
            <div class="action-icon" style="background:#eff6ff; color:#2563eb;">
                <i class="bi bi-boxes"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">จัดการสต็อกหน้าร้าน (Stock)</h5>
            <p class="text-muted small mb-0">
                ตรวจนับสินค้าคงเหลือรายวัน อัปเดตจำนวนสต็อก และดูรายการสินค้าทั้งหมดในรูปแบบตารางพร้อมระบบแบ่งหน้า
            </p>
            <div class="mt-3 text-primary fw-bold small">
                ไปหน้าจัดการสต็อก <i class="bi bi-arrow-right ms-1"></i>
            </div>
        </a>
    </div>

    <!-- 3. RENTAL RETURNS -->
    <div class="col-md-4">
        <a asp-action="Rentals" class="action-card">
            <div class="action-icon" style="background:#fef3c7; color:#d97706;">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">ส่งมอบ & รับคืนอุปกรณ์เช่า</h5>
            <p class="text-muted small mb-0">
                ตรวจสภาพอุปกรณ์เช่าหลังลูกค้าส่งคืน หากพบการชำรุดเสียหายสามารถกดบันทึกเพื่อส่งเรื่องให้ฝ่ายบัญชีคิดค่าปรับ
            </p>
            <div class="mt-3 text-warning fw-bold small">
                ไปหน้าตรวจรับคืน <i class="bi bi-arrow-right ms-1"></i>
            </div>
        </a>
    </div>
</div>
