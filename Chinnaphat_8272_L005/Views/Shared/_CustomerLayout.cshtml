<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CourtBook</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Google Fonts: Sarabun (ฟอนต์ภาษาไทย) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
          rel="stylesheet">

    <style>
        * { font-family: 'Sarabun', sans-serif; }
        body { font-size: 1rem; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Sarabun', sans-serif; font-weight: 700; }
        .navbar, .btn, .form-control, .form-select, .badge, .alert, .table {
            font-family: 'Sarabun', sans-serif;
        }
        small, .small { font-size: 0.85rem; }
    </style>

</head>


<body class="bg-light">


    <div class="container-fluid">

        <div class="row">


            <!-- ================= SIDEBAR ================= -->

            <aside class="col-md-3 col-lg-2 bg-white border-end min-vh-100 p-3">


                <!-- Logo -->

                <div class="mb-4">

                    <h4 class="fw-bold text-success">

                        <i class="bi bi-dribbble me-2"></i>

                        CourtBook

                    </h4>

                    <small class="text-muted">

                        ระบบจองสนามกีฬาออนไลน์

                    </small>

                </div>


                <!-- Menu -->

                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-person me-1 text-success"></i>เมนูสำหรับลูกค้า (Customer)
                </div>

                @{
                    string curAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string curCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }

                <!-- Dashboard / Home -->
                <a asp-action="Customer" asp-controller="Home"
                   class="btn @(curCtrl == "Home" && curAct == "Customer" ? "btn-success" : "btn-light") w-100 text-start mb-2">
                    <i class="bi bi-house-door me-2"></i>
                    หน้าหลัก
                </a>

                <!-- จองสนาม -->
                <a href="/Home/Customer#bookingSection"
                   class="btn btn-light w-100 text-start mb-2">
                    <i class="bi bi-calendar-plus me-2 text-success"></i>
                    จองสนามแบดมินตัน
                </a>

                <!-- โปรโมชั่น -->
                <a href="javascript:void(0)" onclick="if(window.showPromoInfo){showPromoInfo();}else{window.location.href='/Home/Customer';}"
                   class="btn btn-light w-100 text-start mb-2">
                    <i class="bi bi-ticket-perforated me-2 text-warning"></i>
                    ดูโปรโมชั่นที่ใช้ได้
                </a>

                <hr />

                <!-- Account -->
                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-person-circle me-1 text-primary"></i>บัญชีผู้ใช้งาน
                </div>

                <!-- Login -->
                <a asp-action="Login" asp-controller="User"
                   class="btn btn-outline-success w-100 mb-2 text-start">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    เข้าสู่ระบบ
                </a>

                <!-- Register -->
                <a asp-action="Register" asp-controller="User"
                   class="btn btn-success w-100 mb-3 text-start">
                    <i class="bi bi-person-plus me-2"></i>
                    สมัครสมาชิก
                </a>

                <hr />

                <!-- Admin Section -->
                <div class="text-secondary small fw-bold mb-3">
                    <i class="bi bi-shield-lock me-1 text-danger"></i>สำหรับผู้ดูแลระบบ
                </div>

                <a asp-action="Admin" asp-controller="Home"
                   class="btn btn-outline-dark w-100 text-start mb-2" style="font-size:0.9rem;">
                    <i class="bi bi-speedometer2 me-2 text-success"></i>
                    ไปยังระบบหลังบ้าน (Admin)
                </a>

                <a asp-action="Promotion" asp-controller="Admin"
                   class="btn btn-light border w-100 text-start mb-2 text-muted" style="font-size:0.85rem;">
                    <i class="bi bi-ticket-perforated me-2 text-warning"></i>
                    ระบบจัดการโปรโมชั่น
                </a>

                <a asp-action="Index" asp-controller="Home"
                   class="btn btn-light w-100 text-start mb-2 text-muted" style="font-size:0.85rem;">
                    <i class="bi bi-grid me-2"></i>
                    หน้าเลือกระบบ (Home)
                </a>


            </aside>



            <!-- ================= MAIN ================= -->

            <main class="col-md-9 col-lg-10 p-0">


                <!-- ================= TOPBAR ================= -->

                <nav class="navbar bg-white border-bottom shadow-sm px-4">

                    <div class="d-flex align-items-center">
                        <span class="fw-bold text-dark fs-6">
                            @ViewData["Title"]
                        </span>
                        <span class="badge bg-success-subtle text-success ms-2 font-monospace d-none d-sm-inline-block">หน้าระบบลูกค้า (Customer Portal)</span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <a asp-action="Admin" asp-controller="Home" class="btn btn-sm btn-outline-dark fw-semibold">
                            <i class="bi bi-shield-lock me-1 text-success"></i> ระบบหลังบ้าน Admin
                        </a>

                        <div class="d-flex align-items-center border-start ps-3">
                            <i class="bi bi-person-circle fs-4 text-success me-2"></i>
                            <div>
                                <div class="fw-semibold lh-1">Customer</div>
                                <small class="text-muted" style="font-size:0.75rem;">ผู้ใช้งาน</small>
                            </div>
                        </div>
                    </div>

                </nav>



                <!-- ================= CONTENT ================= -->

                <div class="p-4">

                    @RenderBody()

                </div>



                <!-- ================= FOOTER ================= -->

                <footer class="bg-white border-top text-center text-muted py-2">

                    <small>

                        © 2026 CourtBook
                        | ระบบจองสนามกีฬาออนไลน์

                    </small>

                </footer>


            </main>


        </div>

    </div>



    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
