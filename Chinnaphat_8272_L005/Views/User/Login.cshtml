@model Chinnaphat_8272_L005.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = null; @* หน้า Login ไม่ใช้ Layout *@
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เข้าสู่ระบบ - CourtBook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Sarabun', sans-serif; }

        body {
            background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 40%, #52b788 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: rgba(255,255,255,0.95);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            overflow: hidden;
            max-width: 440px;
            width: 100%;
        }

        .login-header {
            background: linear-gradient(135deg, #2d6a4f, #52b788);
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            color: white;
        }

        .login-header .logo-icon {
            font-size: 3.5rem;
            margin-bottom: 0.5rem;
        }

        .login-header h1 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .login-header p {
            font-size: 0.9rem;
            opacity: 0.85;
            margin: 0;
        }

        .login-body {
            padding: 2.5rem 2rem;
        }

        .form-label {
            font-weight: 600;
            color: #2d3748;
            font-size: 0.9rem;
        }

        .form-control {
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.65rem 1rem 0.65rem 2.8rem;
            font-size: 0.95rem;
            transition: all 0.25s;
        }

        .form-control:focus {
            border-color: #52b788;
            box-shadow: 0 0 0 3px rgba(82,183,136,0.2);
        }

        .input-wrapper {
            position: relative;
            margin-bottom: 1.2rem;
        }

        .input-wrapper .bi {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #52b788;
            font-size: 1.1rem;
            pointer-events: none;
        }

        .input-wrapper .toggle-password {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            cursor: pointer;
            pointer-events: all;
        }

        .btn-login {
            background: linear-gradient(135deg, #2d6a4f, #52b788);
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.25s;
            letter-spacing: 0.5px;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #1a472a, #2d6a4f);
            transform: translateY(-1px);
            box-shadow: 0 5px 20px rgba(45,106,79,0.4);
            color: white;
        }

        .login-footer {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.9rem;
            color: #718096;
        }

        .login-footer a {
            color: #2d6a4f;
            font-weight: 600;
            text-decoration: none;
        }

        .login-footer a:hover { text-decoration: underline; }

        .divider {
            border: none;
            border-top: 1px solid #e2e8f0;
            margin: 1.5rem 0;
        }

        .alert { border-radius: 10px; }
    </style>
</head>
<body>

<div class="login-card">

    <!-- Header -->
    <div class="login-header">
        <div class="logo-icon"><i class="bi bi-dribbble"></i></div>
        <h1>CourtBook</h1>
        <p>ระบบจองสนามกีฬาออนไลน์</p>
    </div>

    <!-- Body -->
    <div class="login-body">

        <h5 class="fw-bold mb-1 text-center" style="color:#1a472a;">เข้าสู่ระบบ</h5>
        <p class="text-center text-muted mb-4" style="font-size:0.88rem;">กรุณากรอกข้อมูลเพื่อเข้าสู่ระบบ</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Login" asp-controller="User" method="post" id="loginForm">
            @Html.AntiForgeryToken()

            <!-- Username -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label">ชื่อผู้ใช้</label>
                <div class="input-wrapper">
                    <i class="bi bi-person-fill"></i>
                    <input asp-for="Username" class="form-control" id="loginUsername"
                           placeholder="กรอกชื่อผู้ใช้" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Password" class="form-control" id="loginPassword"
                           placeholder="กรอกรหัสผ่าน" autocomplete="current-password" />
                    <i class="bi bi-eye toggle-password" id="toggleLoginPwd" onclick="togglePwd('loginPassword','toggleLoginPwd')"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Remember me -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" type="checkbox">
                    <label class="form-check-label" for="rememberMe" style="font-size:0.88rem;">จดจำฉัน</label>
                </div>
                <a href="#" style="font-size:0.88rem; color:#2d6a4f; text-decoration:none; font-weight:600;">ลืมรหัสผ่าน?</a>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-login" id="btnLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i>เข้าสู่ระบบ
            </button>
        </form>

        <hr class="divider">

        <div class="login-footer">
            ยังไม่มีบัญชี?
            <a asp-action="Register" asp-controller="User">สมัครสมาชิก</a>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    function togglePwd(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
</script>

</body>
</html>
