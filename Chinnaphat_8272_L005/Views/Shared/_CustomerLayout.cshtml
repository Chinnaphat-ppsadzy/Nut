<!DOCTYPE html>
<html lang="th">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CourtBook</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>


<body class="bg-light">


    <div class="container-fluid">

        <div class="row">


            <!-- ================= SIDEBAR ================= -->

            <aside class="col-md-3 col-lg-2 bg-white border-end min-vh-100 p-3">


                <!-- Logo -->

                <div class="mb-4">

                    <h4 class="fw-bold text-success">

                        <i class="bi bi-dribbble me-2"></i>

                        CourtBook

                    </h4>

                    <small class="text-muted">

                        ระบบจองสนามกีฬาออนไลน์

                    </small>

                </div>


                <!-- Menu -->

                <div class="text-secondary small fw-bold mb-3">

                    เมนูหลัก

                </div>


                <!-- Dashboard / Home -->

                <a href="/Home/Customer"
                   class="btn btn-success w-100 text-start mb-2">

                    <i class="bi bi-house-door me-2"></i>

                    หน้าหลัก

                </a>


                <!-- สนามกีฬา -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-building me-2"></i>

                    สนามกีฬา

                </a>


                <!-- จองสนาม -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-calendar-plus me-2"></i>

                    จองสนาม

                </a>


                <!-- การจอง -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-calendar-check me-2"></i>

                    การจองของฉัน

                </a>


                <hr />


                <!-- Account -->

                <div class="text-secondary small fw-bold mb-3">

                    บัญชีของฉัน

                </div>


                <!-- Profile -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-person me-2"></i>

                    โปรไฟล์

                </a>


                <!-- History -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-clock-history me-2"></i>

                    ประวัติการจอง

                </a>


                <!-- Promotion -->

                <a href="#"
                   class="btn btn-light w-100 text-start mb-2">

                    <i class="bi bi-ticket-perforated me-2"></i>

                    โปรโมชั่น

                </a>


                <hr />


                <!-- Login -->

                <a asp-action="Login" asp-controller="User"
                   class="btn btn-outline-success w-100 mb-2">

                    <i class="bi bi-box-arrow-in-right me-2"></i>

                    เข้าสู่ระบบ

                </a>


                <!-- Register -->

                <a asp-action="Register" asp-controller="User"
                   class="btn btn-success w-100">

                    <i class="bi bi-person-plus me-2"></i>

                    สมัครสมาชิก

                </a>


            </aside>



            <!-- ================= MAIN ================= -->

            <main class="col-md-9 col-lg-10 p-0">


                <!-- ================= TOPBAR ================= -->

                <nav class="navbar bg-white border-bottom shadow-sm px-4">


                    <div>

                        <span class="fw-semibold">

                            @ViewData["Title"]

                        </span>

                    </div>


                    <div class="d-flex align-items-center">


                        <button class="btn btn-light me-3">

                            <i class="bi bi-bell"></i>

                        </button>


                        <div class="d-flex align-items-center">

                            <i class="bi bi-person-circle fs-4 text-success me-2"></i>

                            <div>

                                <div class="fw-semibold">

                                    Customer

                                </div>

                                <small class="text-muted">

                                    ผู้ใช้งาน

                                </small>

                            </div>

                        </div>


                    </div>


                </nav>



                <!-- ================= CONTENT ================= -->

                <div class="p-4">

                    @RenderBody()

                </div>



                <!-- ================= FOOTER ================= -->

                <footer class="bg-white border-top text-center text-muted py-2">

                    <small>

                        © 2026 CourtBook
                        | ระบบจองสนามกีฬาออนไลน์

                    </small>

                </footer>


            </main>


        </div>

    </div>



    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
