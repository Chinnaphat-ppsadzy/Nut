    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-3" style="border-radius:18px;">
            <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-image me-1 text-success"></i>สลิปโอนเงิน (<span id="modalSlipCode">-</span>)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="p-2 bg-light rounded text-center">
                <img id="modalSlipImg" src="" alt="Payment Slip" class="img-fluid rounded shadow-sm" style="max-height: 480px; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

<script>
    async function copyBookingCode(button) {
        const code = button.dataset.bookingCode;
        try {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(code);
            } else {
                const temporaryInput = document.createElement('textarea');
                temporaryInput.value = code;
                temporaryInput.style.position = 'fixed';
                temporaryInput.style.opacity = '0';
                document.body.appendChild(temporaryInput);
                temporaryInput.select();
                const copied = document.execCommand('copy');
                temporaryInput.remove();
                if (!copied) throw new Error('copy failed');
            }

            const original = button.innerHTML;
            button.innerHTML = '<i class="bi bi-check2"></i>';
            button.title = 'คัดลอกรหัสแล้ว';
            setTimeout(() => {
                button.innerHTML = original;
                button.title = 'คัดลอกรหัสการจอง';
            }, 1500);
        } catch {
            alert('คัดลอกรหัสไม่สำเร็จ กรุณาคัดลอกด้วยตนเอง: ' + code);
        }
    }

    function openTaxRequestModal(receiptId, bookingCode) {
        document.getElementById('taxRequestReceiptId').value = receiptId;
        document.getElementById('taxRequestBookingCode').textContent = bookingCode;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('taxRequestModal')).show();
    }

    function viewSlipModal(url, code) {
        document.getElementById('modalSlipImg').src = url;
        document.getElementById('modalSlipCode').innerText = code;
        const modal = new bootstrap.Modal(document.getElementById('slipModal'));
        modal.show();
    }
</script>
