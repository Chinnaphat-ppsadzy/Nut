<Project>
  <PropertyGroup>
    <!-- Keep this checkout's build products separate from assemblies loaded by an older dotnet watch/run process. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\CourtBook\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\CourtBook\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**\*;bin\**\*</DefaultItemExcludes>
  </PropertyGroup>
</Project>
