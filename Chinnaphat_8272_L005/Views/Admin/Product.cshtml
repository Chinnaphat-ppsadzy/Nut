@model List<Chinnaphat_8272_L005.Models.Product>

@{
    ViewData["Title"] = "จัดการสินค้าและอุปกรณ์ (Admin)";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<Chinnaphat_8272_L005.Models.ProductCategory> ?? new();
}

<style>
    .page-header-card {
        background: linear-gradient(135deg, #1a472a 0%, #2d6a4f 55%, #52b788 100%);
        border-radius: 16px;
        padding: 1.6rem 2rem;
        color: white;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .product-table-wrapper {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }
    .table th {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        color: #334155;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 1rem 0.75rem;
    }
    .table td {
        padding: 0.85rem 0.75rem;
        vertical-align: middle;
        border-color: #f1f5f9;
    }
    .badge-sale {
        background: #dbeafe;
        color: #1e40af;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.3rem 0.6rem;
        border-radius: 12px;
    }
    .badge-rent {
        background: #fef3c7;
        color: #b45309;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.3rem 0.6rem;
        border-radius: 12px;
    }
</style>

<!-- Alert messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Header -->
<div class="page-header-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark font-monospace">ADMIN ONLY</span>
                <span class="badge bg-white text-dark bg-opacity-25 text-white">Product & Equipment</span>
            </div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>จัดการสินค้าและอุปกรณ์
            </h3>
            <p class="mb-0 opacity-75">
                รายการสินค้าขาย (ลูกแบดมินตัน, น้ำดื่ม) และสินค้าเช่า (ไม้แบดมินตัน, รองเท้า) สำหรับเชื่อมต่อโปรโมชั่น
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Admin" asp-controller="Home" class="btn btn-light fw-semibold px-3 py-2" style="border-radius:10px;">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a href="/Admin/Promotion" class="btn btn-outline-light fw-semibold px-3 py-2" style="border-radius:10px;">
                <i class="bi bi-ticket-perforated me-1"></i> ไปจัดการโปรโมชั่น
            </a>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:50px; height:50px; border-radius:14px; background:#e8f5e9; color:#2d6a4f; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@Model.Count</h4>
                    <small class="text-muted">รายการสินค้าทั้งหมด</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:50px; height:50px; border-radius:14px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-primary">@Model.Count(p => p.ProductType == "SALE")</h4>
                    <small class="text-muted">สินค้าสำหรับขาย</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div style="width:50px; height:50px; border-radius:14px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.5rem;">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-warning">@Model.Count(p => p.ProductType == "RENT")</h4>
                    <small class="text-muted">อุปกรณ์สำหรับเช่า</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Products Table -->
<div class="product-table-wrapper">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-ul me-2 text-success"></i>รายการสินค้าและอุปกรณ์ทั้งหมด
        </h5>
        <div class="d-flex gap-2">
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="bi bi-tags me-1 text-primary"></i> มี @categories.Count หมวดหมู่
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">SKU</th>
                    <th>ชื่อสินค้า / รายการ</th>
                    <th>หมวดหมู่</th>
                    <th>ประเภท</th>
                    <th class="text-end">ราคา (บาท)</th>
                    <th class="text-end">มัดจำ (บาท)</th>
                    <th class="text-center">หน่วย</th>
                    <th class="text-center" style="width: 100px;">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-box mb-2" style="font-size:2rem;"></i>
                            <div>ยังไม่มีข้อมูลสินค้าในระบบ</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in Model)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace fw-bold small text-secondary">@prod.Sku</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@prod.ProductName</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(prod.Category?.CategoryName ?? "-")
                                </span>
                            </td>
                            <td>
                                @if (prod.ProductType == "SALE")
                                {
                                    <span class="badge-sale"><i class="bi bi-cart me-1"></i>ขาย</span>
                                }
                                else
                                {
                                    <span class="badge-rent"><i class="bi bi-clock-history me-1"></i>เช่า</span>
                                }
                            </td>
                            <td class="text-end">
                                <span class="fw-bold text-success">@prod.Price.ToString("N0") ฿</span>
                            </td>
                            <td class="text-end">
                                @if (prod.Deposit > 0)
                                {
                                    <span class="fw-semibold text-warning">@prod.Deposit.ToString("N0") ฿</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="small text-muted">@prod.Unit</span>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-outline-success btn-sm px-2 py-1" style="border-radius:8px;"
                                        onclick="openEditProductModal(@prod.ProductId, '@prod.ProductName', @prod.Price, @prod.Deposit, '@prod.Unit')">
                                    <i class="bi bi-pencil-square me-1"></i>แก้ไข
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px; border:none; box-shadow:0 20px 50px rgba(0,0,0,0.2);">
            <form asp-action="UpdateProductPrice" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editProductId" name="productId" />
                <div class="modal-header bg-success text-white" style="border-top-left-radius:18px; border-top-right-radius:18px;">
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2"></i>แก้ไขราคา: <span id="modalProductName"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">ราคา (บาท ต่อ <span id="modalProductUnit">หน่วย</span>):</label>
                        <div class="input-group">
                            <span class="input-group-text">฿</span>
                            <input type="number" step="1" min="0" class="form-control" id="editPrice" name="price" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">ค่ามัดจำ (สำหรับสินค้าเช่า):</label>
                        <div class="input-group">
                            <span class="input-group-text">฿</span>
                            <input type="number" step="1" min="0" class="form-control" id="editDeposit" name="deposit" />
                        </div>
                        <small class="text-muted">ใส่ 0 หากไม่ต้องวางมัดจำ</small>
                    </div>
                </div>
                <div class="modal-footer bg-light" style="border-bottom-left-radius:18px; border-bottom-right-radius:18px;">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success px-4 fw-semibold">
                        <i class="bi bi-check-circle me-1"></i>บันทึกการเปลี่ยนแปลง
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditProductModal(id, name, price, deposit, unit) {
            document.getElementById('editProductId').value = id;
            document.getElementById('modalProductName').innerText = name;
            document.getElementById('modalProductUnit').innerText = unit || 'ชิ้น';
            document.getElementById('editPrice').value = price;
            document.getElementById('editDeposit').value = deposit || 0;
            new bootstrap.Modal(document.getElementById('editProductModal')).show();
        }
    </script>
}

